---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Dev-only tools (src/components/dev/), never in the built site.
import FontAudition from '../components/dev/FontAudition.astro';
import FontVariationTuner from '../components/dev/FontVariationTuner.astro';
import PaletteAudition from '../components/dev/PaletteAudition.astro';
import DevPhonePreview from '../components/dev/DevPhonePreview.astro';

interface Props {
	title?: string;
	// One or two sentences: the search-result snippet and the link
	// preview's description.
	description?: string;
	navLabel?: string;
	navHref?: string;
	// Pages that shouldn't show up in search (e.g. the resume redirect).
	noindex?: boolean;
}

const {
	title = 'Jake Rochford',
	description = 'Jake Rochford is a brand and motion designer in Chicago, and Brand Manager at Stack Overflow.',
	navLabel,
	navHref,
	noindex = false,
} = Astro.props;

// Link previews (Slack, LinkedIn, iMessage, email): one shared card,
// public/og.png, 1200x630.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Type decision is locked (Fraunces + Schibsted Grotesk, both
// self-hosted — see the Fonts section of global.css), so the
// audition panel is off. Flip true for a future audition round —
// it'll need its own Google Fonts <link> for whatever candidates
// that round tests; the previous one was removed with this switch,
// not preserved, since a new round would test different families
// anyway.
const FONT_AUDITION_ENABLED = false;

// SOFT/WONK locked at 0/0 (the font's own defaults are 0/1 — WONK's
// alternate letterforms read too casual, plain SOFT read best too).
// Tuner off; flip true to revisit.
const FONT_VARIATION_TUNER_ENABLED = false;

// Light/dark palette duos, applied live — the exploration that picked
// Butter Ceremonial (now the defaults in global.css). Dev-only; off.
const PALETTE_AUDITION_ENABLED = false;

// Phone mode (MobileHome.astro): whether real phones get it
// automatically. On since 2026-10-03; set false to send phones back to
// the responsive desktop site (?mobile=1 still forces phone mode).
const PHONE_MODE_AUTO = true;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Jake Rochford" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Jake Rochford — I make brands move. Brand and motion designer, Brand Manager at Stack Overflow."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
		<!-- Applies a stored or system dark-mode preference before first
		     paint, so a dark-mode visitor never sees a flash of the light
		     page. The nav toggle takes over from here. -->
		<script is:inline data-phone-auto={PHONE_MODE_AUTO ? 'true' : undefined}>
			(function () {
				var mode = null;
				try {
					mode = localStorage.getItem('theme-choice');
				} catch (e) {}
				if (mode !== 'dark' && mode !== 'light') {
					mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = mode;
				// Phones get their own, shorter homepage (MobileHome.astro)
				// rather than the desktop one squeezed down — decided by the
				// device, not the window width, so a narrow desktop window
				// still gets the responsive desktop site, and tablets count
				// as desktop. Chrome/Android report it directly; iPhones are
				// identified by user agent (iPads report as Macs, so they
				// stay desktop). ?mobile=1 / ?mobile=0 force it for that page
				// load — what the dev preview frame uses.
				var force = new URLSearchParams(location.search).get('mobile');
				var uaData = navigator.userAgentData;
				var phone =
					(uaData && uaData.mobile === true) ||
					/iPhone|iPod|Android.+Mobile|Windows Phone/i.test(navigator.userAgent);
				// Automatic detection can be switched off with PHONE_MODE_AUTO
				// (in the frontmatter), leaving only ?mobile=1 and the dev
				// preview.
				var auto = document.currentScript && document.currentScript.dataset.phoneAuto === 'true';
				if (force === '1' || (force !== '0' && auto && phone)) document.documentElement.classList.add('mobile-view');
				// Soft reveals — skipped under reduced motion, and on
				// back/forward navigation, where the page should just be
				// there. If the reveal script never runs, drop the class so
				// nothing stays hidden.
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
				if (!reduce && !(nav && nav.type === 'back_forward')) {
					document.documentElement.classList.add('reveal-ready');
					setTimeout(function () {
						if (!window.__revealStarted) document.documentElement.classList.remove('reveal-ready');
					}, 4000);
				}
			})();
		</script>
		<!-- Fraunces + Schibsted Grotesk are self-hosted (see the Fonts
		     section of global.css) — no Google Fonts links needed. -->
	</head>
	<body>
		<Nav label={navLabel} href={navHref} />

		<main>
			<slot />
		</main>

		<Footer />

		{FONT_AUDITION_ENABLED && import.meta.env.DEV && <FontAudition />}
		{FONT_VARIATION_TUNER_ENABLED && import.meta.env.DEV && <FontVariationTuner />}
		{PALETTE_AUDITION_ENABLED && import.meta.env.DEV && <PaletteAudition />}
		{import.meta.env.DEV && <DevPhonePreview />}

		<script>
			// Reveals each [data-reveal] element the first time it scrolls
			// into view. Elements that arrive together are staggered top to
			// bottom, left to right — unless they set their own delay (the
			// hero's fixed load-in cascade).
			const root = document.documentElement;
			(window as Window & { __revealStarted?: boolean }).__revealStarted = true;
			if (root.classList.contains('reveal-ready')) {
				const STAGGER = 70;
				const observer = new IntersectionObserver(
					(entries) => {
						entries
							.filter((e) => e.isIntersecting)
							.sort(
								(a, b) =>
									a.boundingClientRect.top - b.boundingClientRect.top ||
									a.boundingClientRect.left - b.boundingClientRect.left,
							)
							.forEach((entry, i) => {
								const el = entry.target as HTMLElement;
								if (!el.style.getPropertyValue('--reveal-delay')) {
									el.style.setProperty('--reveal-delay', `${i * STAGGER}ms`);
								}
								el.classList.add('is-revealed');
								observer.unobserve(el);
							});
					},
					{ rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
				);
				// Whatever's already on screen at load joins the load-in
				// cascade straight away — the observer's bottom margin is for
				// scroll-ins, and it was leaving copy pinned to the very
				// bottom of the screen (phone mode's hero buttons) hidden.
				// A frame later, so the layout's settled — --nav-height (which
				// sizes the hero) is set by a script further down.
				requestAnimationFrame(() => {
				const onScreen: HTMLElement[] = [];
				document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
					const r = el.getBoundingClientRect();
					if (r.top < window.innerHeight && r.bottom > 0 && getComputedStyle(el).display !== 'none') onScreen.push(el);
					else observer.observe(el);
				});
				onScreen
					.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)
					.forEach((el, i) => {
						if (!el.style.getPropertyValue('--reveal-delay')) el.style.setProperty('--reveal-delay', `${i * STAGGER}ms`);
						el.classList.add('is-revealed');
					});
				});
			}
		</script>
	</body>
</html>

<script>
	function setNavHeightVar() {
		const nav = document.querySelector('.site-nav');
		if (nav) {
			document.documentElement.style.setProperty('--nav-height', `${nav.getBoundingClientRect().height}px`);
		}
	}

	setNavHeightVar();
	window.addEventListener('resize', setNavHeightVar);
</script>
