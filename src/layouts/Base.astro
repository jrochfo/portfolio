---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FontAudition from '../components/FontAudition.astro';
import FontVariationTuner from '../components/FontVariationTuner.astro';
import ColorExploration from '../components/_archive/ColorExploration.astro';
import ColorFavorites from '../components/ColorFavorites.astro';
import PaletteAudition from '../components/PaletteAudition.astro';
import TitleAudition from '../components/TitleAudition.astro';

interface Props {
	title?: string;
	navLabel?: string;
	navHref?: string;
}

const { title = 'Jake Rochford', navLabel, navHref } = Astro.props;

// Type decision is locked (Fraunces + Schibsted Grotesk, both
// self-hosted — see the Fonts section of global.css), so the
// audition panel is off. Flip true for a future audition round —
// it'll need its own Google Fonts <link> for whatever candidates
// that round tests; the previous one was removed with this switch,
// not preserved, since a new round would test different families
// anyway.
const FONT_AUDITION_ENABLED = false;

// SOFT/WONK locked at 0/0 (the font's own defaults are 0/1 — WONK's
// alternate letterforms read too casual, plain SOFT read best too).
// Tuner off; flip true to revisit.
const FONT_VARIATION_TUNER_ENABLED = false;

// Superseded by ColorFavorites below — Jake narrowed the open-ended
// exploration down to four favorites, so the full tinkering tool
// (sliders, open Accent grid, unlimited saves) is retired. Kept in
// _archive/ rather than deleted in case wide-open exploration is ever
// useful again; flip true to bring it back.
const COLOR_EXPLORATION_ENABLED = false;

// Neutral/ink/accent tokens are down to a shortlist of four favorites
// (Rust/Teal/Moss/Cobalt). Off while PaletteAudition below explores
// bolder directions; flip back to compare.
const COLOR_FAVORITES_ENABLED = false;

// Light/dark palette duos, applied live — the exploration that picked
// Butter Ceremonial (now the defaults in global.css). Dev-only; off.
const PALETTE_AUDITION_ENABLED = false;

// Calmer dark-mode title greens vs the current lime. Unlike the panels
// above it ships to the live site, but stays hidden there unless the
// URL has ?titles (see the component).
const TITLE_AUDITION_ENABLED = true;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Applies a stored or system dark-mode preference before first
		     paint, so a dark-mode visitor never sees a flash of the light
		     page. The nav toggle takes over from here. -->
		<script is:inline>
			(function () {
				var mode = null;
				try {
					mode = localStorage.getItem('theme');
				} catch (e) {}
				if (mode !== 'dark' && mode !== 'light') {
					mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = mode;
				// Soft reveals — skipped under reduced motion, and on
				// back/forward navigation, where the page should just be
				// there. If the reveal script never runs, drop the class so
				// nothing stays hidden.
				var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
				if (!reduce && !(nav && nav.type === 'back_forward')) {
					document.documentElement.classList.add('reveal-ready');
					setTimeout(function () {
						if (!window.__revealStarted) document.documentElement.classList.remove('reveal-ready');
					}, 4000);
				}
			})();
		</script>
		<!-- Fraunces + Schibsted Grotesk are self-hosted (see the Fonts
		     section of global.css) — no Google Fonts links needed. -->
	</head>
	<body>
		<Nav label={navLabel} href={navHref} />

		<main>
			<slot />
		</main>

		<Footer />

		{FONT_AUDITION_ENABLED && import.meta.env.DEV && <FontAudition />}
		{FONT_VARIATION_TUNER_ENABLED && import.meta.env.DEV && <FontVariationTuner />}
		{COLOR_EXPLORATION_ENABLED && import.meta.env.DEV && <ColorExploration />}
		{COLOR_FAVORITES_ENABLED && import.meta.env.DEV && <ColorFavorites />}
		{PALETTE_AUDITION_ENABLED && import.meta.env.DEV && <PaletteAudition />}
		{TITLE_AUDITION_ENABLED && <TitleAudition />}

		<script>
			// Reveals each [data-reveal] element the first time it scrolls
			// into view. Elements that arrive together are staggered top to
			// bottom, left to right — unless they set their own delay (the
			// hero's fixed load-in cascade).
			const root = document.documentElement;
			(window as Window & { __revealStarted?: boolean }).__revealStarted = true;
			if (root.classList.contains('reveal-ready')) {
				const STAGGER = 70;
				const observer = new IntersectionObserver(
					(entries) => {
						entries
							.filter((e) => e.isIntersecting)
							.sort(
								(a, b) =>
									a.boundingClientRect.top - b.boundingClientRect.top ||
									a.boundingClientRect.left - b.boundingClientRect.left,
							)
							.forEach((entry, i) => {
								const el = entry.target as HTMLElement;
								if (!el.style.getPropertyValue('--reveal-delay')) {
									el.style.setProperty('--reveal-delay', `${i * STAGGER}ms`);
								}
								el.classList.add('is-revealed');
								observer.unobserve(el);
							});
					},
					{ rootMargin: '0px 0px -6% 0px', threshold: 0.05 },
				);
				document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>

<script>
	function setNavHeightVar() {
		const nav = document.querySelector('.site-nav');
		if (nav) {
			document.documentElement.style.setProperty('--nav-height', `${nav.getBoundingClientRect().height}px`);
		}
	}

	setNavHeightVar();
	window.addEventListener('resize', setNavHeightVar);
</script>
