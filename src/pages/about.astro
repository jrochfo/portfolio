---
import Base from '../layouts/Base.astro';
import AboutRing from '../components/AboutRing.astro';
---

<Base title="About — Jake Rochford" navLabel="Home" navHref="/">
	<section class="about">
		<div class="container about__inner">
			<AboutRing />
			<h1 class="type-display about__headline">About</h1>
			<div class="about__bio">
				<p class="type-h3">I'm a brand and motion designer in Chicago.</p>
				<p class="type-h3">
					For the last five years I've been at Stack Overflow, first helping rebuild the brand
					with Koto, then running it across everything the company ships: product, marketing,
					events, and a lot of animation.
				</p>
				<p class="type-h3">Off the clock I run, climb, pet my dog, and animate a Twitch cat.</p>
			</div>
			<div class="about__actions">
				<a href="/jake-rochford-resume.pdf" class="button type-caption">Resume</a>
				<a
					href="https://www.linkedin.com/in/jakerochford/"
					target="_blank"
					rel="noopener noreferrer"
					class="button button--secondary type-caption"
				>
					LinkedIn
				</a>
				<button
					type="button"
					class="button button--secondary type-caption email-copy"
					data-email="jake.rochford@gmail.com"
				>
					Email
					<span class="email-copy__tooltip" role="status" aria-live="polite">Email copied</span>
				</button>
			</div>
		</div>
	</section>
</Base>

<style>
	/* Sticky-footer pattern: body becomes the flex column, main grows
	   to fill whatever space the (short) content doesn't use, which
	   pins the footer to the bottom of the viewport — without forcing
	   .about itself to reserve a full viewport and leave a gap between
	   its own (top-anchored) content and the footer. */
	:global(body) {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	:global(body > main) {
		flex: 1;
		display: flex;
		min-height: 0;
	}

	.about {
		flex: 1;
		display: flex;
		align-items: flex-start;
	}

	.about__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
		/* The same room above the photo ring as below it. */
		padding-block-start: var(--space-m);
	}

	.about__headline {
		margin-block-start: var(--space-m);
	}

	.about__bio {
		/* Wider than Hero's subhead (also 60ch) — this copy is longer
		   and was wrapping into awkward single-word orphan lines at
		   the same width. */
		max-width: 70ch;
		margin-block-start: var(--space-s);
	}

	.about__bio p + p {
		margin-block-start: var(--space-s);
	}

	.about__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-xs);
		margin-block-start: var(--space-m);
	}

	.email-copy {
		position: relative;
	}

	.email-copy__tooltip {
		position: absolute;
		bottom: calc(100% + var(--space-2xs));
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		background: var(--color-ink);
		color: var(--color-bg);
		padding: var(--space-2xs) var(--space-xs);
		border-radius: var(--radius-well);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.email-copy__tooltip.is-visible {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.email-copy__tooltip {
			transition: none;
		}
	}
</style>

<script>
	const emailButton = document.querySelector<HTMLButtonElement>('.email-copy');
	const tooltip = emailButton?.querySelector<HTMLElement>('.email-copy__tooltip');
	const email = emailButton?.dataset.email;

	let hideTimeout: ReturnType<typeof setTimeout>;

	emailButton?.addEventListener('click', async () => {
		let message = 'Email copied';

		try {
			await navigator.clipboard.writeText(email ?? '');
		} catch {
			message = email ?? '';
		}

		if (tooltip) {
			tooltip.textContent = message;
			tooltip.classList.add('is-visible');
			clearTimeout(hideTimeout);
			hideTimeout = setTimeout(() => {
				tooltip.classList.remove('is-visible');
			}, 1750);
		}
	});
</script>
