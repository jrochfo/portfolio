---
import Base from '../layouts/Base.astro';
import AboutRing from '../components/AboutRing.astro';
---

<Base
	title="About — Jake Rochford"
	description="Jake Rochford is a brand and motion designer in Chicago and Brand Manager at Stack Overflow, where he helped rebuild the brand with Koto."
	navLabel="Home"
	navHref="/"
>
	<section class="about">
		<div class="container about__inner">
			<AboutRing />
			<h1 class="type-display about__headline">About</h1>
			<div class="about__bio">
				<p class="type-h3">
					I’m a brand and motion designer in Chicago, and Brand Manager at Stack Overflow. Since
					2022 I’ve helped rebuild its brand with Koto, then apply it across everything the company
					ships: product, marketing, events, and a lot of animation.
				</p>
				<p class="type-h3">
					I like stress-testing systems so they hold up for the long haul. I don’t cut corners,
					because doing it right pays off for everyone.
				</p>
				<p class="type-h3">
					I studied Anthropology at Tufts University and Graphic Design at the School of the
					Museum of Fine Arts at Tufts. Off the clock I run, climb, pet my dog, and animate a
					Twitch cat.
				</p>
			</div>
			<div class="about__actions">
				<a href="/resume" class="button type-caption">Resume</a>
				<a
					href="https://www.linkedin.com/in/jakerochford/"
					target="_blank"
					rel="noopener noreferrer"
					class="button button--secondary type-caption"
				>
					LinkedIn
				</a>
				<button
					type="button"
					class="button button--secondary type-caption email-copy"
					data-email="jake.rochford@gmail.com"
				>
					Email
					<span class="email-copy__tooltip" role="status" aria-live="polite">Email copied</span>
				</button>
			</div>
		</div>
	</section>
</Base>

<style>
	/* Sticky-footer pattern: body becomes the flex column, main grows
	   to fill whatever space the (short) content doesn't use, which
	   pins the footer to the bottom of the viewport — without forcing
	   .about itself to reserve a full viewport and leave a gap between
	   its own (top-anchored) content and the footer. */
	:global(body) {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	:global(body > main) {
		flex: 1;
		display: flex;
		min-height: 0;
	}

	.about {
		/* The photo ring runs past the screen edges on phones; clip (not
		   hidden) so that can't add a sideways scroll. */
		overflow-x: clip;
		flex: 1;
		display: flex;
		align-items: flex-start;
	}

	.about__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
		/* Room above the photo ring. */
		padding-block-start: var(--space-l);
	}

	.about__headline {
		margin-block-start: var(--space-m);
	}

	/* A centred column, justified inside it like a newspaper column,
	   while the box itself stays on the page's centre axis with the
	   headline and buttons. 66ch is tuned to the copy: it's the width
	   where the justified lines' word spaces stretch least (at most
	   ~1.6x a normal space; 60ch stretched some to nearly 3x, which
	   opens up rivers). Retune if the copy changes. */
	.about__bio {
		max-width: 66ch;
		margin-block-start: var(--space-s);
		margin-inline: auto;
		text-align: left;
	}

	/* Keeps a paragraph from ending on a lone word, without shortening
	   every line the way `balance` does. */
	.about__bio p {
		text-align: justify;
		hyphens: auto;
		text-wrap: pretty;
	}

	/* Too narrow on phones to justify without big gaps between words,
	   so the copy stays flush left there. */
	@media (max-width: 768px) {
		.about__bio p {
			text-align: left;
			hyphens: manual;
		}
	}

	.about__bio p + p {
		margin-block-start: var(--space-s);
	}

	.about__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-xs);
		margin-block-start: var(--space-m);
	}

	.email-copy {
		position: relative;
	}

	.email-copy__tooltip {
		position: absolute;
		bottom: calc(100% + var(--space-2xs));
		left: 50%;
		transform: translateX(-50%);
		white-space: nowrap;
		background: var(--color-ink);
		color: var(--color-bg);
		padding: var(--space-2xs) var(--space-xs);
		border-radius: var(--radius-well);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.email-copy__tooltip.is-visible {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.email-copy__tooltip {
			transition: none;
		}
	}
</style>

<script>
	const emailButton = document.querySelector<HTMLButtonElement>('.email-copy');
	const tooltip = emailButton?.querySelector<HTMLElement>('.email-copy__tooltip');
	const email = emailButton?.dataset.email;

	let hideTimeout: ReturnType<typeof setTimeout>;

	emailButton?.addEventListener('click', async () => {
		let message = 'Email copied';

		try {
			await navigator.clipboard.writeText(email ?? '');
		} catch {
			message = email ?? '';
		}

		if (tooltip) {
			tooltip.textContent = message;
			tooltip.classList.add('is-visible');
			clearTimeout(hideTimeout);
			hideTimeout = setTimeout(() => {
				tooltip.classList.remove('is-visible');
			}, 1750);
		}
	});
</script>
