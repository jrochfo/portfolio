---
// SPIKE — throwaway experiment, not production code.
// Same viewer as the banana spike (OBJ + MTL + texture via Three.js,
// top-down light + shadow, free drag + slow auto-rotate), plus a
// live texture watcher: edit the PNG on disk in any external editor
// and save — this page polls the file's Last-Modified header and
// hot-swaps the texture on the model without a page reload.
import Base from '../layouts/Base.astro';

const MODEL_PATH = '/models/toolbox/';
const TEXTURE_PATH = '/models/toolbox/textures/texture_0_035f_2300_2315.png';
---

<Base title="Toolbox spike">
	<div class="container spike-intro">
		<h1 class="type-h1">Toolbox spike</h1>
		<p class="type-body">
			Throwaway 3D experiment, not production code. Drag to spin it freely in any
			direction — it also spins slowly on its own when you leave it alone.
		</p>
		<p class="type-caption spike-watch-note">
			Watching <code>{TEXTURE_PATH}</code> for changes — edit and save it in any external
			editor and the texture updates here live, no page reload.
		</p>
		<div id="toolbox-viewer" class="toolbox-viewer" data-texture-path={TEXTURE_PATH}></div>
	</div>
</Base>

<style>
	.spike-intro {
		padding-block: var(--space-l);
	}

	.spike-intro p {
		margin-block-start: var(--space-xs);
		max-width: 60ch;
	}

	.spike-watch-note {
		opacity: 0.6;
	}

	.toolbox-viewer {
		width: 320px;
		height: 320px;
		margin-block-start: var(--space-m);
		border-radius: var(--radius-well);
		background: #f0efec;
		/* Let OrbitControls' drag handle touch gestures here instead of
		   the browser interpreting the same gesture as a page scroll. */
		touch-action: none;
	}

	.toolbox-viewer canvas {
		display: block;
		border-radius: var(--radius-well);
	}
</style>

<script>
	import * as THREE from 'three';
	import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js';
	import { MTLLoader } from 'three/examples/jsm/loaders/MTLLoader.js';
	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

	const container = document.querySelector<HTMLDivElement>('#toolbox-viewer');

	if (container) {
		const modelPath = '/models/toolbox/';
		const texturePath = container.dataset.texturePath ?? '';

		const width = container.clientWidth;
		const height = container.clientHeight;

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
		camera.position.set(0, 0.4, 4);

		const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
		renderer.setSize(width, height);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFSoftShadowMap;
		container.appendChild(renderer.domElement);

		scene.add(new THREE.AmbientLight(0xffffff, 0.5));

		const topLight = new THREE.DirectionalLight(0xffffff, 1.8);
		topLight.position.set(0.6, 6, 1.4);
		topLight.target.position.set(0, 0, 0);
		topLight.castShadow = true;
		topLight.shadow.mapSize.set(1024, 1024);
		topLight.shadow.camera.near = 0.1;
		topLight.shadow.camera.far = 20;
		topLight.shadow.camera.left = -3;
		topLight.shadow.camera.right = 3;
		topLight.shadow.camera.top = 3;
		topLight.shadow.camera.bottom = -3;
		topLight.shadow.bias = -0.0015;
		scene.add(topLight);
		scene.add(topLight.target);

		const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

		const controls = new OrbitControls(camera, renderer.domElement);
		controls.enableZoom = false;
		controls.enablePan = false;
		controls.enableDamping = true;
		controls.dampingFactor = 0.08;
		controls.autoRotate = !reduceMotionQuery.matches;
		controls.autoRotateSpeed = 1.2;

		// Materials collected once the model loads, so the texture
		// watcher below can hot-swap their .map without re-loading the
		// whole model.
		const liveMaterials: THREE.Material[] = [];

		const mtlLoader = new MTLLoader();
		mtlLoader.setPath(modelPath);
		mtlLoader.load('model.mtl', (materials) => {
			materials.preload();

			const objLoader = new OBJLoader();
			objLoader.setMaterials(materials);
			objLoader.setPath(modelPath);
			objLoader.load('model.obj', (obj) => {
				const box = new THREE.Box3().setFromObject(obj);
				const size = box.getSize(new THREE.Vector3());
				const center = box.getCenter(new THREE.Vector3());
				obj.position.sub(center);
				const maxDimension = Math.max(size.x, size.y, size.z) || 1;
				obj.scale.setScalar(2 / maxDimension);

				obj.traverse((child) => {
					if (child instanceof THREE.Mesh) {
						child.castShadow = true;
						const mats = Array.isArray(child.material) ? child.material : [child.material];
						liveMaterials.push(...mats);
					}
				});

				scene.add(obj);

				const groundY = new THREE.Box3().setFromObject(obj).min.y;
				const ground = new THREE.Mesh(
					new THREE.PlaneGeometry(6, 6),
					new THREE.ShadowMaterial({ opacity: 0.25 }),
				);
				ground.rotation.x = -Math.PI / 2;
				ground.position.y = groundY;
				ground.receiveShadow = true;
				scene.add(ground);
			});
		});

		// Live texture reload: poll the file's Last-Modified header and
		// swap the material's map when it changes, so editing the PNG
		// externally shows up here without a page refresh. Dev-only
		// convenience — harmless (just a no-op poll) if ever deployed.
		const textureLoader = new THREE.TextureLoader();
		let lastModified: string | null = null;

		function reloadTexture() {
			if (!texturePath || liveMaterials.length === 0) return;
			textureLoader.load(`${texturePath}?t=${Date.now()}`, (newTexture) => {
				newTexture.colorSpace = THREE.SRGBColorSpace;
				liveMaterials.forEach((mat) => {
					const anyMat = mat as THREE.MeshPhongMaterial;
					const previous = anyMat.map;
					anyMat.map = newTexture;
					anyMat.needsUpdate = true;
					previous?.dispose();
				});
			});
		}

		async function checkTextureUpdate() {
			if (!texturePath) return;
			try {
				const res = await fetch(texturePath, { method: 'HEAD', cache: 'no-store' });
				const modified = res.headers.get('last-modified');
				if (modified && modified !== lastModified) {
					const isFirstCheck = lastModified === null;
					lastModified = modified;
					if (!isFirstCheck) reloadTexture();
				}
			} catch {
				// Dev-only convenience — ignore fetch errors.
			}
		}

		let watchInterval: number | null = null;

		function startWatching() {
			if (watchInterval === null) {
				watchInterval = window.setInterval(checkTextureUpdate, 1000);
			}
		}

		function stopWatching() {
			if (watchInterval !== null) {
				clearInterval(watchInterval);
				watchInterval = null;
			}
		}

		let animationId: number | null = null;

		function renderLoop() {
			controls.update();
			renderer.render(scene, camera);
			animationId = requestAnimationFrame(renderLoop);
		}

		function startLoop() {
			if (animationId === null) {
				animationId = requestAnimationFrame(renderLoop);
			}
			startWatching();
		}

		function stopLoop() {
			if (animationId !== null) {
				cancelAnimationFrame(animationId);
				animationId = null;
			}
			stopWatching();
		}

		let isIntersecting = false;

		const observer = new IntersectionObserver(
			([entry]) => {
				isIntersecting = entry.isIntersecting;
				if (isIntersecting && document.visibilityState === 'visible') {
					startLoop();
				} else {
					stopLoop();
				}
			},
			{ threshold: 0.01 },
		);
		observer.observe(container);

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible' && isIntersecting) {
				startLoop();
			} else {
				stopLoop();
			}
		});

		window.addEventListener('resize', () => {
			const w = container.clientWidth;
			const h = container.clientHeight;
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			renderer.setSize(w, h);
		});
	}
</script>
