---
// SPIKE — throwaway experiment, not production code.
// Testing a small, freely-spinnable 3D object (OBJ + MTL + texture)
// rendered via Three.js: slow ambient auto-rotate, free drag-to-spin
// in any direction, paused when off-screen or the tab isn't visible.
import Base from '../layouts/Base.astro';
---

<Base title="Banana spike">
	<div class="container spike-intro">
		<h1 class="type-h1">Banana spike</h1>
		<p class="type-body">
			Throwaway 3D experiment, not production code. Drag to spin it freely in any
			direction — it also spins slowly on its own when you leave it alone.
		</p>
		<div id="banana-viewer" class="banana-viewer"></div>
	</div>
</Base>

<style>
	.spike-intro {
		padding-block: var(--space-l);
	}

	.spike-intro p {
		margin-block-start: var(--space-xs);
		max-width: 60ch;
	}

	.banana-viewer {
		width: 320px;
		height: 320px;
		margin-block-start: var(--space-m);
		border-radius: var(--radius-well);
		background: #f0efec;
		/* Let OrbitControls' drag handle touch gestures here instead of
		   the browser interpreting the same gesture as a page scroll. */
		touch-action: none;
	}

	.banana-viewer canvas {
		display: block;
		border-radius: var(--radius-well);
	}
</style>

<script>
	import * as THREE from 'three';
	import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js';
	import { MTLLoader } from 'three/examples/jsm/loaders/MTLLoader.js';
	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

	const container = document.querySelector<HTMLDivElement>('#banana-viewer');

	if (container) {
		const width = container.clientWidth;
		const height = container.clientHeight;

		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
		camera.position.set(0, 0.4, 4);

		const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
		renderer.setSize(width, height);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFSoftShadowMap;
		container.appendChild(renderer.domElement);

		// Low ambient just for fill, so the shadow side isn't pure
		// black — the top light is what's actually doing the modeling
		// and casting the shadow onto the ground plane below.
		scene.add(new THREE.AmbientLight(0xffffff, 0.5));

		const topLight = new THREE.DirectionalLight(0xffffff, 1.8);
		// Slight offset off dead-center overhead — a perfectly vertical
		// light casts the shadow straight down and mostly hidden under
		// the object from this camera angle; nudging it gives a shadow
		// that's actually visible past the model's own footprint.
		topLight.position.set(0.6, 6, 1.4);
		topLight.target.position.set(0, 0, 0);
		topLight.castShadow = true;
		topLight.shadow.mapSize.set(1024, 1024);
		topLight.shadow.camera.near = 0.1;
		topLight.shadow.camera.far = 20;
		topLight.shadow.camera.left = -3;
		topLight.shadow.camera.right = 3;
		topLight.shadow.camera.top = 3;
		topLight.shadow.camera.bottom = -3;
		topLight.shadow.bias = -0.0015;
		scene.add(topLight);
		scene.add(topLight.target);

		const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

		// Free drag-to-rotate in any direction is OrbitControls' core
		// behavior (it orbits the camera around the model, which reads
		// the same as spinning the object for a single centered mesh).
		// autoRotate provides the slow ambient spin, and is the one part
		// of this that's automatic/decorative rather than user-driven —
		// skipped under reduced motion, same as everywhere else on the
		// site; the drag interaction itself stays enabled either way
		// since the user is choosing to trigger it.
		const controls = new OrbitControls(camera, renderer.domElement);
		controls.enableZoom = false;
		controls.enablePan = false;
		controls.enableDamping = true;
		controls.dampingFactor = 0.08;
		controls.autoRotate = !reduceMotionQuery.matches;
		controls.autoRotateSpeed = 1.2;

		const mtlLoader = new MTLLoader();
		mtlLoader.setPath('/models/banana/');
		mtlLoader.load('model.mtl', (materials) => {
			materials.preload();

			const objLoader = new OBJLoader();
			objLoader.setMaterials(materials);
			objLoader.setPath('/models/banana/');
			objLoader.load('model.obj', (obj) => {
				// OBJ exports carry whatever scale/pivot they were
				// authored at — normalize so "very small" is enforced
				// here, not assumed from the file.
				const box = new THREE.Box3().setFromObject(obj);
				const size = box.getSize(new THREE.Vector3());
				const center = box.getCenter(new THREE.Vector3());
				obj.position.sub(center);
				const maxDimension = Math.max(size.x, size.y, size.z) || 1;
				obj.scale.setScalar(2 / maxDimension);

				obj.traverse((child) => {
					if (child instanceof THREE.Mesh) {
						child.castShadow = true;
					}
				});

				scene.add(obj);

				// Re-measure in world space (after centering + scaling)
				// to find exactly where the model's bottom actually
				// lands, rather than re-deriving it from the pre-scale
				// numbers above.
				const groundY = new THREE.Box3().setFromObject(obj).min.y;
				const ground = new THREE.Mesh(
					new THREE.PlaneGeometry(6, 6),
					// Renders as fully transparent except where a shadow
					// falls — the model reads as "sitting on" the
					// viewer's own background rather than an opaque disc.
					new THREE.ShadowMaterial({ opacity: 0.25 }),
				);
				ground.rotation.x = -Math.PI / 2;
				ground.position.y = groundY;
				ground.receiveShadow = true;
				scene.add(ground);
			});
		});

		let animationId: number | null = null;

		function renderLoop() {
			controls.update();
			renderer.render(scene, camera);
			animationId = requestAnimationFrame(renderLoop);
		}

		function startLoop() {
			if (animationId === null) {
				animationId = requestAnimationFrame(renderLoop);
			}
		}

		function stopLoop() {
			if (animationId !== null) {
				cancelAnimationFrame(animationId);
				animationId = null;
			}
		}

		// Only actually render while the viewer is on-screen and the tab
		// is visible — no point spending GPU/battery on a spin nobody's
		// looking at.
		let isIntersecting = false;

		const observer = new IntersectionObserver(
			([entry]) => {
				isIntersecting = entry.isIntersecting;
				if (isIntersecting && document.visibilityState === 'visible') {
					startLoop();
				} else {
					stopLoop();
				}
			},
			{ threshold: 0.01 },
		);
		observer.observe(container);

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible' && isIntersecting) {
				startLoop();
			} else {
				stopLoop();
			}
		});

		window.addEventListener('resize', () => {
			const w = container.clientWidth;
			const h = container.clientHeight;
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			renderer.setSize(w, h);
		});
	}
</script>
