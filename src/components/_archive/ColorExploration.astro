---
// ARCHIVED 2026-09-18 — superseded by ../ColorFavorites.astro. This
// was the full open-ended tinkering tool (Temperature/Compression/Ink
// sliders, an 8-swatch Accent grid, unlimited saved favorites) used to
// land on a shortlist of candidate palettes. That job is done — Jake
// narrowed it to four favorites (Rust/Teal/Moss/Cobalt) and just needs
// to pick one of those, not keep exploring — so ColorFavorites.astro
// (tokens + those four favorites only, no sliders, nothing new to
// save) replaced it as the panel Base.astro actually renders.
//
// Kept here rather than deleted in case wide-open exploration like
// this is ever useful again (a future rebrand, a stuck decision) —
// still fully functional, just not imported/rendered anywhere.
//
// DEV-ONLY. Was rendered conditionally by Base.astro
// ({import.meta.env.DEV && <ColorExploration />}), so the whole
// component — markup, styles, and script — is dead-code-eliminated
// from production builds, not just hidden.
//
// Four independent controls drive the entire OKLCH-formula token
// system defined in global.css (Temperature/Compression/Ink control
// the neutral ramp; Accent is resolved directly here). Nothing this
// panel does is "final" — it's a tool for landing on a favorite
// combination, then handing the resolved token values off to be
// committed as literal values in global.css.
---

<div id="color-exploration" class="color-exploration">
	<div class="color-exploration__header">
		<p class="color-exploration__label">Color exploration</p>
		<button type="button" class="color-exploration__collapse" id="ce-collapse" aria-expanded="true" aria-label="Collapse panel">−</button>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Temperature</div>
		<label class="color-exploration__field">
			<span>Hue <output id="ce-hue-value"></output></span>
			<input type="range" id="ce-hue" min="0" max="280" step="1" />
		</label>
		<label class="color-exploration__field">
			<span>Tint strength <output id="ce-chroma-value"></output></span>
			<input type="range" id="ce-chroma" min="0" max="0.04" step="0.001" />
		</label>
		<p class="color-exploration__hint" id="ce-hue-label"></p>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Compression</div>
		<label class="color-exploration__field">
			<span>Field → surface <output id="ce-compression-value"></output></span>
			<input type="range" id="ce-compression" min="0" max="1" step="0.01" />
		</label>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Ink</div>
		<div class="color-exploration__toggle" role="radiogroup" aria-label="Ink">
			<button type="button" data-ink="pure-black">Pure black</button>
			<button type="button" data-ink="warm-10">Warm 10%</button>
			<button type="button" data-ink="warm-15">Warm 15%</button>
			<button type="button" data-ink="warm-20">Warm 20%</button>
		</div>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Accent</div>
		<div class="color-exploration__toggle color-exploration__toggle--accent" role="radiogroup" aria-label="Accent">
			<button type="button" data-accent="none">None</button>
			<button type="button" data-accent="ochre"
				><span class="color-exploration__swatch" style="background: oklch(0.62 0.12 80);"></span>Ochre</button
			>
			<button type="button" data-accent="rust"
				><span class="color-exploration__swatch" style="background: oklch(0.55 0.14 40);"></span>Rust</button
			>
			<button type="button" data-accent="moss"
				><span class="color-exploration__swatch" style="background: oklch(0.5 0.09 145);"></span>Moss</button
			>
			<button type="button" data-accent="cobalt"
				><span class="color-exploration__swatch" style="background: oklch(0.549 0.185 262.4);"></span>Cobalt</button
			>
			<button type="button" data-accent="teal"
				><span class="color-exploration__swatch" style="background: oklch(0.5 0.1 200);"></span>Teal</button
			>
			<button type="button" data-accent="plum"
				><span class="color-exploration__swatch" style="background: oklch(0.45 0.13 320);"></span>Plum</button
			>
			<button type="button" data-accent="coral"
				><span class="color-exploration__swatch" style="background: oklch(0.62 0.15 25);"></span>Coral</button
			>
		</div>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Favorites</div>
		<div class="color-exploration__favorites" id="ce-favorites"></div>
		<button type="button" class="color-exploration__save-favorite" id="ce-save-favorite">+ Save current</button>
	</div>

	<div class="color-exploration__group">
		<div class="color-exploration__group-title">Tokens (click to copy)</div>
		<ul class="color-exploration__tokens" id="ce-tokens"></ul>
		<p class="color-exploration__copied" id="ce-copied" aria-live="polite"></p>
	</div>
</div>

<style>
	.color-exploration {
		position: fixed;
		left: 12px;
		bottom: 12px;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 12px;
		width: 260px;
		max-height: calc(100vh - 24px);
		overflow-y: auto;
		border-radius: 10px;
		background: #fff;
		border: 1px solid #d8d7d2;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12px;
		color: #111;
	}

	.color-exploration__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.color-exploration__label {
		margin: 0;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #767570;
	}

	.color-exploration__collapse {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		font: inherit;
		font-size: 13px;
		line-height: 1;
		border-radius: 4px;
		border: 1px solid #d8d7d2;
		background: #fff;
		color: #444;
		cursor: pointer;
	}

	/* Collapsed: only the header row (label + toggle) stays visible —
	   the panel shrinks down to a small pill anchored at the same
	   bottom-left spot rather than disappearing, so it's still there to
	   reach for without being in the way while not in use. */
	.color-exploration.is-collapsed {
		width: auto;
		max-height: none;
		padding: 8px 10px;
	}

	.color-exploration.is-collapsed > .color-exploration__group {
		display: none;
	}

	.color-exploration__group {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-block-start: 8px;
		border-top: 1px solid #eeece7;
	}

	.color-exploration__group:first-of-type {
		padding-block-start: 0;
		border-top: none;
	}

	.color-exploration__group-title {
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #767570;
	}

	.color-exploration__field {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.color-exploration__field span {
		display: flex;
		justify-content: space-between;
		font-size: 11px;
		color: #444;
	}

	.color-exploration__field output {
		font-variant-numeric: tabular-nums;
		color: #767570;
	}

	.color-exploration input[type='range'] {
		width: 100%;
	}

	.color-exploration__hint {
		margin: 0;
		font-size: 10px;
		color: #9b9a95;
		font-style: italic;
	}

	.color-exploration__toggle {
		display: flex;
		flex-wrap: wrap;
		border-radius: 6px;
		border: 1px solid #d8d7d2;
		overflow: hidden;
	}

	.color-exploration__toggle button {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		font: inherit;
		font-size: 11px;
		padding: 6px 4px;
		background: #fff;
		color: #111;
		cursor: pointer;
		white-space: nowrap;
	}

	.color-exploration__toggle button + button {
		border-left: 1px solid #d8d7d2;
	}

	/* Accent has grown past a single row — a real 4-column grid, not
	   flex-wrap, so the 5th button starts a clean new row instead of
	   wrapping wherever it happens to run out of space. The 1px gap
	   plus a matching container background shows through as gridlines
	   in both directions, which is simpler and more reliable than
	   nth-child math for which buttons should/shouldn't get a border
	   on which side. Overrides the plain toggle's own border-left
	   rule above (same specificity, later in the file wins) since that
	   rule would otherwise still draw a stray line at the start of
	   row 2. */
	.color-exploration__toggle--accent {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		background: #d8d7d2;
	}

	.color-exploration__toggle--accent button,
	.color-exploration__toggle--accent button + button {
		border-left: none;
	}

	.color-exploration__toggle button[aria-pressed='true'] {
		background: #111;
		color: #fff;
	}

	.color-exploration__swatch {
		display: block;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.color-exploration__tokens {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* :global() on the dynamic parts below — the li/button/span rows
	   are created client-side (document.createElement/innerHTML in the
	   script), so Astro's scoped-CSS attribute (added only to elements
	   present in this file's own template — just the outer <ul> here)
	   never lands on them; an unscoped selector is the only way these
	   rules actually match. */
	.color-exploration__tokens :global(li button) {
		display: flex;
		align-items: center;
		gap: 6px;
		width: 100%;
		font: inherit;
		font-size: 10.5px;
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		padding: 3px 4px;
		border-radius: 4px;
		background: none;
		border: none;
		color: #333;
		cursor: pointer;
		text-align: left;
	}

	.color-exploration__tokens :global(li button:hover) {
		background: #f2f1ec;
	}

	.color-exploration__tokens :global(.ce-swatch) {
		display: block;
		width: 12px;
		height: 12px;
		border-radius: 3px;
		border: 1px solid rgba(0, 0, 0, 0.12);
		flex-shrink: 0;
	}

	.color-exploration__tokens :global(.ce-name) {
		color: #767570;
	}

	.color-exploration__tokens :global(.ce-hex) {
		margin-left: auto;
	}

	.color-exploration__copied {
		margin: 0;
		min-height: 12px;
		font-size: 10px;
		color: #767570;
	}

	.color-exploration__favorites {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.color-exploration__save-favorite {
		align-self: flex-start;
		font: inherit;
		font-size: 11px;
		padding: 5px 8px;
		border-radius: 6px;
		border: 1px dashed #d8d7d2;
		background: #fff;
		color: #444;
		cursor: pointer;
	}

	/* :global() — favorite chips are created client-side (a saved
	   config becomes a DOM element only when rendered), same reason as
	   the token rows above: Astro's scoped-CSS attribute never lands on
	   elements that don't exist in this file's own template. */
	.color-exploration__favorites :global(.ce-favorite) {
		position: relative;
	}

	.color-exploration__favorites :global(.ce-favorite__apply) {
		width: 28px;
		height: 28px;
		padding: 0;
		border-radius: 6px;
		border: 1px solid #d8d7d2;
		cursor: pointer;
	}

	.color-exploration__favorites :global(.ce-favorite__apply.is-active) {
		border-color: #111;
		box-shadow: 0 0 0 1px #111;
	}

	.color-exploration__favorites :global(.ce-favorite__accent-dot) {
		position: absolute;
		bottom: -3px;
		right: -3px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1px solid rgba(0, 0, 0, 0.15);
	}

	.color-exploration__favorites :global(.ce-favorite__remove) {
		position: absolute;
		top: -6px;
		right: -6px;
		width: 14px;
		height: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 1px solid #d8d7d2;
		background: #fff;
		color: #767570;
		font-size: 9px;
		line-height: 1;
		padding: 0;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.color-exploration__favorites :global(.ce-favorite:hover .ce-favorite__remove) {
		opacity: 1;
	}
</style>

<script>
	type InkKey = 'pure-black' | 'warm-10' | 'warm-15' | 'warm-20';
	type AccentKey = 'none' | 'ochre' | 'rust' | 'moss' | 'cobalt' | 'teal' | 'plum' | 'coral';

	const INK_CONFIG: Record<InkKey, { lightness: number; chromaMix: number }> = {
		'pure-black': { lightness: 0.04, chromaMix: 0 },
		'warm-10': { lightness: 0.1, chromaMix: 1 },
		'warm-15': { lightness: 0.15, chromaMix: 1 },
		'warm-20': { lightness: 0.2, chromaMix: 1 },
	};

	// Fixed accent hues — deliberately NOT tied to --neutral-hue. These
	// are real color decisions (ochre/rust/a wildcard), not neutrals.
	const ACCENT_CONFIG: Record<Exclude<AccentKey, 'none'>, string> = {
		ochre: 'oklch(0.62 0.12 80)',
		rust: 'oklch(0.55 0.14 40)',
		moss: 'oklch(0.5 0.09 145)',
		// Converted from #3169DB (a real hex Jake picked), not a guess.
		cobalt: 'oklch(0.549 0.185 262.4)',
		// Three more filling the rest of the hue wheel, same register —
		// just for fun, to see what a fuller spread looks like live.
		teal: 'oklch(0.5 0.1 200)',
		plum: 'oklch(0.45 0.13 320)',
		coral: 'oklch(0.62 0.15 25)',
	};

	const TOKENS: { label: string; varName: string }[] = [
		{ label: 'Page field', varName: '--color-bg' },
		{ label: 'Panel/band', varName: '--color-panel' },
		{ label: 'Neutral well', varName: '--color-neutral' },
		{ label: 'Line', varName: '--color-line' },
		{ label: 'Ink', varName: '--color-ink' },
		{ label: 'Ink muted', varName: '--color-ink-muted' },
		{ label: 'Accent', varName: '--color-accent' },
	];

	const STORAGE_KEYS = {
		hue: 'jr-color-hue',
		chroma: 'jr-color-chroma',
		compression: 'jr-color-compression',
		ink: 'jr-color-ink',
		accent: 'jr-color-accent',
	};

	const FAVORITES_KEY = 'jr-color-favorites';
	const COLLAPSED_KEY = 'jr-color-collapsed';

	const DEFAULTS = {
		hue: 55,
		chroma: 0.012,
		compression: 0.35,
		ink: 'warm-15' as InkKey,
		accent: 'none' as AccentKey,
	};

	const root = document.documentElement;

	const hueInput = document.querySelector<HTMLInputElement>('#ce-hue');
	const chromaInput = document.querySelector<HTMLInputElement>('#ce-chroma');
	const compressionInput = document.querySelector<HTMLInputElement>('#ce-compression');
	const hueValueOut = document.querySelector<HTMLOutputElement>('#ce-hue-value');
	const chromaValueOut = document.querySelector<HTMLOutputElement>('#ce-chroma-value');
	const compressionValueOut = document.querySelector<HTMLOutputElement>('#ce-compression-value');
	const hueLabelEl = document.querySelector<HTMLParagraphElement>('#ce-hue-label');
	const inkButtons = document.querySelectorAll<HTMLButtonElement>('[data-ink]');
	const accentButtons = document.querySelectorAll<HTMLButtonElement>('[data-accent]');
	const tokensList = document.querySelector<HTMLUListElement>('#ce-tokens');
	const copiedEl = document.querySelector<HTMLParagraphElement>('#ce-copied');
	const favoritesList = document.querySelector<HTMLDivElement>('#ce-favorites');
	const saveFavoriteBtn = document.querySelector<HTMLButtonElement>('#ce-save-favorite');
	const panelEl = document.querySelector<HTMLElement>('#color-exploration');
	const collapseBtn = document.querySelector<HTMLButtonElement>('#ce-collapse');

	function hueLabel(hue: number, chroma: number): string {
		if (chroma < 0.003) return 'Neutral';
		if (hue >= 200 && hue <= 260) return 'Cool blue-gray';
		if (hue >= 45 && hue < 75) return 'Warm paper';
		if (hue >= 20 && hue < 45) return 'Warm gray';
		return 'Custom';
	}

	function applyTemperature(hue: number, chroma: number) {
		root.style.setProperty('--neutral-hue', String(hue));
		root.style.setProperty('--neutral-chroma', String(chroma));
		if (hueValueOut) hueValueOut.textContent = `${hue}°`;
		if (chromaValueOut) chromaValueOut.textContent = chroma.toFixed(3);
		if (hueLabelEl) hueLabelEl.textContent = hueLabel(hue, chroma);
	}

	function applyCompression(value: number) {
		root.style.setProperty('--compression', String(value));
		if (compressionValueOut) compressionValueOut.textContent = value.toFixed(2);
	}

	function applyInk(key: InkKey) {
		const config = INK_CONFIG[key];
		root.style.setProperty('--ink-lightness', String(config.lightness));
		root.style.setProperty('--ink-chroma-mix', String(config.chromaMix));
		inkButtons.forEach((btn) => {
			btn.setAttribute('aria-pressed', String(btn.dataset.ink === key));
		});
		// --color-accent is kept as a literal `var(--color-ink)` reference
		// (not a resolved value) whenever Accent is "None", so it tracks
		// ink changes automatically — no need to re-apply it here.
	}

	function applyAccent(key: AccentKey) {
		root.style.setProperty('--color-accent', key === 'none' ? 'var(--color-ink)' : ACCENT_CONFIG[key]);
		accentButtons.forEach((btn) => {
			btn.setAttribute('aria-pressed', String(btn.dataset.accent === key));
		});
		// Same convention as Hero's own hero-model-change: anything that
		// needs to react to the live accent (currently: the toolbox
		// model's texture, if it's the model on screen) listens for this
		// rather than polling --color-accent itself.
		window.dispatchEvent(new CustomEvent('color-accent-change', { detail: { accent: key } }));
	}

	// --- Token readout -----------------------------------------------
	// Reuses the browser's own cascade as the source of truth (rather
	// than re-implementing the OKLCH formulas in JS): a hidden probe
	// element gets `color: var(--token)`, which resolves var()/calc()
	// against the live cascade. getComputedStyle's *serialization* of
	// that, though, is another oklch() string (Chrome keeps color
	// functions in their original space rather than converting to
	// rgb()) — so the actual sRGB byte values come from rasterizing it
	// on a 1x1 canvas and reading the pixel back.
	const probe = document.createElement('div');
	probe.style.position = 'absolute';
	probe.style.width = '0';
	probe.style.height = '0';
	probe.style.overflow = 'hidden';
	probe.style.pointerEvents = 'none';
	document.body.appendChild(probe);

	const swatchCanvas = document.createElement('canvas');
	swatchCanvas.width = 1;
	swatchCanvas.height = 1;
	const swatchCtx = swatchCanvas.getContext('2d', { willReadFrequently: true });

	function resolveHex(varName: string): string {
		probe.style.color = `var(${varName})`;
		const computed = getComputedStyle(probe).color;
		if (!swatchCtx) return '#000000';
		swatchCtx.fillStyle = computed;
		swatchCtx.fillRect(0, 0, 1, 1);
		const [r, g, b] = swatchCtx.getImageData(0, 0, 1, 1).data;
		return `#${[r, g, b].map((n) => n.toString(16).padStart(2, '0')).join('')}`;
	}

	function renderTokens() {
		if (!tokensList) return;
		tokensList.innerHTML = '';
		TOKENS.forEach(({ label, varName }) => {
			const hex = resolveHex(varName);
			const li = document.createElement('li');
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.innerHTML = `<span class="ce-swatch" style="background:${hex}"></span><span class="ce-name">${varName}</span><span class="ce-hex">${hex}</span>`;
			btn.addEventListener('click', async () => {
				const text = `${varName}: ${hex};`;
				try {
					await navigator.clipboard.writeText(text);
					if (copiedEl) copiedEl.textContent = `Copied ${varName}`;
				} catch {
					if (copiedEl) copiedEl.textContent = text;
				}
				window.setTimeout(() => {
					if (copiedEl) copiedEl.textContent = '';
				}, 1750);
			});
			li.appendChild(btn);
			tokensList.appendChild(li);
		});
	}

	// --- Favorites -----------------------------------------------------
	// A saved snapshot of all five controls, so you can keep tweaking and
	// come back to compare against something you already liked — or drop
	// it once it's no longer in the running.
	interface Favorite {
		id: string;
		hue: number;
		chroma: number;
		compression: number;
		ink: InkKey;
		accent: AccentKey;
	}

	function loadFavorites(): Favorite[] {
		try {
			const raw = localStorage.getItem(FAVORITES_KEY);
			return raw ? JSON.parse(raw) : [];
		} catch {
			return [];
		}
	}

	function saveFavorites(favorites: Favorite[]) {
		localStorage.setItem(FAVORITES_KEY, JSON.stringify(favorites));
	}

	function currentSnapshot(): Favorite {
		return {
			id: '',
			hue: Number(hueInput?.value ?? DEFAULTS.hue),
			chroma: Number(chromaInput?.value ?? DEFAULTS.chroma),
			compression: Number(compressionInput?.value ?? DEFAULTS.compression),
			ink: (localStorage.getItem(STORAGE_KEYS.ink) as InkKey | null) ?? DEFAULTS.ink,
			accent: (localStorage.getItem(STORAGE_KEYS.accent) as AccentKey | null) ?? DEFAULTS.accent,
		};
	}

	function sameConfig(a: Favorite, b: Favorite): boolean {
		return a.hue === b.hue && a.chroma === b.chroma && a.compression === b.compression && a.ink === b.ink && a.accent === b.accent;
	}

	// Preview swatches don't touch the live page at all (unlike applying
	// a favorite) — they just replicate global.css's own --color-bg/
	// --color-ink formulas directly as literal oklch() values in a
	// style attribute, independent of whatever the current live tokens
	// resolve to. No need for the canvas/hex trick the token readout
	// uses either: a preview swatch can show a raw oklch() color as-is,
	// only the copyable token list needs an actual hex string.
	function previewColors(fav: Favorite): { bg: string; accent: string } {
		const ink = INK_CONFIG[fav.ink];
		const bg = `oklch(0.99 ${fav.chroma} ${fav.hue})`;
		const inkColor = `oklch(${ink.lightness} ${fav.chroma * ink.chromaMix * 3} ${fav.hue})`;
		const accent = fav.accent === 'none' ? inkColor : ACCENT_CONFIG[fav.accent];
		return { bg, accent };
	}

	function applyFavorite(fav: Favorite) {
		if (hueInput) hueInput.value = String(fav.hue);
		if (chromaInput) chromaInput.value = String(fav.chroma);
		if (compressionInput) compressionInput.value = String(fav.compression);
		applyTemperature(fav.hue, fav.chroma);
		applyCompression(fav.compression);
		applyInk(fav.ink);
		applyAccent(fav.accent);
		localStorage.setItem(STORAGE_KEYS.hue, String(fav.hue));
		localStorage.setItem(STORAGE_KEYS.chroma, String(fav.chroma));
		localStorage.setItem(STORAGE_KEYS.compression, String(fav.compression));
		localStorage.setItem(STORAGE_KEYS.ink, fav.ink);
		localStorage.setItem(STORAGE_KEYS.accent, fav.accent);
		refresh();
	}

	function removeFavorite(id: string) {
		saveFavorites(loadFavorites().filter((fav) => fav.id !== id));
		renderFavorites();
	}

	function renderFavorites() {
		if (!favoritesList) return;
		favoritesList.innerHTML = '';
		const current = currentSnapshot();
		loadFavorites().forEach((fav) => {
			const { bg, accent } = previewColors(fav);
			const item = document.createElement('div');
			item.className = 'ce-favorite';

			const applyBtn = document.createElement('button');
			applyBtn.type = 'button';
			applyBtn.className = 'ce-favorite__apply';
			if (sameConfig(fav, current)) applyBtn.classList.add('is-active');
			applyBtn.style.background = bg;
			applyBtn.title = `${fav.hue}° · ${fav.ink} · ${fav.accent}`;
			applyBtn.addEventListener('click', () => applyFavorite(fav));

			const dot = document.createElement('span');
			dot.className = 'ce-favorite__accent-dot';
			dot.style.background = accent;
			applyBtn.appendChild(dot);

			const removeBtn = document.createElement('button');
			removeBtn.type = 'button';
			removeBtn.className = 'ce-favorite__remove';
			removeBtn.setAttribute('aria-label', 'Remove favorite');
			removeBtn.textContent = '×';
			removeBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				removeFavorite(fav.id);
			});

			item.appendChild(applyBtn);
			item.appendChild(removeBtn);
			favoritesList.appendChild(item);
		});
	}

	saveFavoriteBtn?.addEventListener('click', () => {
		const favorites = loadFavorites();
		// Date.now() alone can collide — two saves within the same
		// millisecond (a real risk from a fast double-click, not just
		// automated testing) would get identical ids, and removing one
		// would then match and delete both.
		const id = crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
		// Spread order matters: currentSnapshot() itself includes a
		// placeholder id: '' (so it satisfies the Favorite shape for
		// sameConfig() comparisons) — spreading it *after* id here would
		// silently overwrite the real generated id with that empty
		// string, which is exactly what happened (every favorite ended
		// up with the same id: '', so removing one removed all of them).
		favorites.push({ ...currentSnapshot(), id });
		saveFavorites(favorites);
		renderFavorites();
	});

	// --- Collapse --------------------------------------------------------
	function setCollapsed(collapsed: boolean) {
		panelEl?.classList.toggle('is-collapsed', collapsed);
		collapseBtn?.setAttribute('aria-expanded', String(!collapsed));
		if (collapseBtn) collapseBtn.textContent = collapsed ? '+' : '−';
		localStorage.setItem(COLLAPSED_KEY, String(collapsed));
	}

	setCollapsed(localStorage.getItem(COLLAPSED_KEY) === 'true');

	collapseBtn?.addEventListener('click', () => {
		setCollapsed(!(panelEl?.classList.contains('is-collapsed') ?? false));
	});

	function refresh() {
		renderTokens();
		renderFavorites();
	}

	// --- Restore from localStorage ------------------------------------
	const savedHue = Number(localStorage.getItem(STORAGE_KEYS.hue) ?? DEFAULTS.hue);
	const savedChroma = Number(localStorage.getItem(STORAGE_KEYS.chroma) ?? DEFAULTS.chroma);
	const savedCompression = Number(localStorage.getItem(STORAGE_KEYS.compression) ?? DEFAULTS.compression);
	const savedInk = (localStorage.getItem(STORAGE_KEYS.ink) as InkKey | null) ?? DEFAULTS.ink;
	const savedAccent = (localStorage.getItem(STORAGE_KEYS.accent) as AccentKey | null) ?? DEFAULTS.accent;

	if (hueInput) hueInput.value = String(savedHue);
	if (chromaInput) chromaInput.value = String(savedChroma);
	if (compressionInput) compressionInput.value = String(savedCompression);

	applyTemperature(savedHue, savedChroma);
	applyCompression(savedCompression);
	applyInk(savedInk);
	applyAccent(savedAccent);
	refresh();

	// --- Listeners ------------------------------------------------------
	hueInput?.addEventListener('input', () => {
		const hue = Number(hueInput.value);
		const chroma = Number(chromaInput?.value ?? DEFAULTS.chroma);
		applyTemperature(hue, chroma);
		localStorage.setItem(STORAGE_KEYS.hue, String(hue));
		refresh();
	});

	chromaInput?.addEventListener('input', () => {
		const hue = Number(hueInput?.value ?? DEFAULTS.hue);
		const chroma = Number(chromaInput.value);
		applyTemperature(hue, chroma);
		localStorage.setItem(STORAGE_KEYS.chroma, String(chroma));
		refresh();
	});

	compressionInput?.addEventListener('input', () => {
		const value = Number(compressionInput.value);
		applyCompression(value);
		localStorage.setItem(STORAGE_KEYS.compression, String(value));
		refresh();
	});

	inkButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const key = (btn.dataset.ink as InkKey) ?? DEFAULTS.ink;
			applyInk(key);
			localStorage.setItem(STORAGE_KEYS.ink, key);
			refresh();
		});
	});

	accentButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const key = (btn.dataset.accent as AccentKey) ?? DEFAULTS.accent;
			applyAccent(key);
			localStorage.setItem(STORAGE_KEYS.accent, key);
			refresh();
		});
	});
</script>
