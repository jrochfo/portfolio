---
// DEV-ONLY, same pattern as FontAudition.astro — gated in Base.astro
// by FONT_VARIATION_TUNER_ENABLED && import.meta.env.DEV, so it's
// dead-code-eliminated from production builds. Quick tool for tuning
// Fraunces' SOFT/WONK axes live; delete once locked, or leave
// disabled in the codebase the same way FontAudition was.
---

<div id="variation-tuner" class="variation-tuner">
	<p class="variation-tuner__label">SOFT / WONK</p>

	<label class="variation-tuner__field">
		<span>SOFT <output id="vt-soft-value">0</output></span>
		<input type="range" id="vt-soft" min="0" max="100" step="1" value="0" />
	</label>

	<label class="variation-tuner__field">
		<span>WONK <output id="vt-wonk-value">0</output></span>
		<input type="range" id="vt-wonk" min="0" max="1" step="0.01" value="0" />
	</label>

	<div class="variation-tuner__presets">
		<button type="button" data-wonk="0">WONK 0</button>
		<button type="button" data-wonk="1">WONK 1</button>
	</div>
</div>

<style>
	.variation-tuner {
		position: fixed;
		right: 12px;
		bottom: 12px;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 12px;
		width: 200px;
		border-radius: 10px;
		background: #fff;
		border: 1px solid #d8d7d2;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12px;
		color: #111;
	}

	.variation-tuner__label {
		margin: 0;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #767570;
	}

	.variation-tuner__field {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.variation-tuner__field span {
		display: flex;
		justify-content: space-between;
		font-size: 11px;
		color: #444;
	}

	.variation-tuner__field output {
		font-variant-numeric: tabular-nums;
		color: #767570;
	}

	.variation-tuner input[type='range'] {
		width: 100%;
	}

	.variation-tuner__presets {
		display: flex;
		gap: 6px;
	}

	.variation-tuner__presets button {
		flex: 1;
		font: inherit;
		font-size: 11px;
		padding: 5px 4px;
		border-radius: 6px;
		border: 1px solid #d8d7d2;
		background: #fff;
		color: #111;
		cursor: pointer;
	}
</style>

<script>
	const STORAGE_KEYS = {
		soft: 'jr-font-variation-soft',
		wonk: 'jr-font-variation-wonk',
	};

	const root = document.documentElement;
	const softInput = document.querySelector<HTMLInputElement>('#vt-soft');
	const wonkInput = document.querySelector<HTMLInputElement>('#vt-wonk');
	const softValueEl = document.querySelector<HTMLOutputElement>('#vt-soft-value');
	const wonkValueEl = document.querySelector<HTMLOutputElement>('#vt-wonk-value');
	const presetButtons = document.querySelectorAll<HTMLButtonElement>('.variation-tuner__presets button');

	function apply(soft: string, wonk: string) {
		root.style.setProperty('--font-display-variation', `'SOFT' ${soft}, 'WONK' ${wonk}`);
		if (softValueEl) softValueEl.textContent = soft;
		if (wonkValueEl) wonkValueEl.textContent = wonk;
	}

	const savedSoft = localStorage.getItem(STORAGE_KEYS.soft) ?? '0';
	const savedWonk = localStorage.getItem(STORAGE_KEYS.wonk) ?? '0';
	if (softInput) softInput.value = savedSoft;
	if (wonkInput) wonkInput.value = savedWonk;
	apply(savedSoft, savedWonk);

	softInput?.addEventListener('input', () => {
		apply(softInput.value, wonkInput?.value ?? '0');
		localStorage.setItem(STORAGE_KEYS.soft, softInput.value);
	});

	wonkInput?.addEventListener('input', () => {
		apply(softInput?.value ?? '0', wonkInput.value);
		localStorage.setItem(STORAGE_KEYS.wonk, wonkInput.value);
	});

	presetButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const wonk = btn.dataset.wonk ?? '0';
			if (wonkInput) wonkInput.value = wonk;
			apply(softInput?.value ?? '0', wonk);
			localStorage.setItem(STORAGE_KEYS.wonk, wonk);
		});
	});
</script>
