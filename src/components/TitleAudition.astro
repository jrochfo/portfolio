---
// Temporary: auditions calmer dark-mode title greens against the
// current lime. Each candidate keeps roughly the light-mode title's
// hue and drops the saturation (the lime is more saturated than its
// light sibling, which is what makes it read neon). Only dark mode is
// affected; light mode keeps its title.
//
// Hidden unless asked for, so it can ride along on the live site: it
// shows in dev, or with ?titles in the URL (remembered after that;
// ?titles=off forgets it).
const options = [
	{ key: 'current', name: 'Current lime', hex: '#a6e04a' },
	{ key: 'sage', name: 'Sage', hex: '#afc798' },
	{ key: 'moss', name: 'Moss', hex: '#a0c582' },
	{ key: 'olive', name: 'Olive-gold', hex: '#bbc679' },
	{ key: 'fern', name: 'Deep fern', hex: '#82b570' },
];
const dev = import.meta.env.DEV;
---

<div class="title-audition" data-options={JSON.stringify(options)} data-dev={dev ? 'true' : undefined} hidden>
	<p class="title-audition__head">
		Dark-mode title
		<button type="button" class="title-audition__mode" data-mode>Switch to dark</button>
	</p>
	<div class="title-audition__list">
		{options.map((o) => (
			<button type="button" class="title-audition__row" data-key={o.key}>
				<span class="title-audition__chip" style={`background:${o.hex}`} />
				<span>{o.name}</span>
				<span class="title-audition__hex">{o.hex}</span>
			</button>
		))}
	</div>
</div>

<style>
	/* Fixed colors, not site tokens, so the panel reads the same in
	   either mode. */
	.title-audition {
		position: fixed;
		left: 16px;
		bottom: 16px;
		z-index: 9999;
		width: 230px;
		padding: 10px;
		border-radius: 12px;
		background: #fff;
		color: #1a1a1a;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
		font: 500 12px/1.3 system-ui, sans-serif;
	}

	.title-audition[hidden] {
		display: none;
	}

	.title-audition__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin: 0 0 8px;
		font-weight: 600;
	}

	.title-audition__mode {
		padding: 3px 8px;
		border: 1px solid #ddd;
		border-radius: 6px;
		background: #fff;
		color: inherit;
		font: inherit;
		font-weight: 500;
		cursor: pointer;
	}

	.title-audition__list {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.title-audition__row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 6px;
		border: 2px solid transparent;
		border-radius: 8px;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.title-audition__row[aria-pressed='true'] {
		border-color: #1a1a1a;
	}

	.title-audition__chip {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15);
		background: #15140b;
	}

	.title-audition__hex {
		margin-left: auto;
		color: #777;
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	type Option = { key: string; name: string; hex: string };
	const panel = document.querySelector<HTMLElement>('.title-audition');
	const FLAG = 'title-audition';
	const PICK = 'title-audition-pick';

	if (panel) {
		const params = new URLSearchParams(location.search);
		try {
			if (params.get('titles') === 'off') localStorage.removeItem(FLAG);
			else if (params.has('titles')) localStorage.setItem(FLAG, '1');
		} catch {}
		let flagged = false;
		try {
			flagged = localStorage.getItem(FLAG) === '1';
		} catch {}

		if (panel.dataset.dev || flagged) {
			panel.hidden = false;
			const options: Option[] = JSON.parse(panel.dataset.options || '[]');
			const rows = [...panel.querySelectorAll<HTMLButtonElement>('[data-key]')];
			const modeButton = panel.querySelector<HTMLButtonElement>('[data-mode]')!;
			const html = document.documentElement;
			// Overrides only the dark block's title — a rule, not an inline
			// style on :root, so light mode is left alone.
			const style = document.createElement('style');
			document.head.appendChild(style);

			function apply(key: string) {
				const o = options.find((x) => x.key === key) ?? options[0];
				style.textContent = o.key === 'current' ? '' : `:root[data-theme='dark'] { --color-title: ${o.hex}; }`;
				rows.forEach((r) => r.setAttribute('aria-pressed', String(r.dataset.key === o.key)));
				try {
					localStorage.setItem(PICK, o.key);
				} catch {}
			}

			function syncMode() {
				modeButton.textContent = html.dataset.theme === 'dark' ? 'Switch to light' : 'Switch to dark';
			}

			rows.forEach((r) => r.addEventListener('click', () => apply(r.dataset.key!)));
			// Asks the nav's toggle to switch, same as the old palette panel.
			modeButton.addEventListener('click', () => {
				window.dispatchEvent(
					new CustomEvent('theme-set', { detail: { mode: html.dataset.theme === 'dark' ? 'light' : 'dark' } }),
				);
			});
			window.addEventListener('theme-change', syncMode);

			let saved = 'current';
			try {
				saved = localStorage.getItem(PICK) ?? 'current';
			} catch {}
			apply(saved);
			syncMode();
		}
	}
</script>
