---
import CopyEmailButton from './CopyEmailButton.astro';
import jrMark from '../assets/icons/nav/jr-full.svg';
---

<section class="close section--bleed">
	<span class="close__mark" style={`--mark-src: url(${jrMark.src})`} aria-hidden="true" />
	<div class="container close__inner">
		<div class="close__text">
			<h2 class="type-display close__headline" data-reveal>That’s the tour.</h2>
			<p class="type-h3 close__subhead" data-reveal>If it looks like a fit, I’d love to talk.</p>
		</div>
		<div class="close__actions" data-reveal>
			<a href="/about" class="button type-caption close__button desktop-only">Get in touch</a>
			<CopyEmailButton class="close__button mobile-only" label="Get in touch" />
			<a
				href="/jake-rochford-resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="button type-caption close__button close__button--secondary"
			>
				Resume
			</a>
		</div>
	</div>
</section>

<style>
	/* A content-height full-bleed band (the same band system as Testimonials and the
	   footer), and the one place the accent fills a whole surface. Text
	   on it is the page color, which reads in both modes — cream on the
	   deep green, near-black on the dark-mode butter. */
	.close {
		/* A step taller than the other bands — it's the last thing on
		   the page and sits right on the footer (see global.css). */
		padding-block: var(--space-2xl);
		--on-accent: var(--color-bg);
		background: var(--color-accent);
		color: var(--on-accent);
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	/* The JR mark cut out of the band like a stencil: page-colored and
	   exactly as tall as the band, so it runs into the page above and
	   the footer edge below. Its width follows from that height. From a
	   1500px window up it sits flush right; narrower than that it slides
	   off the right edge pixel for pixel instead of shrinking (its left
	   edge holds still, clear of the text), until it's dropped at 800px.
	   Overshoots the band by a hair top and bottom, and the right edge
	   by 2px: the SVG's shape stops just short of its own viewBox edges,
	   which otherwise leaves green slivers. */
	.close__mark {
		position: absolute;
		z-index: 0;
		top: -1px;
		bottom: -2px;
		right: calc(-2px - max(0px, 1500px - 100vw));
		aspect-ratio: 559 / 259;
		background-color: var(--on-accent);
		-webkit-mask: var(--mark-src) center / 100% 100% no-repeat;
		mask: var(--mark-src) center / 100% 100% no-repeat;
		pointer-events: none;
	}

	/* Display-size like the hero, but set to the left so the mark has
	   the right side to itself. */
	.close__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-m);
	}

	.close__headline {
		color: var(--on-accent);
	}

	.close__subhead {
		margin-block-start: var(--space-s);
	}

	.close__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	/* The buttons turn over to sit on the accent: primary is a page-color
	   pill with accent text, secondary a slightly lifted accent. Their
	   own hovers, since the site-wide hover fills with the accent —
	   which would vanish here. */
	.close :global(.close__button) {
		background: var(--on-accent);
		color: var(--color-accent);
	}

	.close :global(.close__button):hover,
	.close :global(.close__button):focus-visible {
		background: color-mix(in oklch, var(--on-accent), var(--color-accent) 14%);
		opacity: 1;
	}

	.close :global(.close__button--secondary) {
		background: color-mix(in oklch, var(--color-accent), var(--on-accent) 16%);
		color: var(--on-accent);
	}

	.close :global(.close__button--secondary):hover,
	.close :global(.close__button--secondary):focus-visible {
		background: color-mix(in oklch, var(--color-accent), var(--on-accent) 28%);
	}

	.close :global(.close__button):focus-visible {
		outline: 2px solid var(--on-accent);
		outline-offset: 2px;
	}

	/* By here it's mostly off-screen and crowding the text. */
	@media (max-width: 800px) {
		.close__mark {
			display: none;
		}
	}

</style>
