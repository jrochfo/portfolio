---
import jrMark from '../assets/icons/nav/jr-full.svg';
---

<section class="close section--bleed">
	<span class="close__mark" style={`--mark-src: url(${jrMark.src})`} aria-hidden="true" />
	<div class="container close__inner">
		<div class="close__text">
			<h2 class="type-display close__headline" data-reveal>That’s the tour.</h2>
			<p class="type-h3 close__subhead" data-reveal>If it looks like a fit, I’d love to talk.</p>
		</div>
		<div class="close__actions" data-reveal>
			<a href="/about" class="button type-caption close__button">Get in touch</a>
			<a
				href="/jake-rochford-resume.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="button type-caption close__button close__button--secondary"
			>
				Resume
			</a>
		</div>
	</div>
</section>

<style>
	/* A content-height full-bleed band (the same band system as Testimonials and the
	   footer), and the one place the accent fills a whole surface. Text
	   on it is the page color, which reads in both modes — cream on the
	   deep green, near-black on the dark-mode butter. */
	.close {
		/* A step taller than the other bands — it's the last thing on
		   the page and sits right on the footer (see global.css). */
		padding-block: var(--space-2xl);
		--on-accent: var(--color-bg);
		background: var(--color-accent);
		color: var(--on-accent);
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	/* The JR mark cut out of the band like a stencil: page-colored, as
	   tall as the band, flush to the viewport's right edge. Its solid
	   block (the right 68.7% of the mark — the thin rays fanning off its
	   bottom-left corner are the rest) must clear the text, so the box
	   is only ever as wide as keeps that block at least --space-m past
	   the headline's end; mask-size: contain then shrinks the mark,
	   anchored bottom-right, whenever that's narrower than full height
	   allows. The headline's width is estimated from the display size
	   ("That’s the tour." runs ~6.6em) — revisit if the copy changes. */
	.close__mark {
		--text-end: calc(
			max(var(--container-margin), (100vw - var(--container-max)) / 2 + var(--container-margin))
				+ 6.8 * var(--type-display-size)
		);
		position: absolute;
		z-index: 0;
		inset-block: 0;
		/* The SVG's shape stops ~0.4 units short of its own right edge —
		   a hairline of green at this scale; pushed past the edge. */
		right: -2px;
		width: calc((100vw - var(--text-end) - var(--space-m)) / 0.687);
		background-color: var(--on-accent);
		-webkit-mask: var(--mark-src) right bottom / contain no-repeat;
		mask: var(--mark-src) right bottom / contain no-repeat;
		pointer-events: none;
	}

	/* Display-size like the hero, but set to the left so the mark has
	   the right side to itself. */
	.close__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-m);
	}

	.close__headline {
		color: var(--on-accent);
	}

	.close__subhead {
		margin-block-start: var(--space-s);
	}

	.close__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	/* The buttons turn over to sit on the accent: primary is a page-color
	   pill with accent text, secondary a slightly lifted accent. Their
	   own hovers, since the site-wide hover fills with the accent —
	   which would vanish here. */
	.close__button {
		background: var(--on-accent);
		color: var(--color-accent);
	}

	.close__button:hover,
	.close__button:focus-visible {
		background: color-mix(in oklch, var(--on-accent), var(--color-accent) 14%);
		opacity: 1;
	}

	.close__button--secondary {
		background: color-mix(in oklch, var(--color-accent), var(--on-accent) 16%);
		color: var(--on-accent);
	}

	.close__button--secondary:hover,
	.close__button--secondary:focus-visible {
		background: color-mix(in oklch, var(--color-accent), var(--on-accent) 28%);
	}

	.close__button:focus-visible {
		outline: 2px solid var(--on-accent);
		outline-offset: 2px;
	}

	/* No free side on a phone — the text takes the full width. */
	@media (max-width: 768px) {
		.close__mark {
			display: none;
		}
	}

</style>
