---
// DEV-ONLY. Rendered conditionally by Base.astro
// ({import.meta.env.DEV && <FontAudition />}), so the whole component —
// markup, styles, and script — is dead-code-eliminated from production
// builds, not just hidden. Kept intentionally even with type locked
// (see FONT_AUDITION_ENABLED in Base.astro) — useful again for any
// future type change, e.g. upgrading from free Google Fonts to a
// purchased foundry family. Re-audition will need its own Google
// Fonts <link> in Base.astro for whatever candidates that round
// tests, if the candidates are Google Fonts.
---

<div id="font-audition" class="font-audition">
	<p class="font-audition__label">Font audition</p>

	<label class="font-audition__field">
		<span>Text</span>
		<select id="fa-text">
			<option value="inter">Inter</option>
			<option value="instrument-sans">Instrument Sans</option>
			<option value="schibsted-grotesk">Schibsted Grotesk</option>
			<option value="hanken-grotesk">Hanken Grotesk</option>
			<option value="space-grotesk">Space Grotesk</option>
			<option value="public-sans">Public Sans</option>
		</select>
	</label>

	<label class="font-audition__field">
		<span>Display</span>
		<select id="fa-display">
			<option value="fraunces">Fraunces</option>
			<option value="instrument-serif">Instrument Serif</option>
			<option value="newsreader">Newsreader</option>
			<option value="playfair-display">Playfair Display</option>
			<option value="same-as-text">Same as text</option>
		</select>
	</label>

	<div class="font-audition__field">
		<span>Display scope</span>
		<div class="font-audition__toggle" role="radiogroup" aria-label="Display scope">
			<button type="button" id="fa-scope-display" data-scope="display-only">Display only</button>
			<button type="button" id="fa-scope-h1" data-scope="display-h1">Display + H1</button>
		</div>
	</div>
</div>

<style>
	.font-audition {
		position: fixed;
		left: 12px;
		bottom: 12px;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 12px;
		width: 220px;
		border-radius: 10px;
		background: #fff;
		border: 1px solid #d8d7d2;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 12px;
		color: #111;
	}

	.font-audition__label {
		margin: 0;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #767570;
	}

	.font-audition__field {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.font-audition__field span {
		font-size: 10px;
		color: #767570;
	}

	.font-audition select {
		font: inherit;
		font-size: 12px;
		padding: 5px 6px;
		border-radius: 6px;
		border: 1px solid #d8d7d2;
		background: #fff;
		color: #111;
	}

	.font-audition__toggle {
		display: flex;
		border-radius: 6px;
		border: 1px solid #d8d7d2;
		overflow: hidden;
	}

	.font-audition__toggle button {
		flex: 1;
		font: inherit;
		font-size: 11px;
		padding: 6px 4px;
		background: #fff;
		color: #111;
		cursor: pointer;
	}

	.font-audition__toggle button + button {
		border-left: 1px solid #d8d7d2;
	}

	.font-audition__toggle button[aria-pressed='true'] {
		background: #111;
		color: #fff;
	}
</style>

<script>
	const TEXT_FONTS: Record<string, string> = {
		inter: "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
		'instrument-sans': "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
		'schibsted-grotesk': "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif",
		'hanken-grotesk': "'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif",
		'space-grotesk': "'Space Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif",
		'public-sans': "'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
	};

	const DISPLAY_FONTS: Record<string, string> = {
		fraunces: "'Fraunces', Georgia, 'Times New Roman', serif",
		'instrument-serif': "'Instrument Serif', Georgia, 'Times New Roman', serif",
		newsreader: "'Newsreader', Georgia, 'Times New Roman', serif",
		'playfair-display': "'Playfair Display', Georgia, 'Times New Roman', serif",
		'same-as-text': 'var(--font-text)',
	};

	const STORAGE_KEYS = {
		text: 'jr-font-audition-text',
		display: 'jr-font-audition-display',
		scope: 'jr-font-audition-scope',
	};

	const textSelect = document.querySelector<HTMLSelectElement>('#fa-text');
	const displaySelect = document.querySelector<HTMLSelectElement>('#fa-display');
	const scopeButtons = document.querySelectorAll<HTMLButtonElement>('.font-audition__toggle button');
	const root = document.documentElement;

	function applyText(value: string) {
		root.style.setProperty('--font-text', TEXT_FONTS[value] ?? TEXT_FONTS.inter);
	}

	function applyDisplay(value: string) {
		root.style.setProperty('--font-display', DISPLAY_FONTS[value] ?? DISPLAY_FONTS.fraunces);
	}

	function applyScope(scope: string) {
		root.style.setProperty(
			'--font-h1',
			scope === 'display-h1' ? 'var(--font-display)' : 'var(--font-text)',
		);
		scopeButtons.forEach((btn) => {
			btn.setAttribute('aria-pressed', String(btn.dataset.scope === scope));
		});
	}

	// Restore from localStorage (defaults: Inter / Fraunces / Display + H1).
	const savedText = localStorage.getItem(STORAGE_KEYS.text) ?? 'inter';
	const savedDisplay = localStorage.getItem(STORAGE_KEYS.display) ?? 'fraunces';
	const savedScope = localStorage.getItem(STORAGE_KEYS.scope) ?? 'display-h1';

	if (textSelect) textSelect.value = savedText;
	if (displaySelect) displaySelect.value = savedDisplay;
	applyText(savedText);
	applyDisplay(savedDisplay);
	applyScope(savedScope);

	textSelect?.addEventListener('change', () => {
		applyText(textSelect.value);
		localStorage.setItem(STORAGE_KEYS.text, textSelect.value);
	});

	displaySelect?.addEventListener('change', () => {
		applyDisplay(displaySelect.value);
		localStorage.setItem(STORAGE_KEYS.display, displaySelect.value);
	});

	scopeButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const scope = btn.dataset.scope ?? 'display-h1';
			applyScope(scope);
			localStorage.setItem(STORAGE_KEYS.scope, scope);
		});
	});
</script>
