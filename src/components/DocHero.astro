---
// Cover image for a documentation piece — the piece's glyph, chosen for
// relevance (an infinity symbol for a piece about looping, say), tiled
// small and dense across the whole frame as a woven SVG pattern rather
// than one lone character floating in a box. The brick-offset tiling
// (each row shifted half a tile from the one above, wrapped at both
// edges of the pattern so it repeats seamlessly) is what gives the
// weave its sense of friction — no two neighboring glyphs line up.
//
// Pure SVG, no canvas and no client script: the viewBox is a fixed
// 400x300 (matching how a plain <img> would be sized), so the exact
// same markup reads correctly full-width on a piece's own page or
// shrunk into a card on the documentation index — the pattern simply
// scales with it, same as it would embedded at any other size.
interface Props {
	glyph: string;
	label: string;
}

const { glyph, label } = Astro.props;
const patternId = `doc-hero-weave-${Math.random().toString(36).slice(2, 9)}`;

const TILE_W = 24;
const ROW_H = 26;
---

<div class="doc-hero" role="img" aria-label={label}>
	<svg
		class="doc-hero__weave"
		viewBox="0 0 400 300"
		preserveAspectRatio="xMidYMid slice"
		aria-hidden="true"
	>
		<defs>
			<pattern
				id={patternId}
				width={TILE_W}
				height={ROW_H * 2}
				patternUnits="userSpaceOnUse"
				patternTransform="rotate(-6)"
			>
				<text class="doc-hero__glyph-text" x={TILE_W / 2} y={ROW_H * 0.75}>{glyph}</text>
				<text class="doc-hero__glyph-text" x="0" y={ROW_H * 1.75}>{glyph}</text>
				<text class="doc-hero__glyph-text" x={TILE_W} y={ROW_H * 1.75}>{glyph}</text>
			</pattern>
		</defs>
		<rect width="400" height="300" fill={`url(#${patternId})`} />
	</svg>
</div>

<style>
	.doc-hero {
		aspect-ratio: 4 / 3;
		width: 100%;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--color-accent);
	}

	.doc-hero__weave {
		display: block;
		width: 100%;
		height: 100%;
	}

	.doc-hero__glyph-text {
		font-family: var(--font-display);
		font-weight: var(--type-display-weight);
		font-variation-settings: var(--font-display-variation);
		font-size: 24px;
		text-anchor: middle;
		fill: var(--color-bg);
	}
</style>
