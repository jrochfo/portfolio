---
import { getImage } from 'astro:assets';

import pottery1 from '../assets/work/off-the-clock/pottery/pottery-1.jpg';
import pottery2 from '../assets/work/off-the-clock/pottery/pottery-2.jpg';
import pottery3 from '../assets/work/off-the-clock/pottery/pottery-3.jpg';

import thesis1 from '../assets/work/off-the-clock/thesis/thesis-1.jpg';
import thesis2 from '../assets/work/off-the-clock/thesis/thesis-2.jpg';
import thesis3 from '../assets/work/off-the-clock/thesis/thesis-3.jpg';
import thesis4 from '../assets/work/off-the-clock/thesis/thesis-4.jpg';
import thesis5 from '../assets/work/off-the-clock/thesis/thesis-5.jpg';

import ae1 from '../assets/work/off-the-clock/type/ae-1.png';
import ae2 from '../assets/work/off-the-clock/type/ae-2.png';
import ae3 from '../assets/work/off-the-clock/type/ae-3.png';
import qoph1 from '../assets/work/off-the-clock/type/qoph-1.png';
import qoph2 from '../assets/work/off-the-clock/type/qoph-2.png';
import qoph3 from '../assets/work/off-the-clock/type/qoph-3.png';

import raycatPoster from '../assets/work/off-the-clock/raycat/posters/raycat-poster.jpg';
import charcoalPoster from '../assets/work/off-the-clock/charcoal-Ink/posters/charcoal-ink-poster.jpg';

interface VideoMedia {
	type: 'video';
	mp4: string;
	webm: string;
	poster: string;
}

interface ImageSequenceMedia {
	type: 'images';
	frames: string[];
	width: number;
	height: number;
}

type Media = VideoMedia | ImageSequenceMedia;

// Single format (webp — near-universal support at this point, same
// reasoning as Also Shipped's fallback tier) rather than the full
// avif/webp/fallback triad used there: this is a lightweight hover
// flip through a few frames, not primary content worth a lightbox, so
// one well-compressed format per frame is a reasonable simplification.
async function imageSequence(images: ImageMetadata[]): Promise<ImageSequenceMedia> {
	const resolved = await Promise.all(images.map((image) => getImage({ src: image, format: 'webp' })));
	return { type: 'images', frames: resolved.map((r) => r.src), width: images[0].width, height: images[0].height };
}

async function video(name: string, poster: ImageMetadata): Promise<VideoMedia> {
	const resolvedPoster = await getImage({ src: poster, format: 'webp' });
	return { type: 'video', mp4: `/video/off-the-clock/${name}.mp4`, webm: `/video/off-the-clock/${name}.webm`, poster: resolvedPoster.src };
}

// Clockwise from top-right — also the mobile swipe order and the
// desktop z-index resting order (lowest to highest).
interface Item {
	id: string;
	caption: string;
	x: number; // desktop center position, % of .otc-stack
	y: number;
	rot: number; // degrees
	media: Media;
}

const items: Item[] = [
	{
		id: 'type',
		caption: 'Æ, a display face, and Qoph, a serif',
		x: 21,
		y: 65,
		rot: -7,
		media: await imageSequence([ae1, ae2, ae3, qoph1, qoph2, qoph3]),
	},
	{
		id: 'charcoal',
		caption: 'Charcoal & Ink drawings',
		x: 75,
		y: 49,
		rot: -6,
		media: await video('charcoal-ink', charcoalPoster),
	},
	{
		id: 'pottery',
		caption: 'Recent pottery',
		x: 55,
		y: 83,
		rot: -4,
		media: await imageSequence([pottery1, pottery2, pottery3]),
	},
	{
		id: 'thesis',
		caption: 'Senior Thesis exhibition catalogue and branding',
		x: 58,
		y: 19,
		rot: -5,
		media: await imageSequence([thesis1, thesis2, thesis3, thesis4, thesis5]),
	},
	{
		id: 'raycat',
		caption: 'Branding and vtuber design for a Twitch streamer',
		x: 24,
		y: 30,
		rot: 5,
		media: await video('raycat', raycatPoster),
	},
];
---

<section class="off-the-clock">
	<div class="container">
		<h2 class="type-h1">Off the clock.</h2>
		<p class="type-h3 off-the-clock__subhead">
			A typeface, a Twitch cat, some pottery. Not everything needs a business case.
		</p>

		<div class="otc-stack" role="group" aria-label="Personal projects">
			{items.map((item, i) => (
				<div
					class="otc-item"
					data-index={i}
					style={`--x:${item.x}%; --y:${item.y}%; --rot:${item.rot}deg; --z:${i + 1};`}
				>
					<div class="otc-well">
						{item.media.type === 'video' ? (
							<video
								class="otc-media"
								muted
								loop
								playsinline
								preload="none"
								data-poster={item.media.poster}
								data-mp4={item.media.mp4}
								data-webm={item.media.webm}
							/>
						) : (
							<div class="otc-media otc-sequence">
								<div class="otc-sequence__track">
									{item.media.frames.map((frame, frameIndex) => (
										<img
											class="otc-sequence__frame"
											data-src={frame}
											data-frame-index={frameIndex}
											alt=""
											width={item.media.width}
											height={item.media.height}
										/>
									))}
									{/* A trailing clone of frame 0 — sliding onto it at
									   the end of the cycle looks identical to actually
									   reaching frame 0, so the loop-back can be an
									   invisible instant snap rather than a jump backward
									   through every frame. Rendered here in the template,
									   not cloned at runtime, so it needs none of the
									   scoped-CSS workarounds the carousel's own runtime
									   phantom clones do. */}
									<img
										class="otc-sequence__frame"
										data-src={item.media.frames[0]}
										aria-hidden="true"
										alt=""
										width={item.media.width}
										height={item.media.height}
									/>
								</div>
							</div>
						)}
					</div>
					<div class="otc-caption">
						<p class="type-body otc-caption__text">{item.caption}</p>
						{item.media.type === 'images' && (
							<div class="otc-dots" aria-hidden="true">
								{item.media.frames.map((_, frameIndex) => (
									<span class="otc-dot" data-dot-index={frameIndex} data-active={frameIndex === 0 ? 'true' : undefined} />
								))}
							</div>
						)}
					</div>
				</div>
			))}
		</div>

		<p class="type-body otc-caption-mobile" aria-live="polite">{items[0].caption}</p>
		<div class="otc-dots otc-dots-mobile" id="otc-dots-mobile" aria-hidden="true"></div>
	</div>

	<style>
		.off-the-clock__subhead {
			margin-block-start: var(--space-s);
		}

		.otc-stack {
			position: relative;
			width: 100%;
			aspect-ratio: 5 / 4;
			margin-block-start: var(--space-l);
		}

		.otc-caption-mobile {
			display: none;
		}

		/* Desktop-hidden by default, same as .otc-caption-mobile — shown
		   only inside the mobile breakpoint below. Reuses .otc-dots/
		   .otc-dot wholesale (styled further up) rather than a parallel
		   set of rules, since the visual is identical to the per-well
		   desktop version; only its position (below the shared mobile
		   caption, not inside a per-well chip) and how it's populated
		   (JS-built per the current front card, not one static row per
		   item) differ. */
		.otc-dots-mobile {
			display: none;
		}

		/* `.otc-dots` sets `display: flex` and the browser's default
		   `[hidden] { display: none }` rule ties with it on specificity
		   (one class, one attribute selector) — without this, author CSS
		   silently wins the tie and toggling `hidden` in JS (done for a
		   video-well front card, which has no frames to count) stops
		   actually hiding the row. Bit us once already on the nav icon
		   for the same reason. */
		.otc-dots-mobile[hidden] {
			display: none;
		}

		.otc-item {
			position: absolute;
			top: var(--y);
			left: var(--x);
			width: 36%;
			transform: translate(-50%, -50%) rotate(var(--rot));
			z-index: var(--z);
		}

		.otc-well {
			position: relative;
			aspect-ratio: 4 / 3;
			border-radius: var(--radius-well);
			background: var(--color-neutral);
			box-shadow: 0 4px 5px oklch(from var(--color-ink) l c h / 0.08);
			overflow: hidden;
			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease,
				opacity 0.25s ease,
				filter 0.25s ease;
		}

		.otc-media {
			position: absolute;
			inset: 0;
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			/* Browsers make img/video natively draggable by default,
			   which fights the mobile toss gesture's own pointer capture
			   — same fix already applied to Also Shipped's carousel
			   media. */
			-webkit-user-drag: none;
			user-select: none;
		}

		.otc-sequence {
			overflow: hidden;
		}

		.otc-sequence__track {
			display: flex;
			width: 100%;
			height: 100%;
			/* transform (and its transition) are driven entirely by JS —
			   see wireImageSequenceWell — since the hold/slide timing is
			   automatic rather than tied to any CSS-only trigger. */
		}

		.otc-sequence__frame {
			flex: 0 0 100%;
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			-webkit-user-drag: none;
			user-select: none;
		}

		/* Centers the caption chip below (text-align on an inline-block
		   child doesn't center the child itself) without affecting
		   .otc-well, which doesn't care about its ancestor's text-align. */
		.otc-item {
			text-align: center;
		}

		/* A quiet, static frame-count indicator for image-sequence wells
		   only — there's no equivalent affordance for those the way
		   video wells get a play/pause button, so without this a
		   scattered photo well looks identical at rest to one that's
		   actually a sequence. Lives inside the caption chip itself,
		   right under the text — sitting outside it, against whatever
		   the well/page happened to show underneath, read as too low-
		   contrast to register as intentional. No opacity/transition of
		   its own: it's inside .otc-caption now, so that chip's own
		   fade governs it along with the text. Doesn't track which
		   frame is currently showing beyond the active-dot width below
		   — no need for anything heavier for a cue that only needs to
		   say "there's more than one, and here's roughly where". */
		.otc-dots {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: var(--space-2xs);
			/* Deliberately tighter than the space scale allows — right
			   under the caption text, not a normal content gap. */
			margin-block-start: 4px;
		}

		.otc-dot {
			display: block;
			width: 6px;
			height: 6px;
			border-radius: var(--radius-pill);
			background: var(--color-line);
			/* Close to SLIDE_MS below (the image scrub's own transition
			   duration) so the dot widens roughly in step with the
			   slide, but a little quicker — matching it exactly read as
			   sluggish. */
			transition: width 700ms ease-in-out;
		}

		/* Same "current one widens into a pill" treatment as the What I
		   Do nav-pill and Also Shipped's carousel dots — color stays
		   the same here, though, since this is just tracking along with
		   the scrub, not something to navigate by. */
		.otc-dot[data-active='true'] {
			width: 18px;
		}

		.otc-caption {
			/* Without this, the caption loses the paint-order fight to
			   .otc-well on hover: a `transform` (even with position:
			   static) promotes an element into the "positioned" paint
			   category, which always paints above plain in-flow content
			   regardless of DOM order — so once the well transforms on
			   hover, it jumped above the caption after it despite coming
			   first. Giving the caption the same promotion puts them
			   back on equal footing, where DOM order (caption after
			   well) correctly wins. */
			position: relative;
			display: inline-block;
			margin-block-start: var(--space-s);
			padding: var(--space-2xs) var(--space-s);
			border-radius: var(--radius-well);
			/* An opaque chip, not a stroke/shadow on bare text — these
			   wells scatter and overlap, so a caption can land over a
			   neighboring well's own busy photo content behind it. A
			   solid surface reads reliably regardless of what's under
			   it; a stroke only helps against some of the colors a photo
			   can actually contain. */
			background: var(--color-bg);
			box-shadow: 0 4px 12px oklch(from var(--color-ink) l c h / 0.12);
			text-align: center;
			opacity: 0;
			transition: opacity 0.2s ease;
		}

		.otc-caption__text {
			white-space: nowrap;
		}

		/* Hovering a well lifts it toward the viewer and reveals its
		   caption — momentary, reverts on mouseleave. Only the z-index
		   (set via JS below) is sticky, so the last-hovered well stays
		   visually on top of the pile even after the mouse moves away,
		   the way picking up and setting down a photo leaves it on top
		   of the stack. */
		.otc-item:hover .otc-well {
			transform: translateY(-14px) scale(1.05);
			box-shadow: 0 20px 32px oklch(from var(--color-ink) l c h / 0.18);
		}

		.otc-item:hover .otc-caption {
			opacity: 1;
		}

		/* Every well but the hovered one softens behind it. */
		.otc-stack:has(.otc-item:hover) .otc-item:not(:hover) .otc-well {
			filter: blur(2px);
		}

		@media (max-width: 768px) {
			.otc-stack {
				aspect-ratio: 4 / 3;
				max-width: min(78vw, 340px);
				margin-inline: auto;
				/* Swipe drives its own horizontal gesture; vertical page
				   scroll stays completely native — the browser handles
				   that split itself, no JS needs to guess or intervene. */
				touch-action: pan-y;
			}

			.otc-item {
				top: 50%;
				left: 50%;
				width: 100%;
				/* Desktop's scattered --x/--y/--rot are replaced by the
				   rank-based stack values the swipe script maintains. */
				transform: translate(-50%, -50%) translateY(var(--stack-offset-y, 0px))
					rotate(var(--stack-rot, 0deg)) scale(var(--stack-scale, 1));
				opacity: var(--stack-opacity, 1);
				z-index: var(--stack-z, var(--z));
				transition:
					transform 0.35s ease,
					opacity 0.35s ease;
			}

			/* No hover on touch — the well never lifts/dims on its own. */
			.otc-item:hover .otc-well {
				transform: none;
				box-shadow: 0 4px 5px oklch(from var(--color-ink) l c h / 0.08);
			}

			.otc-stack:has(.otc-item:hover) .otc-item:not(:hover) .otc-well {
				opacity: 1;
				filter: none;
			}

			.otc-item .otc-caption {
				/* .otc-dots lives inside .otc-caption now, so hiding the
				   chip hides the dots along with it — nothing extra to
				   target here. */
				display: none;
			}

			.otc-caption-mobile {
				display: block;
				margin-block-start: var(--space-l);
				text-align: center;
				transition: opacity 0.18s ease;
			}

			.otc-dots-mobile {
				display: flex;
				margin-block-start: var(--space-2xs);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.otc-well {
				transition:
					opacity 0.2s ease,
					filter 0.2s ease;
			}

			.otc-item:hover .otc-well {
				transform: none;
			}

			.otc-dot {
				transition: none;
			}
		}
	</style>

	<script>
		import { wireImageLazyLoad } from '../scripts/lazyMedia';

		const stack = document.querySelector<HTMLElement>('.otc-stack');
		const items = stack ? [...stack.querySelectorAll<HTMLElement>('.otc-item')] : [];
		const mobileCaption = document.querySelector<HTMLElement>('.otc-caption-mobile');
		const mobileDots = document.querySelector<HTMLElement>('#otc-dots-mobile');
		const captionsByIndex = items.map(
			(item) => item.querySelector<HTMLElement>('.otc-caption')?.textContent ?? '',
		);

		// Which item is currently the mobile "front" card — declared up
		// here (not inside the mobile drag setup below) so the
		// image-sequence controllers built next can read it live via
		// closure, the same way the desktop dots already track their own
		// item's frame.
		let order = items.map((_, i) => i);

		// Rebuilds the dot row for whichever item is now front: a plain
		// static row when it's a video well (nothing to count), one dot
		// per real frame — reusing the exact .otc-dot markup/CSS the
		// desktop per-well version uses — when it's an image sequence.
		// Rebuilt on every toss rather than kept as one fixed-length row,
		// since different items have different frame counts (type: 6,
		// pottery: 3, thesis: 5, ...).
		function renderMobileDots(itemIndex: number) {
			if (!mobileDots) return;
			const sequenceEl = items[itemIndex]?.querySelector<HTMLElement>('.otc-sequence');
			if (!sequenceEl) {
				mobileDots.replaceChildren();
				mobileDots.hidden = true;
				return;
			}
			const frameCount = sequenceEl.querySelectorAll('.otc-sequence__frame').length;
			const realFrameCount = frameCount - 1; // excludes the trailing loop-back clone
			mobileDots.hidden = false;
			const frag = document.createDocumentFragment();
			for (let i = 0; i < realFrameCount; i += 1) {
				const dot = document.createElement('span');
				dot.className = 'otc-dot';
				if (i === 0) dot.dataset.active = 'true';
				frag.appendChild(dot);
			}
			mobileDots.replaceChildren(frag);
		}

		function setMobileActiveDot(i: number) {
			if (!mobileDots) return;
			[...mobileDots.children].forEach((dot, dotIndex) => {
				(dot as HTMLElement).dataset.active = String(dotIndex === i);
			});
		}

		const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		const mobileQuery = window.matchMedia('(max-width: 768px)');

		// --- Per-well media: video hover-plays (desktop) or plays
		// whenever it's the front card (mobile, no hover to trigger it);
		// an image sequence "scrubs" the same way — a flat, instant swap
		// between pre-loaded frames every 2s, no crossfade. Both reset to
		// their resting frame (poster / first image) when they stop, and
		// neither ever autoplays under reduced motion.
		interface MediaController {
			play(): void;
			stop(): void;
		}

		function wireVideoWell(video: HTMLVideoElement): MediaController {
			function ensureLoaded() {
				if (video.dataset.loaded) return;
				const webm = video.dataset.webm;
				const mp4 = video.dataset.mp4;
				if (webm) {
					const source = document.createElement('source');
					source.src = webm;
					source.type = 'video/webm';
					video.appendChild(source);
				}
				if (mp4) {
					const source = document.createElement('source');
					source.src = mp4;
					source.type = 'video/mp4';
					video.appendChild(source);
				}
				video.load();
				video.dataset.loaded = 'true';
			}

			return {
				play() {
					if (reduceMotionQuery.matches) return;
					ensureLoaded();
					video.play().catch(() => {});
				},
				stop() {
					video.pause();
					video.currentTime = 0;
				},
			};
		}

		// Eased slide-left, not a flat cut: hold 1.8s, then a 1s eased
		// transform to the next frame, repeating. The track includes one
		// extra trailing frame — a clone of frame 0 (rendered directly in
		// the template) — so sliding onto "one past the last real frame"
		// looks identical to reaching frame 0 again; a `generation`
		// counter lets any timer that was scheduled before a stop()/play()
		// recognize it's stale and bail out, rather than tracking and
		// cancelling two separately-timed setTimeouts by hand.
		function wireImageSequenceWell(item: HTMLElement, onFrame?: (i: number) => void): MediaController {
			const sequenceEl = item.querySelector<HTMLElement>('.otc-sequence')!;
			const track = sequenceEl.querySelector<HTMLElement>('.otc-sequence__track');
			const frameCount = sequenceEl.querySelectorAll('.otc-sequence__frame').length;
			const realFrameCount = frameCount - 1; // excludes the trailing clone
			const dots = [...item.querySelectorAll<HTMLElement>('.otc-dot')];

			const HOLD_MS = 1800;
			const SLIDE_MS = 1000;

			let index = 0;
			let generation = 0;
			let outerTimer: ReturnType<typeof setTimeout> | null = null;
			let innerTimer: ReturnType<typeof setTimeout> | null = null;

			// Mirrors the "current one widens into a pill" dot treatment
			// from What I Do's nav-pill and Also Shipped's carousel — just
			// tracking here, not a nav control, so no click handlers.
			function setActiveDot(i: number) {
				dots.forEach((dot, dotIndex) => {
					dot.dataset.active = String(dotIndex === i);
				});
				onFrame?.(i);
			}

			function goToInstant(i: number) {
				if (!track) return;
				track.style.transition = 'none';
				track.style.transform = `translateX(-${i * 100}%)`;
				track.getBoundingClientRect(); // force reflow before any later transitioned change
			}

			function clearTimers() {
				if (outerTimer !== null) {
					clearTimeout(outerTimer);
					outerTimer = null;
				}
				if (innerTimer !== null) {
					clearTimeout(innerTimer);
					innerTimer = null;
				}
			}

			function scheduleNext(myGeneration: number) {
				outerTimer = window.setTimeout(() => {
					if (myGeneration !== generation || !track) return;
					index += 1;
					setActiveDot(index);
					track.style.transition = `transform ${SLIDE_MS}ms ease`;
					track.style.transform = `translateX(-${index * 100}%)`;

					innerTimer = window.setTimeout(() => {
						if (myGeneration !== generation) return;
						if (index >= realFrameCount) {
							index = 0;
							setActiveDot(0);
							goToInstant(0);
						}
						scheduleNext(myGeneration);
					}, SLIDE_MS);
				}, HOLD_MS);
			}

			return {
				play() {
					if (reduceMotionQuery.matches || realFrameCount <= 1 || outerTimer !== null || innerTimer !== null) return;
					generation += 1;
					scheduleNext(generation);
				},
				stop() {
					generation += 1;
					clearTimers();
					index = 0;
					setActiveDot(0);
					goToInstant(0);
				},
			};
		}

		const mediaControllers: MediaController[] = items.map((item, i) => {
			const video = item.querySelector<HTMLVideoElement>('video.otc-media');
			if (video) return wireVideoWell(video);
			// Only mirror this item's frame into the mobile dot row while
			// it's actually the front card — a background well scrubbing
			// off in the pile (desktop hover-play, if ever added there
			// too) shouldn't steal the row out from under whatever's
			// currently shown.
			return wireImageSequenceWell(item, (frameIndex) => {
				if (order[0] === i) setMobileActiveDot(frameIndex);
			});
		});

		if (stack) wireImageLazyLoad(stack);

		if (stack && items.length > 0) {
			// Desktop: hovering a well promotes it above everything
			// hovered so far — a monotonic counter, never reset, is what
			// makes the promotion stick after the mouse leaves.
			let topCounter = items.length;
			items.forEach((item, i) => {
				item.addEventListener('mouseenter', () => {
					topCounter += 1;
					item.style.setProperty('--z', String(topCounter));
					if (!mobileQuery.matches) mediaControllers[i].play();
				});
				item.addEventListener('mouseleave', () => {
					if (!mobileQuery.matches) mediaControllers[i].stop();
				});
			});

			// Mobile: dragging the front well (either direction) tracks
			// the finger in real time, like picking the card up — past a
			// distance threshold at release it's tossed to the back of
			// the deck and the next well is revealed; short of that, it
			// springs back to rest. Loops back to the first after the
			// last. (`order` itself is declared further up, alongside the
			// media controllers that read it.)
			renderMobileDots(order[0]);
			if (mobileQuery.matches) mediaControllers[order[0]].play();

			const RANKS = [
				{ offsetY: 0, rot: 0, scale: 1, opacity: 1 },
				{ offsetY: 10, rot: -3, scale: 0.96, opacity: 1 },
				{ offsetY: 18, rot: 4, scale: 0.93, opacity: 1 },
				{ offsetY: 22, rot: -2, scale: 0.9, opacity: 0 },
				{ offsetY: 22, rot: 2, scale: 0.9, opacity: 0 },
			];

			// Once tossed, the card continues drifting slowly and calmly
			// (long transform duration) but visually disappears much
			// sooner (short opacity duration) — it reads as "gone" well
			// before its flight finishes, which is what actually sells
			// the motion rather than a fast, jarring exit.
			const FLY_MS = 600;
			const FADE_MS = 200;
			const CAPTION_FADE_MS = 160;
			const SPRING_MS = 260;
			// Distance to drag before release commits to a toss instead
			// of springing back.
			const COMMIT_THRESHOLD = 90;
			// How far the card rotates per pixel dragged, like it's
			// pivoting in a hand — capped so a long drag doesn't spin it
			// past a natural angle.
			const DRAG_ROTATION_PER_PX = 0.06;
			const DRAG_ROTATION_MAX = 18;

			function layoutMobile(skipIndex?: number) {
				order.forEach((itemIndex, rank) => {
					if (itemIndex === skipIndex) return;
					const item = items[itemIndex];
					const style = RANKS[rank] ?? RANKS[RANKS.length - 1];
					item.style.setProperty('--stack-offset-y', `${style.offsetY}px`);
					item.style.setProperty('--stack-rot', `${style.rot}deg`);
					item.style.setProperty('--stack-scale', String(style.scale));
					item.style.setProperty('--stack-opacity', String(style.opacity));
					item.style.setProperty('--stack-z', String(RANKS.length - rank));
				});
			}

			function setCaption(text: string, animate: boolean) {
				if (!mobileCaption) return;
				if (!animate) {
					mobileCaption.textContent = text;
					return;
				}
				mobileCaption.style.opacity = '0';
				window.setTimeout(() => {
					mobileCaption.textContent = text;
					mobileCaption.style.opacity = '1';
				}, CAPTION_FADE_MS);
			}

			function clamp(value: number, min: number, max: number) {
				return Math.max(min, Math.min(max, value));
			}

			layoutMobile();

			let drag: { pointerId: number; startX: number; startY: number; itemIndex: number } | null =
				null;

			function completeToss(item: HTMLElement, dir: number) {
				const frontIndex = order[0];
				mediaControllers[frontIndex].stop();
				// Reorder right away so the other cards promote into
				// place immediately, in parallel with the tossed card's
				// own independent flight continuing out from wherever
				// the drag released it — rather than waiting for that
				// flight to finish before the next card visibly rises.
				order = [...order.slice(1), frontIndex];
				layoutMobile(frontIndex);
				setCaption(captionsByIndex[order[0]], true);
				renderMobileDots(order[0]);
				mediaControllers[order[0]].play();

				item.style.transition = `transform ${FLY_MS}ms ease-out, opacity ${FADE_MS}ms ease-out`;
				item.style.transform = `translate(-50%, -50%) translateX(${dir * 120}%) rotate(${dir * 8}deg)`;
				item.style.opacity = '0';

				window.setTimeout(() => {
					item.style.transition = '';
					item.style.transform = '';
					item.style.opacity = '';
					// Now safe to fold it into the shared rank system at
					// its new (back) position — it's already invisible.
					layoutMobile();
				}, FLY_MS);
			}

			function springBack(item: HTMLElement) {
				item.style.transition = `transform ${SPRING_MS}ms ease-out, opacity ${SPRING_MS}ms ease-out`;
				item.style.transform = 'translate(-50%, -50%)';
				item.style.opacity = '1';
				window.setTimeout(() => {
					item.style.transition = '';
					item.style.transform = '';
					item.style.opacity = '';
				}, SPRING_MS);
			}

			stack.addEventListener('pointerdown', (e) => {
				if (!mobileQuery.matches || drag) return;
				const itemIndex = order[0];
				const item = items[itemIndex];
				drag = { pointerId: e.pointerId, startX: e.clientX, startY: e.clientY, itemIndex };
				// No transition while actively dragging — it needs to
				// track the finger 1:1, not ease toward it.
				item.style.transition = 'none';
				stack.setPointerCapture(e.pointerId);
			});

			stack.addEventListener('pointermove', (e) => {
				if (!drag || e.pointerId !== drag.pointerId) return;
				const item = items[drag.itemIndex];
				const dx = e.clientX - drag.startX;
				const dy = e.clientY - drag.startY;
				const rot = clamp(dx * DRAG_ROTATION_PER_PX, -DRAG_ROTATION_MAX, DRAG_ROTATION_MAX);
				item.style.transform = `translate(-50%, -50%) translate(${dx}px, ${dy * 0.15}px) rotate(${rot}deg)`;
				// Fades partway as it nears the commit threshold — the
				// rest of the fade happens on the toss itself — so
				// letting go early already reads as "this is about to
				// leave" before it actually commits.
				const progress = clamp(Math.abs(dx) / COMMIT_THRESHOLD, 0, 1);
				item.style.opacity = String(1 - progress * 0.4);
			});

			function endDrag(e: PointerEvent) {
				if (!drag || e.pointerId !== drag.pointerId) return;
				const item = items[drag.itemIndex];
				const dx = e.clientX - drag.startX;

				if (reduceMotionQuery.matches) {
					drag = null;
					if (Math.abs(dx) > COMMIT_THRESHOLD) {
						const frontIndex = order[0];
						mediaControllers[frontIndex].stop();
						order = [...order.slice(1), order[0]];
						layoutMobile();
						setCaption(captionsByIndex[order[0]], false);
						renderMobileDots(order[0]);
						mediaControllers[order[0]].play();
					} else {
						item.style.transition = '';
						item.style.transform = '';
						item.style.opacity = '';
					}
					return;
				}

				if (Math.abs(dx) > COMMIT_THRESHOLD) {
					completeToss(item, dx > 0 ? 1 : -1);
				} else {
					springBack(item);
				}
				drag = null;
			}

			stack.addEventListener('pointerup', endDrag);

			// A cancel (the browser taking over for a scroll, etc.) always
			// springs back — its coordinates aren't reliable enough to
			// run through the same commit-threshold check as a real
			// release.
			stack.addEventListener('pointercancel', (e) => {
				if (!drag || e.pointerId !== drag.pointerId) return;
				const item = items[drag.itemIndex];
				drag = null;
				if (reduceMotionQuery.matches) {
					item.style.transition = '';
					item.style.transform = '';
					item.style.opacity = '';
					return;
				}
				springBack(item);
			});
		}
	</script>
</section>
