---
import { Image, getImage } from 'astro:assets';
import koto from '../assets/work/so-rebrand/direction/london-1.jpg';
import nashville from '../assets/work/so-rebrand/systems/systems-8-1.jpg';
import somu from '../assets/work/also-shipped/somu23/somu-6.jpg';
import ae from '../assets/work/off-the-clock/type/ae-1.png';
import mascotPoster from '../assets/work/so-rebrand/posters/systems-6-2-poster.jpg';
import rolloutPoster from '../assets/work/so-rebrand/posters/rollout-3-1-poster.jpg';
import charcoalPoster from '../assets/work/off-the-clock/charcoal-Ink/posters/charcoal-ink-poster.jpg';
import freedPoster from '../assets/work/what-i-do/posters/motion-freed-poster.jpg';
import raycatPoster from '../assets/work/off-the-clock/raycat/posters/raycat-poster.jpg';
import oai1Poster from '../assets/work/also-shipped/overflow-ai/posters/oai-1-poster.jpg';
import oai5Poster from '../assets/work/also-shipped/overflow-ai/posters/oai-5-poster.jpg';
import somu4Poster from '../assets/work/also-shipped/somu23/posters/somu-4-poster.jpg';
import logoStack from '../assets/logos/Logo_Stack.svg';
import logoKoto from '../assets/logos/Logo_Koto.svg';
import logoFreed from '../assets/logos/Logo_Freed.svg';
import logoTulip from '../assets/logos/Logo_Tulip.svg';
import logoUpstatement from '../assets/logos/Logo_Upstatement.svg';
import logoPega from '../assets/logos/Logo_Pega.svg';

// Re-exported with optically centered bounding boxes, so a single
// shared height is all that's needed — no per-mark adjustment.
const LOGO_HEIGHT = 50;
const logos = [
	{ src: logoStack, alt: 'Stack Overflow' },
	{ src: logoKoto, alt: 'Koto' },
	{ src: logoFreed, alt: 'Freed' },
	{ src: logoTulip, alt: 'Tulip' },
	{ src: logoUpstatement, alt: 'Upstatement' },
	// Pega's mark is duotone (two distinct gray fills for its two wings) —
	// brightness(0) crushes any opaque color to pure black regardless of
	// original luminance, flattening that distinction. Grayscale instead,
	// which maps by luminance and keeps the two tones apart.
	{ src: logoPega, alt: 'Pegasystems', duotone: true },
];

// The ring of work orbiting the hero text, pulled from elsewhere on the
// site. Order alternates shapes and photo/graphic/video so neighbors
// never look alike. Images are ~2x their largest on-screen size (the
// focused, front-most slot).
const webp = (src: ImageMetadata) => getImage({ src, format: 'webp', width: 900, quality: 80 });
const [kotoImg, nashvilleImg, somuImg, aeImg, mascotImg, rolloutImg, charcoalImg, freedImg, raycatImg, oai1Img, oai5Img, somu4Img] =
	await Promise.all(
		[koto, nashville, somu, ae, mascotPoster, rolloutPoster, charcoalPoster, freedPoster, raycatPoster, oai1Poster, oai5Poster, somu4Poster].map(webp),
	);

const clip = (poster: string, path: string, ratio: number): RingItem => ({
	kind: 'video',
	poster,
	mp4: `/video/${path}.mp4`,
	webm: `/video/${path}.webm`,
	ratio,
});

type RingItem =
	| { kind: 'image'; src: string; ratio: number }
	| { kind: 'video'; poster: string; mp4: string; webm: string; ratio: number };

const ring: RingItem[] = [
	{ kind: 'image', src: kotoImg.src, ratio: 1 },
	clip(rolloutImg.src, 'so-rebrand/rollout-3-1', 16 / 9),
	clip(raycatImg.src, 'off-the-clock/raycat', 4 / 3),
	{ kind: 'image', src: aeImg.src, ratio: 4 / 3 },
	clip(oai1Img.src, 'also-shipped/overflow-ai/oai-1', 16 / 9),
	clip(mascotImg.src, 'so-rebrand/systems-6-2-2', 1),
	{ kind: 'image', src: somuImg.src, ratio: 16 / 9 },
	clip(freedImg.src, 'what-i-do/motion-freed', 16 / 9),
	clip(charcoalImg.src, 'off-the-clock/charcoal-ink', 4 / 3),
	clip(oai5Img.src, 'also-shipped/overflow-ai/oai-5', 16 / 9),
	{ kind: 'image', src: nashvilleImg.src, ratio: 1 },
	clip(somu4Img.src, 'also-shipped/somu23/somu-4', 16 / 9),
];
---

<section class="hero">
	<div class="hero__stage">
		<div class="hero__ring" aria-hidden="true">
			{ring.map((item) => (
				<div class="hero__ring-item" style={`--ratio:${item.ratio};`}>
					{item.kind === 'image' ? (
						<img src={item.src} alt="" decoding="async" />
					) : (
						<video muted loop playsinline preload="none" poster={item.poster}>
							<source src={item.webm} type="video/webm" />
							<source src={item.mp4} type="video/mp4" />
						</video>
					)}
				</div>
			))}
		</div>
		<div class="container hero__text">
			<h1 class="type-display hero__headline">Brand design, built and run from the inside.</h1>
			<p class="type-h3 hero__subhead">
				Motion, systems, and strategy, most recently Stack Overflow's rebrand with Koto, from
				first workshops to full rollout.
			</p>
			<div class="hero__actions">
				<a href="/about" class="button type-caption">Get in touch</a>
				<a
					href="/jake-rochford-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="button button--secondary type-caption"
				>
					Resume
				</a>
			</div>
		</div>
	</div>
	<div class="container hero__clients">
		<p class="type-caption hero__clients-label">Working in good company</p>
		<div class="hero__logos">
			{logos.map((logo) => (
				<Image
					src={logo.src}
					alt={logo.alt}
					height={LOGO_HEIGHT}
					class={`hero__logo ${logo.duotone ? 'hero__logo--duotone' : ''}`}
				/>
			))}
		</div>
	</div>

	<style>
	.hero {
		/* Exempt from the standard section gap — it's a viewport-height
		   composition with its own internal rhythm. */
		min-height: calc(100svh - var(--nav-height, 0px));
		display: flex;
		flex-direction: column;
		/* The ring runs past both viewport edges on purpose; clip (not
		   hidden) so it can't create a horizontal scrollbar without also
		   turning the hero into a scroll container. */
		overflow-x: clip;
	}

	.hero__stage {
		position: relative;
		flex: 1;
		display: grid;
		/* Text sits high, not centered, leaving the lower part of the
		   stage for the front of the ring to come to rest in. */
		place-items: start center;
		min-height: 560px;
		padding-block-start: clamp(var(--space-m), 4vh, 56px);
		/* Base item height — the script overrides it so the focused item
		   fills the space between the buttons and the logos. */
		--item-h: clamp(120px, 21vh, 230px);
	}

	.hero__ring {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* Positioned by the script (a hand-rolled perspective projection, not
	   CSS 3D) so depth can drive blur and stacking order directly. */
	.hero__ring-item {
		position: absolute;
		left: 50%;
		top: 50%;
		height: var(--item-h);
		aspect-ratio: var(--ratio);
		translate: -50% -50%;
		border-radius: var(--radius-well);
		overflow: hidden;
		background: var(--color-neutral);
		will-change: transform, filter;
	}

	.hero__ring-item img,
	.hero__ring-item video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* No z-index of its own — that would make it a stacking context and
	   trap the buttons' z-index below. Its children layer individually
	   against the ring items instead (the script's range is 100–900). */
	.hero__text {
		position: relative;
		isolation: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		pointer-events: none;
	}

	/* The buttons always sit above the ring, even when a front item
	   passes behind them, so they stay visible and clickable. */
	.hero__actions {
		position: relative;
		z-index: 1000;
		pointer-events: auto;
	}

	/* Above back-of-ring items, below the focused front ones. */
	.hero__headline,
	.hero__subhead {
		position: relative;
		z-index: 700;
	}

	/* A soft wash of the page color behind the headline and subhead, so
	   they stay readable over the busy, blurred back of the ring without
	   a hard box around them. Same layer as the text, painted first. */
	.hero__text::before {
		content: '';
		position: absolute;
		z-index: 699;
		inset: -8% -12% 22%;
		background: radial-gradient(closest-side, var(--color-bg) 55%, transparent);
		pointer-events: none;
	}

	.hero__headline {
		/* Narrower than the container so it reliably wraps to
		   "Brand design, built and run" / "from the inside." */
		max-width: 900px;
	}

	.hero__subhead {
		max-width: 60ch;
		margin-block-start: var(--space-s);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-xs);
		margin-block-start: var(--space-m);
	}

	.hero__clients {
		width: 100%;
		text-align: center;
		padding-block-end: var(--space-m);
	}

	.hero__clients-label {
		color: var(--color-ink-muted);
		margin-block-end: var(--space-xs);
	}

	.hero__logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-s);
	}

	.hero__logo {
		display: block;
		width: auto;
		/* Monochrome regardless of each source SVG's own colors. */
		filter: brightness(0) opacity(0.45);
	}

	.hero__logo--duotone {
		/* brightness(0) crushes every opaque fill to identical pure
		   black, which erases a duotone mark's two distinct grays.
		   grayscale() maps by luminance instead, keeping them apart. */
		filter: grayscale(1) opacity(0.45);
	}

	@media (max-width: 768px) {
		.hero__stage {
			min-height: 520px;
			--item-h: clamp(90px, 15vh, 140px);
		}

		.hero__clients-label {
			/* Slightly more room than the desktop --space-xs gap before
			   the logo grid starts. */
			margin-block-end: var(--space-s);
		}

		.hero__logos {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			/* Equal-width columns/rows so each logo centers within its own
			   cell — column-wise vertically, row-wise horizontally —
			   rather than the pair just hugging together. */
			justify-items: center;
			align-items: center;
			row-gap: var(--space-s);
			column-gap: var(--space-2xs);
		}
	}
	</style>

	<script>
		import { gsap } from 'gsap';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const stage = document.querySelector<HTMLElement>('.hero__stage');
		const items = stage ? [...stage.querySelectorAll<HTMLElement>('.hero__ring-item')] : [];

		const TAU = Math.PI * 2;
		const STEP = TAU / items.length;
		// Seconds: the accelerate/decelerate halves of each spin (their
		// durations are tied so velocity is continuous at the handoff —
		// see spin()), then how long it rests on each new focus.
		const ACCEL = 0.8;
		const DECEL = ACCEL * 4.5;
		const HOLD = 2.2;

		// angle: the ring's rotation; item i sits at angle + i * STEP, and
		// whichever item is at 0 (mod TAU) is front and center.
		const state = { angle: 0 };
		let radius = 0;
		let tilt = 0;
		let centerY = 0;
		let perspective = 0;
		let maxBlur = 0;

		function measure() {
			if (!stage || !items.length) return;
			const w = stage.clientWidth;
			const h = stage.clientHeight;
			// Just under half the viewport: the sides graze the screen edges
			// and the items crowd together into a dense ring.
			radius = Math.max(w * 0.46, 340);
			perspective = radius * 4;
			const frontScale = perspective / (perspective - radius);
			const backScale = perspective / (perspective + radius);
			// Sized and placed from the real layout: the focused (front)
			// item fills the space between the buttons and the logo row,
			// centered in it, and the back of the ring lines up with the
			// headline behind the text.
			const mid = stage.getBoundingClientRect().top + h / 2;
			const headline = stage.querySelector('.hero__headline')!.getBoundingClientRect();
			const actions = stage.querySelector('.hero__actions')!.getBoundingClientRect();
			const clients = document.querySelector('.hero__clients')?.getBoundingClientRect();
			const floor = clients ? clients.top : mid + h / 2;
			const margin = Math.max(16, (floor - actions.bottom) * 0.06);
			const itemH = Math.max(140, (floor - actions.bottom - 2 * margin) / frontScale);
			stage.style.setProperty('--item-h', `${itemH.toFixed(1)}px`);
			const backY = headline.top + headline.height / 2 - mid;
			const frontY = (actions.bottom + floor) / 2 - mid;
			tilt = Math.max(0, (frontY - backY) / (frontScale + backScale));
			centerY = backY + tilt * backScale;
			maxBlur = 10;
		}

		function render() {
			items.forEach((el, i) => {
				const theta = state.angle + i * STEP;
				const x = radius * Math.sin(theta);
				const z = radius * Math.cos(theta);
				const scale = perspective / (perspective - z);
				const y = centerY / scale + tilt * Math.cos(theta);
				// 0 at the very front, 1 at the very back.
				const depth = (1 - z / radius) / 2;
				// Blur by angle from front rather than depth, so it ramps up
				// right away — even the immediate neighbors soften, leaving
				// the focused item as the one sharp thing.
				const fromFront = Math.abs(Math.atan2(Math.sin(theta), Math.cos(theta))) / (Math.PI / 2);
				const blur = Math.min(1, fromFront) ** 0.8 * maxBlur;
				el.style.transform = `translate3d(${(x * scale).toFixed(1)}px, ${(y * scale).toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
				el.style.filter = blur < 0.25 ? 'none' : `blur(${blur.toFixed(1)}px)`;
				el.style.zIndex = String(Math.round(500 + (z / radius) * 400));
				const video = el.querySelector('video');
				// Only the front half of the ring plays — the back is too
				// blurred to read, and eight clips decoding at once is a lot.
				if (video) setPlaying(video, inView && !reduceMotion && depth < 0.55);
			});
		}

		let inView = false;
		function setPlaying(video: HTMLVideoElement, play: boolean) {
			if (play === !video.paused) return;
			if (play) video.play().catch(() => {});
			else video.pause();
		}

		let focus = 0;
		let timeline: gsap.core.Timeline | null = null;
		let pending: gsap.core.Tween | null = null;

		// One cycle: speed up, whip around at least one full turn, then
		// coast to a stop with the next item in front. The accelerate leg
		// covers a quarter of the distance on power2.in; the long
		// power3.out tail covers the rest. Their end/start velocities
		// (2·d/t and 3·d/t) match when DECEL = 4.5 × ACCEL, so there's no
		// hitch at the handoff.
		function spin() {
			const next = (focus + 1) % items.length;
			const start = state.angle;
			let target = -next * STEP;
			while (start - target < TAU) target -= TAU;
			while (start - target >= 2 * TAU) target += TAU;
			const distance = target - start;
			timeline = gsap
				.timeline({
					onComplete: () => {
						focus = next;
						timeline = null;
						pending = gsap.delayedCall(HOLD, spin);
					},
				})
				.to(state, { angle: start + distance * 0.25, duration: ACCEL, ease: 'power2.in', onUpdate: render })
				.to(state, { angle: target, duration: DECEL, ease: 'power3.out', onUpdate: render });
		}

		if (stage && items.length) {
			measure();
			render();
			new ResizeObserver(() => {
				measure();
				render();
			}).observe(stage);

			if (!reduceMotion) {
				pending = gsap.delayedCall(HOLD, spin);
				// Nothing spins or plays while the hero is off-screen.
				new IntersectionObserver(
					([entry]) => {
						inView = entry.isIntersecting;
						timeline?.paused(!inView);
						pending?.paused(!inView);
						render();
					},
					{ threshold: 0.05 },
				).observe(stage);
			}
		}
	</script>
</section>
