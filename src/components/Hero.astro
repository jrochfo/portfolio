---
import { getImage } from 'astro:assets';
import koto from '../assets/work/so-rebrand/direction/london-1.jpg';
import nashville from '../assets/work/so-rebrand/systems/systems-8-1.jpg';
import ae1 from '../assets/work/off-the-clock/type/ae-1.png';
import ae2 from '../assets/work/off-the-clock/type/ae-2.png';
import ae3 from '../assets/work/off-the-clock/type/ae-3.png';
import qoph1 from '../assets/work/off-the-clock/type/qoph-1.png';
import qoph2 from '../assets/work/off-the-clock/type/qoph-2.png';
import qoph3 from '../assets/work/off-the-clock/type/qoph-3.png';
import mascotPoster from '../assets/work/so-rebrand/posters/systems-6-2-poster.jpg';
import rolloutPoster from '../assets/work/so-rebrand/posters/rollout-3-1-poster.jpg';
import trustLayerPoster from '../assets/work/so-rebrand/posters/rollout-3-2-poster.jpg';
import guidelinesPoster from '../assets/work/so-rebrand/posters/guidelines-scroll-poster.jpg';
import freedPoster from '../assets/work/what-i-do/posters/motion-freed-poster.jpg';
import raycatPoster from '../assets/work/off-the-clock/raycat/posters/raycat-poster.jpg';
import oai1Poster from '../assets/work/also-shipped/overflow-ai/posters/oai-1-poster.jpg';
import oai5Poster from '../assets/work/also-shipped/overflow-ai/posters/oai-5-poster.jpg';
import somu4Poster from '../assets/work/also-shipped/somu23/posters/somu-4-poster.jpg';
import logoStack from '../assets/logos/Logo_Stack.svg';
import logoKoto from '../assets/logos/Logo_Koto.svg';
import logoFreed from '../assets/logos/Logo_Freed.svg';
import logoTulip from '../assets/logos/Logo_Tulip.svg';
import logoUpstatement from '../assets/logos/Logo_Upstatement.svg';
import logoPega from '../assets/logos/Logo_Pega.svg';

// Re-exported with optically centered bounding boxes, so a single
// shared height is all that's needed — no per-mark adjustment.
const LOGO_HEIGHT = 50;
const logos = [
	{ src: logoStack, alt: 'Stack Overflow' },
	{ src: logoKoto, alt: 'Koto' },
	{ src: logoFreed, alt: 'Freed' },
	{ src: logoTulip, alt: 'Tulip' },
	{ src: logoUpstatement, alt: 'Upstatement' },
	// Pega's lighter wing is the same color at partial opacity in the
	// source SVG, so it stays distinct under the shared single-color
	// filter on any background.
	{ src: logoPega, alt: 'Pegasystems' },
];

// The ring of work orbiting the hero text, pulled from elsewhere on the
// site. Order alternates shapes and photo/graphic/video so neighbors
// never look alike. Images are ~2x their largest on-screen size (the
// focused, front-most slot).
const webp = (src: ImageMetadata) => getImage({ src, format: 'webp', width: 900, quality: 80 });
const [kotoImg, nashvilleImg, trustLayerImg, mascotImg, rolloutImg, guidelinesImg, freedImg, raycatImg, oai1Img, oai5Img, somu4Img] =
	await Promise.all(
		[koto, nashville, trustLayerPoster, mascotPoster, rolloutPoster, guidelinesPoster, freedPoster, raycatPoster, oai1Poster, oai5Poster, somu4Poster].map(webp),
	);
// The two typefaces, each sliding through its own frames the same way
// the Off the Clock card does.
const frames = async (images: ImageMetadata[]) => (await Promise.all(images.map(webp))).map((r) => r.src);
const [aeFrames, qophFrames] = await Promise.all([frames([ae1, ae2, ae3]), frames([qoph1, qoph2, qoph3])]);

const clip = (poster: string, path: string, ratio: number): RingItem => ({
	kind: 'video',
	poster,
	mp4: `/video/${path}.mp4`,
	webm: `/video/${path}.webm`,
	ratio,
});

type RingItem =
	| { kind: 'image'; src: string; ratio: number }
	| { kind: 'video'; poster: string; mp4: string; webm: string; ratio: number }
	| { kind: 'sequence'; frames: string[]; ratio: number };

const ring: RingItem[] = [
	{ kind: 'image', src: kotoImg.src, ratio: 1 },
	clip(rolloutImg.src, 'so-rebrand/rollout-3-1', 16 / 9),
	clip(raycatImg.src, 'off-the-clock/raycat', 4 / 3),
	{ kind: 'sequence', frames: aeFrames, ratio: 4 / 3 },
	clip(oai1Img.src, 'also-shipped/overflow-ai/oai-1', 16 / 9),
	clip(mascotImg.src, 'so-rebrand/systems-6-2-2', 1),
	clip(trustLayerImg.src, 'so-rebrand/rollout-3-2', 16 / 9),
	clip(freedImg.src, 'what-i-do/motion-freed', 16 / 9),
	{ kind: 'sequence', frames: qophFrames, ratio: 4 / 3 },
	clip(guidelinesImg.src, 'so-rebrand/guidelines-scroll', 16 / 9),
	clip(oai5Img.src, 'also-shipped/overflow-ai/oai-5', 16 / 9),
	{ kind: 'image', src: nashvilleImg.src, ratio: 1 },
	clip(somu4Img.src, 'also-shipped/somu23/somu-4', 16 / 9),
];
---

<section class="hero">
	<div class="hero__stage">
		<div class="hero__ring" aria-hidden="true" data-reveal="fade" style="--reveal-delay: 360ms">
			{ring.map((item) => (
				<div class="hero__ring-item" style={`--ratio:${item.ratio};`}>
					{item.kind === 'image' ? (
						<img src={item.src} alt="" decoding="async" />
					) : item.kind === 'sequence' ? (
						// A trailing copy of the first frame, so sliding past the
						// last one lands on something identical to the start.
						<div class="hero__sequence">
							{[...item.frames, item.frames[0]].map((src) => (
								<img src={src} alt="" decoding="async" />
							))}
						</div>
					) : (
						<video muted loop playsinline preload="none" poster={item.poster}>
							<source src={item.webm} type="video/webm" />
							<source src={item.mp4} type="video/mp4" />
						</video>
					)}
				</div>
			))}
		</div>
		<div class="container hero__text">
			<h1 class="type-display hero__headline" data-reveal style="--reveal-delay: 80ms">Hi, I’m Jake. <span class="hero__headline-line">I make brands move.</span></h1>
			<p class="type-h3 hero__subhead" data-reveal style="--reveal-delay: 160ms">
				Motion, systems, and strategy, most recently Stack Overflow's rebrand with Koto, from
				first workshops to full rollout.
			</p>
			<div class="hero__actions" data-reveal style="--reveal-delay: 240ms">
				<a href="/about" class="button type-caption">Get in touch</a>
				<a
					href="/jake-rochford-resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="button button--secondary type-caption"
				>
					Resume
				</a>
			</div>
		</div>
	</div>
	<div class="container hero__clients" data-reveal style="--reveal-delay: 440ms">
		<p class="type-caption hero__clients-label">Working in good company</p>
		<div class="hero__logos">
			{logos.map((logo) => (
				<span
					class="hero__logo"
					role="img"
					aria-label={logo.alt}
					style={`--logo-src: url(${logo.src.src}); aspect-ratio: ${logo.src.width} / ${logo.src.height}; --logo-max: ${LOGO_HEIGHT}px;`}
				/>
			))}
		</div>
	</div>

	<style>
	.hero {
		/* Exempt from the standard section gap — it's a viewport-height
		   composition with its own internal rhythm. */
		min-height: calc(100svh - var(--nav-height, 0px));
		display: flex;
		flex-direction: column;
		/* The ring runs past both viewport edges on purpose; clip (not
		   hidden) so it can't create a horizontal scrollbar without also
		   turning the hero into a scroll container. */
		overflow-x: clip;
	}

	.hero__stage {
		position: relative;
		/* Keeps the ring's and text's z-indexes (up to 1000) contained
		   in here, so the sticky nav stays above the whole hero. */
		isolation: isolate;
		flex: 1;
		display: grid;
		/* Text sits high, not centered, leaving the lower part of the
		   stage for the front of the ring to come to rest in. */
		place-items: start center;
		min-height: 560px;
		padding-block-start: clamp(var(--space-l), 7vh, 84px);
		/* Base item height — the script overrides it so the focused item
		   fills the space between the buttons and the logos. */
		--item-h: clamp(120px, 21vh, 230px);
	}

	/* The whole stage is a handle for turning the ring (see the drag
	   script) — sideways drags turn it, vertical ones still scroll. */
	/* No text selection in here: a drag would otherwise highlight the
	   headline and buttons as it passes over them (the text already
	   ignores the pointer, so nothing selectable is lost). */
	.hero__stage {
		cursor: grab;
		touch-action: pan-y;
		-webkit-user-select: none;
		user-select: none;
	}

	.hero__stage.is-dragging {
		cursor: grabbing;
	}

	.hero__stage.is-dragging .hero__actions {
		pointer-events: none;
	}

	.hero__actions a {
		cursor: pointer;
	}

	.hero__ring {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* Positioned by the script (a hand-rolled perspective projection, not
	   CSS 3D) so depth can drive blur and stacking order directly. */
	.hero__ring-item {
		position: absolute;
		left: 50%;
		top: 50%;
		height: var(--item-h);
		aspect-ratio: var(--ratio);
		translate: -50% -50%;
		border-radius: var(--radius-well);
		overflow: hidden;
		background: var(--color-neutral);
		will-change: transform, filter, opacity;
	}

	.hero__ring-item img,
	.hero__ring-item video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__sequence {
		display: flex;
		height: 100%;
	}

	.hero__sequence img {
		flex: 0 0 100%;
	}

	/* No z-index of its own — that would make it a stacking context and
	   trap the buttons' z-index below. Its children layer individually
	   against the ring items instead (the script's range is 100–900). */
	.hero__text {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		pointer-events: none;
	}

	/* The buttons always sit above the ring, even when a front item
	   passes behind them, so they stay visible and clickable. */
	.hero__actions {
		position: relative;
		z-index: 1000;
		pointer-events: auto;
	}

	/* Above back-of-ring items, below the focused front ones. */
	.hero__headline,
	.hero__subhead {
		position: relative;
		z-index: 700;
	}


	.hero__headline {
		max-width: 900px;
	}

	/* Always breaks after the greeting, never mid-phrase. */
	.hero__headline-line {
		display: block;
	}

	.hero__subhead {
		max-width: 60ch;
		margin-block-start: var(--space-s);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-xs);
		margin-block-start: var(--space-m);
	}

	.hero__clients {
		width: 100%;
		text-align: center;
		padding-block-end: var(--space-m);
	}

	.hero__clients-label {
		color: var(--color-logo-label);
		margin-block-end: var(--space-xs);
	}

	.hero__logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-s);
	}

	/* Each logo is its SVG used as a mask over a solid fill, so it takes
	   the palette's logo color in either mode regardless of the file's
	   own colors (Pega's lighter wing is partial opacity in its SVG, so
	   it stays lighter through the mask). */
	/* Full height while the row fits on one line (~1054px windows and
	   up); narrower than that, the logos scale down together instead of
	   wrapping, since a second row would eat the space the ring's front
	   item needs. The row is ~18.1px wide per px of logo height, plus
	   five 20px gaps; the 175px is those gaps, the container margins,
	   and a scrollbar's worth of slack. */
	.hero__logo {
		height: min(var(--logo-max), calc((100vw - 175px) / 18.1));
		display: block;
		background-color: var(--color-logo);
		-webkit-mask: var(--logo-src) center / contain no-repeat;
		mask: var(--logo-src) center / contain no-repeat;
	}

	@media (max-width: 768px) {
		/* Phone logos are two across, three rows, sized to the column:
		   Stack Overflow, the widest (3.75:1), fills ~90% of its column
		   (capped at 44px for tablets). The first screen ends 16px past
		   the label and the first row —
		   the hero runs the other two rows (and its bottom padding)
		   longer than the screen, so they sit below the fold instead of
		   taking height from the ring. */
		.hero {
			--logo-h: min(44px, calc((100vw - 2 * var(--container-margin) - var(--space-2xs)) / 2 * 0.9 / 3.75));
			--logo-row-gap: var(--space-s);
			min-height: calc(
				100svh - var(--nav-height, 0px) + 2 * (var(--logo-h) + var(--logo-row-gap)) + var(--space-m) - 16px
			);
		}

		/* The stage just takes whatever height the logo rows leave, and
		   the ring's focused item is sized by the script to fill the gap
		   between the buttons and the logos. */
		.hero__stage {
			min-height: 0;
			padding-block-start: var(--space-s);
			--item-h: 120px;
		}

		.hero__logos {
			display: grid;
			/* Two across, three rows. */
			grid-template-columns: repeat(2, 1fr);
			justify-items: center;
			align-items: center;
			row-gap: var(--logo-row-gap);
			column-gap: var(--space-2xs);
		}

		.hero__logo {
			height: var(--logo-h);
			max-width: 100%;
		}
	}
	</style>

	<script>
		import { gsap } from 'gsap';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const stage = document.querySelector<HTMLElement>('.hero__stage');
		const items = stage ? [...stage.querySelectorAll<HTMLElement>('.hero__ring-item')] : [];

		const TAU = Math.PI * 2;
		const STEP = TAU / items.length;
		// Seconds: the accelerate/decelerate halves of each spin (their
		// durations are tied so velocity is continuous at the handoff —
		// see spin()), then how long it rests on each new focus.
		const ACCEL = 0.8;
		const DECEL = ACCEL * 4.5;
		const HOLD = 2.2;

		// angle: the ring's rotation; item i sits at angle + i * STEP, and
		// whichever item is at 0 (mod TAU) is front and center.
		const state = { angle: 0 };
		let radius = 0;
		let tilt = 0;
		let centerY = 0;
		let small = false;

		const smoothstep = (a: number, b: number, v: number) => {
			const t = Math.min(1, Math.max(0, (v - a) / (b - a)));
			return t * t * (3 - 2 * t);
		};
		let perspective = 0;
		let maxBlur = 0;

		// Where an element will sit once its load-in drift is done: its
		// on-screen box minus whatever vertical `translate` it still has.
		// Placing the ring from the mid-drift position made it jump when
		// the text settled.
		function restingRect(el: Element | null) {
			if (!el) return undefined;
			const r = el.getBoundingClientRect();
			const dy = parseFloat(getComputedStyle(el).translate.split(' ')[1] ?? '0') || 0;
			return { top: r.top - dy, bottom: r.bottom - dy, height: r.height };
		}

		function measure() {
			if (!stage || !items.length) return;
			const w = stage.clientWidth;
			const h = stage.clientHeight;
			// Just under half the viewport: the sides graze the screen edges
			// and the items crowd together into a dense ring.
			// The same test as the CSS breakpoint (the stage's width leaves
			// out the scrollbar, so w < 768 disagreed with it just above).
			small = window.matchMedia('(max-width: 768px)').matches;
			// Phones: a ring about as wide as the screen, so the focused
			// item's neighbors just peek in from the edges.
			// Desktop: 46% of the width at full container width (1320px+),
			// widening steadily to 80% at the phone breakpoint. The items
			// don't shrink with the window (their size comes from the
			// vertical space), so a fixed fraction crammed them together
			// and pulled the sides in under the hero copy as it narrowed;
			// this keeps their spacing close to the full-width look.
			const widen = Math.min(1, Math.max(0, (1320 - w) / (1320 - 768)));
			radius = small ? w * 0.95 : Math.max(w * (0.46 + 0.34 * widen), 340);
			perspective = radius * 4;
			const frontScale = perspective / (perspective - radius);
			const backScale = perspective / (perspective + radius);
			// Sized and placed from the real layout: the focused (front)
			// item fills the space between the buttons and the logo row,
			// centered in it, and the back of the ring lines up with the
			// headline behind the text.
			const mid = stage.getBoundingClientRect().top + h / 2;
			const headline = restingRect(stage.querySelector('.hero__headline'))!;
			const actions = restingRect(stage.querySelector('.hero__actions'))!;
			const clients = restingRect(document.querySelector('.hero__clients'));
			const floor = clients ? clients.top : mid + h / 2;
			// A little more room above the focused item than below it.
			const gap = floor - actions.bottom;
			const itemTop = actions.bottom + (small ? Math.max(20, gap * 0.08) : Math.max(44, gap * 0.13));
			const itemBottom = floor - (small ? Math.max(12, gap * 0.05) : Math.max(28, gap * 0.08));
			let itemH = Math.max(small ? 80 : 140, (itemBottom - itemTop) / frontScale);
			// …but never so tall that the widest (16:9) item, in front,
			// runs off the sides of a phone screen.
			if (small) itemH = Math.min(itemH, (w * 0.86 * 9) / 16 / frontScale);
			stage.style.setProperty('--item-h', `${itemH.toFixed(1)}px`);
			const backY = headline.top + headline.height / 2 - mid;
			const frontY = (itemTop + itemBottom) / 2 - mid;
			tilt = Math.max(0, (frontY - backY) / (frontScale + backScale));
			centerY = backY + tilt * backScale;
			maxBlur = 10;
		}

		function render() {
			const n = items.length;
			const z = new Array<number>(n);
			const depth = new Array<number>(n);
			for (let i = 0; i < n; i++) {
				const theta = state.angle + i * STEP;
				const x = radius * Math.sin(theta);
				z[i] = radius * Math.cos(theta);
				const scale = perspective / (perspective - z[i]);
				const y = centerY / scale + tilt * Math.cos(theta);
				// 0 at the very front, 1 at the very back.
				depth[i] = (1 - z[i] / radius) / 2;
				const cx = x * scale;
				const cy = y * scale;
				const el = items[i];
				el.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
				const blur = depth[i] ** 1.4 * maxBlur;
				el.style.filter = blur < 0.25 ? 'none' : `blur(${blur.toFixed(1)}px)`;
				el.style.zIndex = String(Math.round(500 + (z[i] / radius) * 400));
			}
			for (let i = 0; i < n; i++) {
				// The back of the ring fades out entirely, leaving the space
				// behind the hero text clear.
				// Phones fade the sides out sooner — on a narrow screen they'd
				// otherwise sit right behind the subhead.
				const opacity = small ? 1 - smoothstep(0.1, 0.4, depth[i]) : 1 - smoothstep(0.3, 0.8, depth[i]);
				const el = items[i];
				el.style.opacity = opacity.toFixed(3);
				el.style.visibility = opacity < 0.01 ? 'hidden' : 'visible';
				const video = el.querySelector('video');
				// Only the front half of the ring plays — the back is faded
				// out anyway, and eight clips decoding at once is a lot.
				if (video) setPlaying(video, inView && !reduceMotion && depth[i] < 0.55);
			}
		}

		let inView = false;
		function setPlaying(video: HTMLVideoElement, play: boolean) {
			if (play === !video.paused) return;
			if (play) video.play().catch(() => {});
			else video.pause();
		}

		let focus = 0;
		let timeline: gsap.core.Animation | null = null;
		let pending: gsap.core.Tween | null = null;

		// One cycle: speed up, whip around at least one full turn, then
		// coast to a stop with the next item in front. The accelerate leg
		// covers a quarter of the distance on power2.in; the long
		// power3.out tail covers the rest. Their end/start velocities
		// (2·d/t and 3·d/t) match when DECEL = 4.5 × ACCEL, so there's no
		// hitch at the handoff.
		function spin() {
			const next = (focus + 1) % items.length;
			const start = state.angle;
			let target = -next * STEP;
			while (start - target < TAU) target -= TAU;
			while (start - target >= 2 * TAU) target += TAU;
			const distance = target - start;
			timeline = gsap
				.timeline({
					onComplete: () => {
						focus = next;
						timeline = null;
						pending = gsap.delayedCall(HOLD, spin);
					},
				})
				.to(state, { angle: start + distance * 0.25, duration: ACCEL, ease: 'power2.in', onUpdate: render })
				.to(state, { angle: target, duration: DECEL, ease: 'power3.out', onUpdate: render });
		}

		// The type sequences: hold a frame, ease one frame left, repeat,
		// snapping back to the start from the trailing copy. Same timing
		// as Off the Clock, with the second one starting half a beat later
		// so the two never slide in unison. They wait while the hero is
		// off-screen, and never move under reduced motion.
		const HOLD_MS = 1800;
		const SLIDE_MS = 1000;
		stage?.querySelectorAll<HTMLElement>('.hero__sequence').forEach((sequence, i) => {
			if (reduceMotion) return;
			const frameCount = sequence.children.length - 1;
			let frame = 0;
			const slide = () => {
				if (!inView) return;
				frame += 1;
				sequence.style.transition = `transform ${SLIDE_MS}ms ease`;
				sequence.style.transform = `translateX(-${frame * 100}%)`;
				if (frame < frameCount) return;
				window.setTimeout(() => {
					frame = 0;
					sequence.style.transition = 'none';
					sequence.style.transform = 'translateX(0)';
				}, SLIDE_MS);
			};
			window.setTimeout(() => window.setInterval(slide, HOLD_MS + SLIDE_MS), i * 1400);
		});

		// --- Dragging. A sideways drag anywhere on the stage (except the
		// buttons) takes the ring over from the auto-spin and turns it
		// under the pointer; letting go carries the flick's speed into a
		// settle on the nearest item, which becomes the new focus, and
		// the auto-spin picks up from there after a longer rest than
		// usual, so it doesn't feel like it's snatching the ring back.
		const DRAG_SLOP = 6; // px before a press counts as a drag
		const RESUME_HOLD = HOLD + 1.5;
		let press: { id: number; x: number; y: number; angle: number } | null = null;
		let dragging = false;
		let samples: { t: number; angle: number }[] = [];

		// Angle per pixel, so the front item tracks the pointer 1:1.
		const perPixel = () => 1 / (radius * (perspective / (perspective - radius)));

		function startDrag() {
			dragging = true;
			stage!.classList.add('is-dragging');
			window.getSelection()?.removeAllRanges();
			timeline?.kill();
			pending?.kill();
			timeline = pending = null;
		}

		function settle() {
			// Angular speed over the last ~80ms of the drag, in rad/s.
			const now = performance.now();
			const recent = samples.filter((s) => now - s.t < 80);
			const first = recent[0];
			const last = recent[recent.length - 1];
			const dt = first && last && last.t > first.t ? (last.t - first.t) / 1000 : 0;
			const v = dt ? (last.angle - first.angle) / dt : 0;
			// Coast about a third of a second's worth of the flick, then
			// land on whichever item is nearest there.
			const projected = state.angle + v * 0.35;
			const k = Math.round(-projected / STEP);
			const target = -k * STEP;
			const n = items.length;
			focus = ((k % n) + n) % n;
			const resume = () => {
				timeline = null;
				if (!reduceMotion) pending = gsap.delayedCall(RESUME_HOLD, spin).paused(!inView);
			};
			if (reduceMotion) {
				state.angle = target;
				render();
				return resume();
			}
			// power3.out starts at 3·d/t — pick t so that matches the
			// flick's speed, so there's no hitch at release.
			const d = Math.abs(target - state.angle);
			const t = Math.abs(v) > 0.05 ? Math.min(1.6, Math.max(0.45, (3 * d) / Math.abs(v))) : 0.6;
			timeline = gsap.to(state, { angle: target, duration: t, ease: 'power3.out', onUpdate: render, onComplete: resume });
			timeline.paused(!inView);
		}

		stage?.addEventListener('pointerdown', (e) => {
			if (press || e.button !== 0 || (e.target as Element).closest('a, button')) return;
			press = { id: e.pointerId, x: e.clientX, y: e.clientY, angle: state.angle };
		});

		stage?.addEventListener('pointermove', (e) => {
			if (!press || e.pointerId !== press.id) return;
			const dx = e.clientX - press.x;
			if (!dragging) {
				const dy = e.clientY - press.y;
				if (Math.abs(dx) < DRAG_SLOP || Math.abs(dx) < Math.abs(dy)) return;
				startDrag();
				stage.setPointerCapture(e.pointerId);
				// Start from here, not the press point, so it doesn't jump.
				press.x = e.clientX;
				press.angle = state.angle;
			}
			state.angle = press.angle + (e.clientX - press.x) * perPixel();
			samples.push({ t: performance.now(), angle: state.angle });
			if (samples.length > 12) samples.shift();
			render();
		});

		const endPress = (e: PointerEvent) => {
			if (!press || e.pointerId !== press.id) return;
			press = null;
			if (!dragging) return;
			dragging = false;
			stage!.classList.remove('is-dragging');
			settle();
			samples = [];
		};
		stage?.addEventListener('pointerup', endPress);
		stage?.addEventListener('pointercancel', endPress);

		if (stage && items.length) {
			measure();
			render();
			new ResizeObserver(() => {
				measure();
				render();
			}).observe(stage);

			if (!reduceMotion) {
				pending = gsap.delayedCall(HOLD, spin);
				// Nothing spins or plays while the hero is off-screen.
				new IntersectionObserver(
					([entry]) => {
						inView = entry.isIntersecting;
						timeline?.paused(!inView);
						pending?.paused(!inView);
						render();
					},
					{ threshold: 0.05 },
				).observe(stage);
			}
		}
	</script>
</section>
