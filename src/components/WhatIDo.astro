---
import iconMotion from '../assets/icons/services/motion.svg';
import iconSystems from '../assets/icons/services/systems.svg';
import iconStrategy from '../assets/icons/services/strategy.svg';

const sections = [
	{
		title: 'Motion',
		claim: 'Everything I make moves.',
		caption: 'Freed.ai — animated ads and spot illustration',
		icon: iconMotion,
	},
	{
		title: 'Systems',
		claim: 'One system, everywhere the brand lives.',
		caption: 'Tulip — brand refresh, guidelines, and internal tooling',
		icon: iconSystems,
	},
	{
		title: 'Strategy',
		claim: 'Strategy, from the first workshop on.',
		caption: 'Stack Overflow — the rebrand, below ↓',
		icon: iconStrategy,
	},
];
---

<section class="what-i-do">
	<div class="container">
		<h2 class="type-h1">What I do.</h2>
	</div>

	<div class="card-strip">
		{sections.map((section, i) => (
			<article class="card" data-card-index={i}>
				<div class="card__title-row">
					<span class="card__icon" style={`--icon-src: url(${section.icon.src})`} aria-hidden="true"></span>
					<h3 class="type-h3">{section.title}</h3>
				</div>
				<p class="type-body card__claim">{section.claim}</p>
				<p class="type-caption card__caption">{section.caption}</p>
				<div class="card__well" aria-hidden="true"></div>
			</article>
		))}
	</div>

	<div class="container what-i-do__nav-wrap">
		<nav class="nav-pill" aria-label="What I do sections">
			{sections.map((section, i) => (
				<button type="button" class="nav-pill__tab" data-tab-index={i} aria-current={i === 0 ? 'true' : undefined}>
					<span class="type-caption">{section.title}</span>
					<span class="nav-pill__dot" aria-hidden="true"></span>
				</button>
			))}
		</nav>
	</div>

	<style>
	.card-strip {
		--strip-inset: max(
			var(--container-margin),
			calc((100vw - var(--container-max)) / 2 + var(--container-margin))
		);
		--card-width: calc(0.85 * (min(100vw, var(--container-max)) - 2 * var(--container-margin)));

		display: flex;
		gap: var(--space-s);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		padding-inline-start: var(--strip-inset);
		/* Trailing slack so the last card can scroll all the way to the
		   inset too — without this, the strip runs out of scrollable
		   distance just short of snapping the last card into place. */
		padding-inline-end: calc(100vw - var(--strip-inset) - var(--card-width));
		scroll-padding-inline-start: var(--strip-inset);
		cursor: grab;
		margin-block-start: var(--space-m);

		/* Hide the scrollbar; the strip is still scrollable/draggable. */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.card-strip::-webkit-scrollbar {
		display: none;
	}

	.card-strip.is-dragging {
		cursor: grabbing;
		user-select: none;
	}

	.what-i-do__nav-wrap {
		display: flex;
		justify-content: center;
		margin-block-start: var(--space-m);
	}

	.card {
		flex: 0 0 auto;
		width: var(--card-width);
		background: var(--color-panel);
		border-radius: var(--radius-card);
		padding: var(--space-xs);
		scroll-snap-align: start;

		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'title title'
			'claim caption'
			'well well';
	}

	.card__title-row {
		grid-area: title;
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	.card__icon {
		display: block;
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		background-color: var(--color-accent);
		-webkit-mask-image: var(--icon-src);
		mask-image: var(--icon-src);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	.card__claim {
		grid-area: claim;
		align-self: baseline;
	}

	.card__caption {
		grid-area: caption;
		align-self: baseline;
		justify-self: end;
		margin-block-start: var(--space-s);
		white-space: nowrap;
	}

	.card__well {
		grid-area: well;
		margin-block-start: var(--space-xs);
		/* Explicit width (not just implicit grid stretch) so
		   aspect-ratio always resolves from a definite size — same fix
		   as the About page headshot circle. Without it, the well's
		   width can end up wider than the grid column, spilling past
		   the card's own right padding. */
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-well);
		/* Slightly lighter than the card panel behind it. */
		background: var(--color-panel-well);
	}

	.nav-pill {
		display: inline-flex;
		align-items: center;
		border-radius: var(--radius-pill);
		background: var(--color-neutral);
		padding-block: var(--button-pad-y);
		padding-inline: var(--space-s);
		gap: var(--space-s);
	}

	.nav-pill__tab {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		opacity: 0.5;
		transition: opacity 0.15s ease;
	}

	.nav-pill__tab:hover {
		opacity: 0.75;
	}

	.nav-pill__tab[aria-current='true'] {
		opacity: 1;
		color: var(--color-accent);
		font-weight: 600;
	}

	.nav-pill__dot {
		display: block;
		width: 6px;
		height: 6px;
		border-radius: var(--radius-pill);
		background: currentColor;
		transition: width 0.15s ease;
	}

	.nav-pill__tab[aria-current='true'] .nav-pill__dot {
		width: 18px;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-pill__tab,
		.nav-pill__dot {
			transition: none;
		}
	}

	@media (max-width: 900px) {
		/* Below true mobile scale (768px) the card is already a single
		   column at 80vw, so claim/caption never compete for space —
		   but between 768–900px, the card is still the 85%-of-container
		   desktop width with claim and caption side by side, and that's
		   narrow enough for them to start crowding each other. Move the
		   caption below the well earlier, at 900px, to get ahead of it. */
		.card {
			/* minmax(0, 1fr), not bare 1fr: a bare fr track carries an
			   implicit content-based minimum, which was fighting the
			   well's aspect-ratio sizing and computing the column ~6px
			   too wide — exactly the leftover space that was eating
			   into the card's right padding. */
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'title'
				'claim'
				'well'
				'caption';
		}

		.card__caption {
			justify-self: start;
			margin-block-start: var(--space-xs);
			white-space: normal;
		}
	}

	@media (max-width: 768px) {
		.card-strip {
			--card-width: 80vw;
		}

		.card__well {
			aspect-ratio: 1 / 1;
		}
	}
</style>

<script>
	import { createCarousel } from '../scripts/carousel';

	const strip = document.querySelector<HTMLElement>('.card-strip');
	const cards = strip ? [...strip.querySelectorAll<HTMLElement>('.card')] : [];
	const tabs = [...document.querySelectorAll<HTMLButtonElement>('.nav-pill__tab')];

	function setActive(index: number) {
		tabs.forEach((tab, i) => {
			if (i === index) {
				tab.setAttribute('aria-current', 'true');
			} else {
				tab.removeAttribute('aria-current');
			}
		});
	}

	function currentInset() {
		if (!strip) return 0;
		const style = getComputedStyle(strip);
		const value = style.scrollPaddingLeft || style.scrollPaddingInlineStart;
		return parseFloat(value) || 0;
	}

	if (strip && cards.length > 0) {
		const carousel = createCarousel({
			strip,
			items: cards,
			inset: currentInset,
			onActiveChange: setActive,
		});

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => carousel.goTo(i));
		});
	}
</script>
</section>
