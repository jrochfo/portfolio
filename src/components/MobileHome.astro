---
// The phone homepage's middle (the bio is in the hero): a reverse-chronological
// work list with one visual each (the testimonial cards follow it).
// Shown only in phone mode (see Base.astro); it stands in for What I
// Do, the Rebrand case study and Also Shipped, which phone mode hides.
// A phone visitor mostly wants who / is it good / how to reach — so
// this is a summary, not the desktop site squeezed down. Dates and
// roles are from the resume (with the September 2026 Brand Manager
// promotion).
import { getImage } from 'astro:assets';
import AnimatedLogo from './AnimatedLogo.astro';
// The testimonial cards' logo files — tighter bounds than the hero
// row's, so they size and align more predictably here.
import logoStack from '../assets/testimonials/logos/Logo_Quote_Stack.svg';
import logoFreed from '../assets/testimonials/logos/Logo_Quote_Freed.svg';
import logoTulip from '../assets/testimonials/logos/Logo_Quote_Tulip.svg';
import freedPoster from '../assets/work/what-i-do/posters/motion-freed-poster.jpg';
import tulipPoster from '../assets/work/what-i-do/posters/systems-tulip-poster.jpg';

const poster = async (src: ImageMetadata) => (await getImage({ src, format: 'webp', width: 900, quality: 80 })).src;

type Work = {
	logo: ImageMetadata;
	// Optical size adjustment, where a wordmark reads small at the
	// shared height.
	logoHeight?: number;
	name: string;
	dates: string;
	role: string;
	// Earlier titles at the same company, one per line.
	earlier?: string[];
	line: string;
	media: { kind: 'animated-logo' } | { kind: 'video'; path: string; poster: string };
};

const work: Work[] = [
	{
		logo: logoStack,
		logoHeight: 32,
		name: 'Stack Overflow',
		dates: '2022 – now',
		role: 'Brand Manager',
		earlier: ['Senior Brand Designer, 2024–2026', 'Brand Designer, 2022–2024'],
		line: 'Led a rebrand and identity evolution with agency Koto, from first workshops to full rollout, now running the brand across product and marketing.',
		media: { kind: 'animated-logo' },
	},
	{
		logo: logoFreed,
		name: 'Freed',
		dates: '2025 – 2026',
		role: 'Freelance Designer',
		line: 'Animations, ads, product mocks, and spot illustrations for an AI scribe that lets clinicians focus on patients.',
		media: { kind: 'video', path: 'what-i-do/motion-freed', poster: await poster(freedPoster) },
	},
	{
		logo: logoTulip,
		name: 'Tulip Interfaces',
		dates: '2020 – 2021',
		role: 'Graphic Designer',
		line: 'Matured a modern manufacturing brand into a scalable system across product, marketing, and web, as a team of one.',
		media: { kind: 'video', path: 'what-i-do/systems-tulip', poster: await poster(tulipPoster) },
	},
];

---

<section class="mobile-home mobile-only">
	<div class="container mobile-home__inner">

		<div class="mobile-home__group" id="selected-work">
			<h2 class="type-h1" data-reveal>Selected work.</h2>
			<ol class="mobile-home__work">
				{work.map((w) => (
					<li class="mobile-home__entry" data-reveal>
						<div class="mobile-home__entry-head">
							<span
								class="mobile-home__logo"
								role="img"
								aria-label={w.name}
								style={`--logo-src: url(${w.logo.src}); aspect-ratio: ${w.logo.width} / ${w.logo.height};${w.logoHeight ? ` height: ${w.logoHeight}px;` : ''}`}
							/>
							<span class="type-caption mobile-home__dates">{w.dates}</span>
						</div>
						<p class="type-h3 mobile-home__role">{w.role}</p>
						{w.earlier && (
							<p class="type-caption mobile-home__earlier">
								{w.earlier.map((title, i) => (
									<>
										{i > 0 && <br />}
										{title}
									</>
								))}
							</p>
						)}
						<p class="type-body mobile-home__line">{w.line}</p>
						<div class="mobile-home__media">
							{w.media.kind === 'animated-logo' ? (
								<AnimatedLogo />
							) : (
								<video
									class="mobile-home__video"
									muted
									loop
									playsinline
									preload="none"
									poster={w.media.poster}
									data-mp4={`/video/${w.media.path}.mp4`}
									data-webm={`/video/${w.media.path}.webm`}
								/>
							)}
						</div>
					</li>
				))}
			</ol>
		</div>

	</div>
	<script>
		// The work videos load when they near the screen and play only while
		// they're on it; never on their own under reduced motion.
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const videos = [...document.querySelectorAll<HTMLVideoElement>('.mobile-home__video')];
		const load = (v: HTMLVideoElement) => {
			if (v.dataset.loaded) return;
			v.dataset.loaded = 'true';
			for (const [src, type] of [
				[v.dataset.webm, 'video/webm'],
				[v.dataset.mp4, 'video/mp4'],
			]) {
				if (!src) continue;
				const s = document.createElement('source');
				s.src = src;
				s.type = type!;
				v.appendChild(s);
			}
			v.load();
		};
		if (document.documentElement.classList.contains('mobile-view')) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						const v = e.target as HTMLVideoElement;
						if (e.isIntersecting) {
							load(v);
							if (!reduceMotion && e.intersectionRatio > 0.3) v.play().catch(() => {});
						} else {
							v.pause();
						}
					}
				},
				{ threshold: [0, 0.3] },
			);
			videos.forEach((v) => io.observe(v));
		}
	</script>
</section>

<style>
	/* Lands under the sticky nav when "See more" scrolls here. */
	#selected-work {
		scroll-margin-top: calc(var(--nav-height, 0px) + var(--space-s));
	}

	.mobile-home__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xl);
	}

	.mobile-home__work {
		list-style: none;
		margin: var(--space-m) 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.mobile-home__entry-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
	}

	/* The client logos, as on the hero: a mask over the logo color. */
	.mobile-home__logo {
		display: block;
		height: 28px;
		background-color: var(--color-logo);
		-webkit-mask: var(--logo-src) left center / contain no-repeat;
		mask: var(--logo-src) left center / contain no-repeat;
	}

	.mobile-home__dates,
	.mobile-home__earlier {
		color: var(--color-ink-muted);
	}

	/* Tabular figures only where digits are — this face's tabular set
	   widens commas too. */
	.mobile-home__dates {
		font-variant-numeric: tabular-nums;
	}

	.mobile-home__role {
		margin-block-start: var(--space-s);
	}

	.mobile-home__earlier {
		margin-block-start: var(--space-2xs);
	}

	.mobile-home__line {
		margin-block-start: var(--space-xs);
	}

	/* The work visuals run the full width of the screen, square-cornered:
	   pulled out past the container's margins on both sides. */
	.mobile-home__media {
		/* AnimatedLogo sizes itself from --ratio. */
		--ratio: 16 / 9;
		margin-block-start: var(--space-s);
		margin-inline: calc(-1 * var(--container-margin));
	}

	.mobile-home__media :global(.animated-logo) {
		border-radius: 0;
	}

	.mobile-home__video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--color-neutral);
	}



</style>

