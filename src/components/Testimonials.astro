---
import { Image } from 'astro:assets';
import { testimonials } from '../data/testimonials';
---

<section class="testimonials section--bleed">
	<div class="container">
		<h2 class="type-h1" data-reveal>What it’s like to work together.</h2>
	</div>

	<div class="testimonials__strip" data-reveal>
		{testimonials.map((t) => (
			<article class="testimonial-card">
				<span
					class="testimonial-card__logo"
					role="img"
					aria-label={t.company}
					style={`--logo-src: url(${t.logo.src}); aspect-ratio: ${t.logo.width} / ${t.logo.height};`}
				/>
				<p
					class={`type-h3 testimonial-card__quote ${t.placeholder ? 'testimonial-card__quote--placeholder' : ''}`}
				>
					{t.quote}
				</p>
				<p class="type-caption testimonial-card__credit">
					{t.name}
					<br />
					{t.title}<span class="testimonial-card__credit-connector">{t.connector}</span><br
						class="testimonial-card__credit-break"
					/>{t.company}
				</p>
				<Image
					src={t.headshot}
					alt={t.name}
					width={120}
					height={120}
					densities={[1, 2]}
					class="testimonial-card__headshot"
					draggable="false"
				/>
			</article>
		))}
	</div>

	<style>
		.testimonials {
			background: var(--color-band);
		}

		.testimonials__strip {
			/* Same formula as WhatIDo's card strip: matches the
			   container's own left inset (so the first card lines up
			   with the H1 above it) rather than a flat page-edge value,
			   which would drift from the container on wide viewports. */
			--strip-inset: max(
				var(--container-margin),
				calc((100vw - var(--container-max)) / 2 + var(--container-margin))
			);

			display: flex;
			gap: var(--space-s);
			overflow-x: auto;
			cursor: grab;
			margin-block-start: var(--space-m);

			/* Same inset on both sides: the last card's right edge stops
			   at the container's right edge, matching where the first
			   card starts on the left — not the viewport edge. */
			padding-inline: var(--strip-inset);
			scroll-padding-inline-start: var(--strip-inset);

			/* Hide the scrollbar; the strip is still scrollable/draggable. */
			scrollbar-width: none;
			-ms-overflow-style: none;
		}

		.testimonials__strip::-webkit-scrollbar {
			display: none;
		}

		.testimonials__strip.is-dragging {
			cursor: grabbing;
			user-select: none;
		}

		.testimonial-card {
			position: relative;
			flex: 0 0 auto;
			width: 525px;
			aspect-ratio: 5 / 3;
			/* Contrasts against the section's gray band. */
			background: var(--color-surface);
			border-radius: var(--radius-card);
			padding: var(--space-s);
			display: flex;
			flex-direction: column;
			/* Only takes effect once the strip's scroll-snap-type is
			   active (mobile) — harmless no-op on desktop. */
			scroll-snap-align: start;
		}

		/* The logo SVG as a mask over the palette's logo color — see the
		   hero logo row. */
		.testimonial-card__logo {
			display: block;
			height: 28px;
			background-color: var(--color-logo);
			-webkit-mask: var(--logo-src) center / contain no-repeat;
			mask: var(--logo-src) center / contain no-repeat;
			flex-shrink: 0;
			width: auto;
			/* Flex column's default stretch would otherwise center/stretch
			   a replaced element like an img instead of left-aligning it. */
			align-self: flex-start;
		}

		/* The quote column and the headshot share the card's width — sized
		   so the longest quote (Dave's) still sets in five lines. */
		.testimonial-card__quote {
			max-width: 74%;
			margin-block-start: var(--space-s);
		}

		.testimonial-card__quote--placeholder {
			opacity: 0.5;
		}

		.testimonial-card__credit {
			/* Anchored to the corner, like the headshot, rather than
			   flowing after the quote — its distance from the quote
			   above will vary slightly with quote length, but it
			   always sits flush at the card's bottom-left. */
			position: absolute;
			left: var(--space-s);
			bottom: var(--space-s);
		}

		.testimonial-card__credit-break {
			/* Desktop: one continuous line — suppress the break. */
			display: none;
		}

		.testimonial-card__headshot {
			position: absolute;
			right: var(--space-s);
			bottom: var(--space-s);
			width: 104px;
			height: 104px;
			border-radius: var(--radius-well);
			object-fit: cover;
		}

		@media (max-width: 768px) {
			.testimonials__strip {
				scroll-snap-type: x mandatory;
			}

			/* Phones and tablets: the content sets the height (no fixed
			   shape), so a long quote can't run under the credit and
			   headshot and a short one doesn't leave empty card. Logo and
			   quote across the top, then the credit and headshot side by
			   side at the bottom. Cards in the strip still match the
			   tallest (flex stretch). */
			.testimonial-card {
				/* Capped so a tablet in portrait doesn't get one huge,
				   mostly empty card. */
				width: min(80vw, 420px);
				aspect-ratio: auto;
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-rows: auto auto 1fr auto;
				column-gap: var(--space-xs);
			}

			.testimonial-card__logo {
				grid-column: 1 / -1;
				justify-self: start;
			}

			.testimonial-card__quote {
				grid-column: 1 / -1;
				max-width: none;
				margin-block-start: var(--space-s);
			}

			.testimonial-card__credit {
				position: static;
				grid-row: 4;
				align-self: end;
			}

			.testimonial-card__headshot {
				position: static;
				grid-row: 4;
				grid-column: 2;
				align-self: end;
				width: 88px;
				height: 88px;
				margin-block-start: var(--space-s);
			}

			.testimonial-card__credit-break {
				display: inline;
			}

			.testimonial-card__credit-connector {
				display: none;
			}
		}

			.testimonial-card__quote {
				margin-block-start: var(--space-s);
			}

		}
	</style>

	<script>
		const strip = document.querySelector<HTMLElement>('.testimonials__strip');
		const cards = strip ? [...strip.querySelectorAll<HTMLElement>('.testimonial-card')] : [];
		const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
		const mobileQuery = window.matchMedia('(max-width: 768px)');

		function currentInset() {
			if (!strip) return 0;
			const style = getComputedStyle(strip);
			const value = style.scrollPaddingLeft || style.scrollPaddingInlineStart;
			return parseFloat(value) || 0;
		}

		// Offset of each card's left edge from where it "should" be if
		// snapped there (0 = already snapped). Same technique as
		// WhatIDo's card strip.
		function cardOffsets() {
			if (!strip) return [];
			const stripLeft = strip.getBoundingClientRect().left;
			const inset = currentInset();
			return cards.map((card) => card.getBoundingClientRect().left - stripLeft - inset);
		}

		function nearestIndex(offsets: number[]) {
			let bestIndex = 0;
			let bestAbs = Infinity;
			offsets.forEach((offset, i) => {
				const abs = Math.abs(offset);
				if (abs < bestAbs) {
					bestAbs = abs;
					bestIndex = i;
				}
			});
			return bestIndex;
		}

		// Custom eased scroll (snappy start, easing into place), same as
		// WhatIDo — scroll-snap is suspended for the duration so it
		// doesn't fight per-frame scrollLeft writes, then restored.
		function animateScrollTo(target: number) {
			if (!strip) return;
			const start = strip.scrollLeft;
			const change = target - start;

			if (reduceMotionQuery.matches || Math.abs(change) < 1) {
				strip.scrollLeft = target;
				return;
			}

			const duration = 450;
			const startTime = performance.now();
			strip.style.scrollSnapType = 'none';

			function step(now: number) {
				if (!strip) return;
				const t = Math.min((now - startTime) / duration, 1);
				const eased = 1 - Math.pow(1 - t, 4);
				strip.scrollLeft = start + change * eased;
				if (t < 1) {
					requestAnimationFrame(step);
				} else {
					strip.style.scrollSnapType = '';
				}
			}
			requestAnimationFrame(step);
		}

		// Desktop: each card has its own resting alignment — first flush
		// left, last flush right, the two in between centered in the
		// viewport — rather than every card uniformly left-justifying
		// like WhatIDo/mobile. A drag release eases toward whichever of
		// these four positions is nearest (or next, past the threshold).
		type Alignment = 'start' | 'center' | 'end';
		const DESKTOP_ALIGNMENTS: Alignment[] = ['start', 'center', 'center', 'end'];

		// Absolute position of a card's left edge within the strip's
		// scrollable content — independent of current scroll position,
		// same technique as cardOffsets() below.
		function cardContentLeft(card: HTMLElement) {
			if (!strip) return 0;
			const stripLeft = strip.getBoundingClientRect().left;
			return strip.scrollLeft + (card.getBoundingClientRect().left - stripLeft);
		}

		function desktopTargetFor(index: number) {
			if (!strip) return 0;
			const card = cards[index];
			const contentLeft = cardContentLeft(card);
			const cardWidth = card.getBoundingClientRect().width;
			const inset = currentInset();
			const viewportWidth = window.innerWidth;
			const alignment = DESKTOP_ALIGNMENTS[index] ?? 'center';

			if (alignment === 'start') return contentLeft - inset;
			if (alignment === 'end') return contentLeft + cardWidth - (viewportWidth - inset);
			return contentLeft + cardWidth / 2 - viewportWidth / 2;
		}

		function nearestDesktopTargetIndex() {
			if (!strip) return 0;
			let bestIndex = 0;
			let bestAbs = Infinity;
			cards.forEach((_, i) => {
				const abs = Math.abs(desktopTargetFor(i) - strip!.scrollLeft);
				if (abs < bestAbs) {
					bestAbs = abs;
					bestIndex = i;
				}
			});
			return bestIndex;
		}

		if (strip) {
			const DRAG_ADVANCE_THRESHOLD = 24;

			let isDown = false;
			let startX = 0;
			let startScrollLeft = 0;
			let dragStartIndex = 0;

			strip.addEventListener('mousedown', (e) => {
				isDown = true;
				strip.classList.add('is-dragging');
				startX = e.pageX;
				startScrollLeft = strip.scrollLeft;

				if (mobileQuery.matches) {
					// Mobile snaps left-justified like WhatIDo's card strip.
					strip.style.scrollSnapType = 'none';
					dragStartIndex = nearestIndex(cardOffsets());
				} else {
					dragStartIndex = nearestDesktopTargetIndex();
				}
			});

			window.addEventListener('mouseup', () => {
				if (!isDown) return;
				isDown = false;
				strip.classList.remove('is-dragging');

				const dragDistance = strip.scrollLeft - startScrollLeft;
				let targetIndex = dragStartIndex;

				if (Math.abs(dragDistance) > DRAG_ADVANCE_THRESHOLD) {
					if (mobileQuery.matches) {
						targetIndex = dragStartIndex + Math.sign(dragDistance);
					} else {
						// Snap to whichever target the drag actually ended
						// nearest to, rather than always advancing by one —
						// a big drag can skip straight to the last card in
						// that direction instead of overshooting past it
						// and then jittering back to just the next one.
						targetIndex = nearestDesktopTargetIndex();
						if (targetIndex === dragStartIndex) {
							targetIndex = dragStartIndex + Math.sign(dragDistance);
						}
					}
				}

				targetIndex = Math.max(0, Math.min(cards.length - 1, targetIndex));

				if (mobileQuery.matches) {
					const offsets = cardOffsets();
					animateScrollTo(strip.scrollLeft + offsets[targetIndex]);
				} else {
					animateScrollTo(desktopTargetFor(targetIndex));
				}
			});

			window.addEventListener('mousemove', (e) => {
				if (!isDown) return;
				e.preventDefault();
				strip.scrollLeft = startScrollLeft - (e.pageX - startX);
			});
		}
	</script>
</section>
