---
import { getImage } from 'astro:assets';
import GlyphViewer from './GlyphViewer.astro';
import AnimatedLogo from './AnimatedLogo.astro';
import rfpCoverSvg from '../assets/work/so-rebrand/direction/rfp.svg';
import londonConference from '../assets/work/so-rebrand/direction/london-1.jpg';
import londonPlacard from '../assets/work/so-rebrand/direction/london-2.jpg';
import londonWhiteboard from '../assets/work/so-rebrand/direction/london-3.jpg';
import londonPub from '../assets/work/so-rebrand/direction/london-4.jpg';
import brandWorkshopSvg from '../assets/work/so-rebrand/direction/brandworkshop-1.svg';
import whatHowWhySvg from '../assets/work/so-rebrand/direction/workshop-whathowwhy.svg';

import newLogo from '../assets/work/so-rebrand/systems/systems-1.svg';
import guidelinesScrollPoster from '../assets/work/so-rebrand/posters/guidelines-scroll-poster.jpg';
import glyphViewerPlaceholder from '../assets/work/so-rebrand/systems/systems-3-1.svg';
import typeDetailZoom from '../assets/work/so-rebrand/systems/systems-3-2.svg';
import toneOfVoice from '../assets/work/so-rebrand/systems/systems-4.svg';
import stacksShapeSystem from '../assets/work/so-rebrand/systems/systems-5-1.svg';
import stacksLinkedInMockup from '../assets/work/so-rebrand/systems/systems-5-2.svg';
import isometricSkewDiagram from '../assets/work/so-rebrand/systems/systems-6-1.svg';
import isometricSkewPlugin from '../assets/work/so-rebrand/systems/systems-6-2.svg';
import deckTemplatesPlaceholder from '../assets/work/so-rebrand/systems/systems-7.svg';
import nashville1 from '../assets/work/so-rebrand/systems/systems-8-1.jpg';
import nashville2 from '../assets/work/so-rebrand/systems/systems-8-2.jpg';
import uxNotificationCards from '../assets/work/so-rebrand/systems/systems-9-1.svg';
import ux404Page from '../assets/work/so-rebrand/systems/systems-9-2.svg';

const acts = [
	{
		title: 'Direction',
		description:
			"What began as an idea between me and my boss, Dave — Project RISE — snowballed into three months of internal research, a 40-page RFP, and finally a four-agency bake-off that ended with Koto. Internal workshops mapped our what, how, and why long before Koto ever saw the brief, then weeks of work in London with their team expanded that into strategy and tone-of-voice sessions face to face with the C-suite. We left that week with every leader aligned on the same direction, months before any visual work began.",
	},
	{
		title: 'System',
		description:
			"With the direction phase complete, we really got to work. Logo, type, a brand shape system, tone of voice, and more all came together on a guidelines site our team built end to end. We met with Koto and Stack Overflow's product team in Nashville for a brand-product intensive, sticky notes covering the walls, as we stress-tested the new brand against real interface problems. We left Nashville with a system ready for rollout to both product and marketing.",
		// The substring below is linked out to the real, live site rather
		// than duplicated as separate link-text — this stays in sync with
		// the description above automatically if it's ever reworded.
		link: { text: 'a guidelines site our team built end to end', href: 'https://stackoverflow.design/' },
	},
	{
		title: 'Rollout',
		description: 'A year of deployment: product surfaces, decks, events, social, motion.',
	},
];

// Each act with real content gets its own pin board: a loose
// two-column grid (occasional full-width rows for hero pieces), each
// photo/document held down by a small pushpin at its top-center and
// given a very slight per-item skew — not a freeform scatter, but not
// a sterile grid either. Rollout is still the original placeholder
// grid below, pending its own content.
const [
	conferenceImg,
	placardImg,
	whiteboardImg,
	pubImg,
	nashville1Img,
	nashville2Img,
	brandWorkshopImg,
	whatHowWhyImg,
	uxNotificationCardsImg,
	toneOfVoiceImg,
	stacksShapeSystemImg,
	stacksLinkedInMockupImg,
] = await Promise.all([
	getImage({ src: londonConference, format: 'webp', width: 900 }),
	getImage({ src: londonPlacard, format: 'webp', width: 700 }),
	getImage({ src: londonWhiteboard, format: 'webp', width: 900 }),
	getImage({ src: londonPub, format: 'webp', width: 700 }),
	getImage({ src: nashville1, format: 'webp', width: 900 }),
	getImage({ src: nashville2, format: 'webp', width: 900 }),
	// The RFP cover and every other System SVG are simple/small enough
	// to stay vector, used directly below via .src. These six are the
	// exception — complex, screenshot-like mockups that were shipping
	// as multi-hundred-KB to 1.4MB raw SVGs. Rasterizing checked out
	// visually against the vector originals (including the dense
	// sticky-note text) with no perceptible loss — there's no lightbox
	// on this pinboard, so nothing ever renders larger than the grid
	// itself. Width is ~3x each pin's real measured CSS display width
	// (not the viewBox/container assumption — measured directly, since
	// the first pass at brandworkshop-1/whatHowWhy/toneOfVoice used too
	// thin a margin and looked visibly soft on real retina displays);
	// quality 88 (vs. the flatter ascii visual's 82) since these carry
	// finer text detail.
	getImage({ src: brandWorkshopSvg, format: 'webp', width: 3600, quality: 88 }),
	getImage({ src: whatHowWhySvg, format: 'webp', width: 2400, quality: 88 }),
	getImage({ src: uxNotificationCards, format: 'webp', width: 1200, quality: 88 }),
	getImage({ src: toneOfVoice, format: 'webp', width: 3840, quality: 88 }),
	getImage({ src: stacksShapeSystem, format: 'webp', width: 1200, quality: 88 }),
	getImage({ src: stacksLinkedInMockup, format: 'webp', width: 1200, quality: 88 }),
]);

// Mirrors What I Do's / Off The Clock's video() helper — a single
// well-compressed poster format, not the full avif/webp/fallback triad
// imageSlide-style helpers use for lightbox-worthy imagery.
async function video(name: string, poster: ImageMetadata) {
	const resolvedPoster = await getImage({ src: poster, format: 'webp' });
	return { mp4: `/video/so-rebrand/${name}.mp4`, webm: `/video/so-rebrand/${name}.webm`, poster: resolvedPoster.src };
}
const guidelinesScrollVideo = await video('guidelines-scroll', guidelinesScrollPoster);

interface Pin {
	src: string;
	alt: string;
	ratio: number; // width / height — drives both the flex-grow share within a shared-height row, and (for the full-width row) the aspect-ratio itself
	rot: number; // a couple of degrees at most — a hint of skew, not the old scatter's rotation
	pinTop?: string; // overrides the pin's default top offset — for an image with its own transparent margin (the workshop board), so the pin lands on the actual slide inside it, not the image's outer edge
	transparentBg?: boolean; // suppresses the shared neutral placeholder background — for an image with its own transparent gutters (e.g. the type-detail close-up), so the placeholder tone doesn't show through as a faint mat
	component?: 'glyph-viewer' | 'animated-logo'; // renders a real component in place of the <img> — for the interactive glyph-set viewer and the animated logo well, both of which need live DOM/JS rather than a static image
	video?: { mp4: string; webm: string; poster: string }; // renders a <video> in place of the <img> — muted/looping, autoplaying only while in view (see the script below)
}

// Grouped into explicit rows (rather than one auto-flowing list) so
// each row of two can share a single height, with each image's own
// aspect ratio determining how much of the row's width it takes —
// the wide research/strategy boards naturally run wider than the
// square placard/pub/conference shots, instead of both being forced
// into equal-width columns with mismatched heights. The workshop
// board is the one full-width row, sized by its own aspect ratio
// alone rather than sharing a row height with anything.
const directionRows: Pin[][] = [
	[
		{
			src: rfpCoverSvg.src,
			alt: 'Cover of the 40-page RFP Jake and Dave drafted to kick off the rebrand search',
			ratio: 595 / 842,
			rot: -0.8,
		},
		{
			src: whatHowWhyImg.src,
			alt: 'A "What, How, Why" brand strategy board from an early remote workshop, covered in sticky notes',
			ratio: 3191 / 1894,
			rot: 0.6,
		},
	],
	[
		{
			src: placardImg.src,
			alt: 'A room sign reading "Poached" next to a booking panel showing the room reserved for Stack Overflow, at Koto’s London studio',
			ratio: 1,
			rot: 0.9,
		},
		{
			src: conferenceImg.src,
			alt: 'Jake and the Koto team in a meeting room, a slide reading "Technology enthusiasts" on the screen behind them',
			ratio: 1,
			rot: -0.7,
		},
	],
	[
		{
			src: whiteboardImg.src,
			alt: 'Whiteboard covered in handwritten notes from a brand metaphor exercise, listing words like "Source," "Oasis," and "Vital"',
			ratio: 3874 / 3024,
			rot: 0.7,
		},
		{
			src: pubImg.src,
			alt: 'Jake raising a pint outside a London pub after the workshop',
			ratio: 1,
			rot: -1,
		},
	],
	[
		{
			src: brandWorkshopImg.src,
			alt: 'A personality and tone-of-voice workshop board, with sticky-note reactions to sample marketing copy',
			ratio: 2400 / 1400,
			rot: 0.5,
			// This SVG's own board rect sits inset from the canvas edge
			// (translate(141.889 84.5625) in the file — its drop-shadow
			// filters need that margin to blur into), not flush like the
			// old PNG exports looked. 84.5625/1400 = 6.04% down is where
			// the board itself actually starts.
			pinTop: 'calc(6.04% - 6px)',
		},
	],
];

// System's own rows — deliberately plain, unlike Direction's scattered
// pinboard: no skew, no pushpins, uniform spacing throughout, closer
// to the grid this act used as a placeholder. Direction's exploratory,
// slightly-messy corkboard treatment fit its own theme (workshops,
// sticky notes, alignment being *found*); System is the opposite
// story — a system being *engineered* — so it reads as a clean,
// systematic grid instead. Sequenced as one uninterrupted kit-first
// deep-dive, product application held back as the closer rather than
// an early interruption: the new logo full-width as the opening beat,
// a placeholder for the brand-guidelines-site walkthrough video, the
// interactive glyph viewer (placeholder for now) next to a
// type-detail close-up, the tone-of-voice principles, the full
// "Stacks" shape system next to it in use, the isometric-skew
// construction method next to the plugin setting that produces it, a
// placeholder for the deck-template library video, and finally the
// Nashville workshop where Koto met Stack's product team next to two
// examples of the system solving real product problems — proof it
// works, closing System out and setting up Rollout right after.
const systemRows: Pin[][] = [
	[
		{
			src: newLogo.src,
			alt: 'The new Stack Overflow logo lockup animating in against a scrub through brand guideline visuals, then settling back on the rebrand’s orange',
			ratio: 3840 / 2160,
			rot: 0,
			component: 'animated-logo',
		},
	],
	[
		{
			src: guidelinesScrollVideo.poster,
			alt: 'A scroll through the brand guidelines site Jake and Dave built, shown in a browser window on a desktop monitor',
			ratio: 3840 / 2160,
			rot: 0,
			video: guidelinesScrollVideo,
		},
	],
	[
		{
			src: glyphViewerPlaceholder.src,
			alt: 'An interactive glyph-set viewer showing the typeface at large scale, marking its ascender, cap height, x-height, baseline, and descender, with a switcher for weight',
			ratio: 1944 / 2370,
			rot: 0,
			component: 'glyph-viewer',
		},
		{
			src: typeDetailZoom.src,
			alt: 'An extreme close-up on the typeface, showing individual letterform details at large scale',
			ratio: 1944 / 2370,
			rot: 0,
			transparentBg: true,
		},
	],
	[
		{
			src: toneOfVoiceImg.src,
			alt: 'A slide reading "The Stack Overflow tone of voice is based on the following principles: simple, spirited, syntax," with a short definition of each',
			ratio: 3840 / 2160,
			rot: 0,
		},
	],
	[
		{
			src: stacksShapeSystemImg.src,
			alt: 'The full "Stacks" shape system — fifteen named 2D and 3D brand shapes, from Data and DNA to Rotor and Helix',
			ratio: 1855 / 2315,
			rot: 0,
		},
		{
			src: stacksLinkedInMockupImg.src,
			alt: 'A mockup of a Stack Overflow LinkedIn post using the Stacks shape system',
			ratio: 1914 / 2315,
			rot: 0,
		},
	],
	[
		{
			src: isometricSkewDiagram.src,
			alt: 'A diagram showing how to skew text against isometric shapes at precise pixel offsets',
			ratio: 2790 / 1987,
			rot: 0,
		},
		{
			src: isometricSkewPlugin.src,
			alt: 'The Figma plugin settings used to apply that same isometric skew',
			ratio: 1055 / 1987,
			rot: 0,
		},
	],
	[
		{
			src: deckTemplatesPlaceholder.src,
			alt: 'Placeholder for a video cycling through the rebrand’s refreshed deck template library',
			ratio: 3840 / 2071,
			rot: 0,
		},
	],
	[
		{
			src: nashville1Img.src,
			alt: 'Koto and Stack Overflow working through product theming questions during a workshop in Nashville, sketches and sticky notes covering the table',
			ratio: 1630 / 1630,
			rot: 0,
		},
		{
			src: nashville2Img.src,
			alt: 'The Koto and Stack Overflow teams grouped around a wall of sticky notes from the Nashville workshop',
			ratio: 2173 / 1630,
			rot: 0,
		},
	],
	[
		{
			src: uxNotificationCardsImg.src,
			alt: 'Stacked push-notification cards showing the rebrand carrying into a new product-alert design',
			ratio: 1880 / 1658,
			rot: 0,
		},
		{
			src: ux404Page.src,
			alt: 'A 404 error page using the rebrand’s 3D isometric shapes',
			ratio: 1880 / 1658,
			rot: 0,
		},
	],
];

interface ActPinboard {
	rows: Pin[][];
	// 'scattered': Direction's corkboard — skewed, pinned, hand-tuned
	// gaps. 'plain': everything else — square, unpinned, one uniform
	// gap throughout. The style is a property of the ACT (its theme),
	// not of any individual image, which is why it lives here rather
	// than on each Pin.
	style: 'scattered' | 'plain';
}

// Looked up by act title — an act with an entry here gets a real pin
// board; without one (Rollout, for now) it falls back to the original
// placeholder grid.
const pinboardsByAct: Record<string, ActPinboard> = {
	Direction: { rows: directionRows, style: 'scattered' },
	System: { rows: systemRows, style: 'plain' },
};
---

<section class="rebrand">
	<div class="rebrand__pinned-title">
		<div class="container">
			<h1 class="type-h1">The Stack Overflow rebrand.</h1>
		</div>
	</div>

	<div class="rebrand__body container">
		<p class="type-h3 rebrand__description">
			Fifteen years in, with AI upending how developers work, Stack Overflow needed more than
			a refresh. We helped Stack prove that in an increasingly automated world, verified
			knowledge (from actual human brains) is still king.
		</p>

		<div class="rebrand__acts">
			{acts.map((act) => (
				<article class="act">
					<h2 class="type-h2">{act.title}</h2>
					<p class="type-body act__desc">
						{act.link ? (
							<>
								{act.description.slice(0, act.description.indexOf(act.link.text))}
								<a href={act.link.href} target="_blank" rel="noopener noreferrer">
									{act.link.text}
								</a>
								{act.description.slice(act.description.indexOf(act.link.text) + act.link.text.length)}
							</>
						) : (
							act.description
						)}
					</p>
					{pinboardsByAct[act.title] ? (
						<div class={`act__pinboard act__pinboard--${pinboardsByAct[act.title].style}`}>
							{pinboardsByAct[act.title].rows.map((row) => (
								<div class={`act__pinboard-row ${row.length === 1 ? 'act__pinboard-row--full' : ''}`}>
									{row.map((pin) => (
										<div class="act__pinboard-item" style={`--ratio:${pin.ratio}; --rot:${pin.rot}deg; --pin-top:${pin.pinTop ?? '-6px'}; --item-bg:${pin.transparentBg ? 'none' : 'var(--color-neutral)'};`}>
											{pinboardsByAct[act.title].style === 'scattered' && (
												<span class="act__pinboard-pin" aria-hidden="true"></span>
											)}
											{pin.component === 'glyph-viewer' ? (
												<GlyphViewer />
											) : pin.component === 'animated-logo' ? (
												<AnimatedLogo />
											) : pin.video ? (
												<video
													class="act__pinboard-img act__pinboard-video"
													muted
													loop
													playsinline
													preload="none"
													poster={pin.video.poster}
													data-mp4={pin.video.mp4}
													data-webm={pin.video.webm}
													aria-label={pin.alt}
												/>
											) : (
												<img class="act__pinboard-img" src={pin.src} alt={pin.alt} loading="lazy" />
											)}
										</div>
									))}
								</div>
							))}
						</div>
					) : (
						<div class="act__gallery">
							<div class="act__gallery-item" aria-hidden="true"></div>
							<div class="act__gallery-item" aria-hidden="true"></div>
							<div class="act__gallery-item" aria-hidden="true"></div>
							<div class="act__gallery-item" aria-hidden="true"></div>
						</div>
					)}
				</article>
			))}
		</div>
	</div>

	<style>
	.rebrand {
		position: relative;
		/* Bottom slightly less than top — equal padding around a single
		   line of type reads as too much air underneath it. */
		--title-padding-top: var(--space-s);
		--title-padding-bottom: calc(var(--space-s) * 0.8);
	}

	.rebrand__pinned-title {
		/* Already out of normal flow, so pinning it (GSAP switches this
		   to position: fixed for the pin duration) never shifts layout —
		   .rebrand__body's padding-block-start reserves its height
		   instead, deliberately, rather than relying on GSAP's
		   pinSpacing to do it (that's what caused the doubled-space bug
		   in the spike). */
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 5;
		background: var(--color-bg);
		padding-block-start: var(--title-padding-top);
	}

	/* Border lives on the inner container (not the full-width title
	   bar) so it's container-width, like the rest of the page's
	   content — not a full-bleed rule. Same fade treatment as the
	   nav's own border: transparent at rest, only appearing while the
	   title is actually pinned (see .is-stuck, toggled by Rebrand's
	   ScrollTrigger onEnter/onLeave in the script below). */
	.rebrand__pinned-title .container {
		padding-block-end: var(--title-padding-bottom);
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease;
	}

	.rebrand__pinned-title.is-stuck .container {
		border-bottom-color: var(--color-line);
	}

	.rebrand__body {
		padding-block-start: calc(
			var(--type-h1-size) * var(--type-h1-line-height) + var(--title-padding-top) +
				var(--title-padding-bottom) + var(--space-s)
		);
	}

	.rebrand__acts {
		margin-block-start: var(--space-2xl);
	}

	.act + .act {
		margin-block-start: var(--space-2xl);
	}

	.act__desc {
		margin-block-start: var(--space-s);
	}

	.act__gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-xs);
		margin-block-start: var(--space-m);
	}

	.act__gallery-item {
		aspect-ratio: 1 / 1;
		border-radius: var(--radius-well);
		background: var(--color-neutral);
	}

	/* Explicit rows (see directionRows in the frontmatter), not one
	   auto-flowing grid. Within a two-image row, flex-grow proportional
	   to each image's own ratio (--ratio) decides how much of the row's
	   width it takes, and aspect-ratio (not a fixed height) derives each
	   image's own height from that width — the ratio cancels out of the
	   math, so every image in the row lands at the exact same height
	   with zero cropping, rather than a hardcoded row height fighting
	   object-fit to fake it. The closing workshop board is a plain
	   block row (not flex) so its single image just fills the container
	   width normally — flex's default flex-shrink:0 on a lone
	   non-growing item refuses to shrink below the image's own intrinsic
	   pixel size, which is what was blowing it out past the container. */
	.act__pinboard {
		margin-block-start: var(--space-m);
	}

	.act__pinboard-row {
		display: flex;
		align-items: flex-start;
		gap: var(--space-s);
	}

	.act__pinboard-row + .act__pinboard-row {
		margin-block-start: var(--space-s);
	}

	/* Tighter than the general row-to-row gap above — a full-width
	   image's own top margin (transparent space a drop-shadow blurs
	   into, e.g. the Direction workshop board) already reads as extra
	   whitespace on top of a full page gap, so that transition
	   specifically needs to be shorter than the others to not look
	   doubled-up. Zero here, not just a smaller token — the item's own
	   14px pin-clearance margin (below) already does all the work of
	   separating it from the row above.

	   Scoped to .act__pinboard--scattered (Direction) and to only a
	   *2-column* row feeding into a full row: plain-style boards
	   (System) want their one uniform gap everywhere, and even within
	   scattered, two full rows back to back (a placeholder video into
	   its next full slide) don't have this doubled-whitespace problem
	   in the first place — zeroing that gap too would read as two
	   slabs touching with no separation at all. */
	.act__pinboard--scattered .act__pinboard-row:not(.act__pinboard-row--full) + .act__pinboard-row--full {
		margin-block-start: 0;
	}

	/* System's own rows: no skew (rot is 0 in the data anyway), no
	   pushpins (not rendered in the markup for this style), and one
	   uniform gap everywhere instead of scattered's hand-tuned
	   exceptions above — closer to the plain grid this act used as a
	   placeholder before real content arrived. */
	.act__pinboard--plain .act__pinboard-row {
		gap: var(--space-xs);
	}

	.act__pinboard--plain .act__pinboard-row + .act__pinboard-row {
		margin-block-start: var(--space-xs);
	}

	.act__pinboard--plain .act__pinboard-item {
		/* No pin, so no need to reserve space above the image for one. */
		margin-block-start: 0;
	}

	.act__pinboard-row--full {
		/* flow-root, not plain block — block would let the item's own
		   margin-block-start (below) collapse into this rule's own
		   margin-block-start instead of adding to it, making the gap
		   above this one row 14px shorter than every other gap on the
		   board. flow-root keeps the plain block layout (still no
		   flex-shrink:0 overflow risk) while stopping that collapse. */
		display: flow-root;
	}

	.act__pinboard-item {
		position: relative;
		/* flex-basis: 0 + grow: var(--ratio) is the standard "justified
		   row" trick — items share the row's width in proportion to their
		   own aspect ratio. */
		flex: var(--ratio) 1 0;
		min-width: 0;
		/* Room for the pushpin to sit half on, half above the photo. Kept
		   on every item unconditionally (not just the first per row) so
		   row-to-row spacing and item-to-item spacing (the mobile stack,
		   via the row's own gap) end up visually identical — both are
		   this same 14px plus the shared var(--space-m) rhythm. */
		margin-block-start: 14px;
	}

	.act__pinboard-img {
		display: block;
		width: 100%;
		aspect-ratio: var(--ratio);
		border-radius: var(--radius-well);
		/* Defaults to the shared neutral placeholder tone; a pin with
		   its own transparent gutters (see transparentBg on the Pin
		   type) sets this to none instead, so that tone doesn't show
		   through as a faint mat. */
		background: var(--item-bg);
		transform: rotate(var(--rot));
	}

	/* Scoped to scattered boards only — this bleed math is measured
	   specifically off the Direction workshop board's own margins
	   (see below). System's full-width rows are plain placeholders/
	   slides with no matching margin to reveal, so they stay at the
	   ordinary width: 100% from the base rule above; applying this
	   same scale-up to them would just overflow them past the
	   container for no reason. */
	.act__pinboard--scattered .act__pinboard-row--full .act__pinboard-img {
		/* The workshop board's own SVG content is inset from its canvas
		   edge (room for its drop-shadow filters to blur into) — the
		   shared neutral placeholder background above would otherwise
		   show through that margin as a faint mat instead of blending
		   into the page. */
		background: none;
		/* The global img reset (max-width: 100%, see global.css) caps
		   every image at its container's width by default — exactly
		   what every other pin here wants, but it silently overrides
		   the bleed below no matter how `width` itself is set (even
		   with !important), since max-width is a separate constraint
		   the cascade applies after width resolves. This is the one
		   pin deliberately meant to exceed its container. */
		max-width: none;
		/* The black board itself (not the transparent canvas around it)
		   fills 2117.11 of this file's 2400px width — 88.2% — measured
		   straight from the SVG's own board rect. Scaling the whole
		   image up by 1/0.882 makes the board land at container width,
		   so the post-it notes pinned in the margin around it (which
		   this export centers almost exactly — left/right margins are
		   within 0.04% of each other) bleed past the container edge
		   instead of being squeezed inside it. min() caps that scale-up
		   against the actual viewport (minus a fixed 16px gutter each
		   side) rather than the container, so on a narrower window —
		   where there isn't 1200px of page to bleed into — it eases
		   back down smoothly toward the container's own width instead
		   of overflowing it. */
		--bleed-width: min(113.37%, calc(100vw - 32px));
		width: var(--bleed-width);
		margin-inline: calc((100% - var(--bleed-width)) / 2);
	}

	/* The pin itself never rotates — only the photo beneath it does,
	   the way a real pushpin holds a photo steady while the photo
	   itself hangs slightly askew. Colored off the live accent token
	   (see the color panel) rather than a fixed hue, so it always
	   matches whichever candidate is active. --pin-top defaults to
	   sitting half on/half above the photo's own top edge, but a pin
	   can override it (see pinTop on the Pin type) for an image with
	   its own transparent margin, so the pin lands on the actual
	   content inside rather than the file's outer bounds. */
	.act__pinboard-pin {
		position: absolute;
		top: var(--pin-top, -6px);
		left: 50%;
		transform: translateX(-50%);
		width: 18px;
		height: 18px;
		border-radius: 50%;
		z-index: 2;
		background: radial-gradient(
			circle at 35% 30%,
			oklch(from var(--color-accent) calc(l + 0.2) c h),
			var(--color-accent) 55%,
			oklch(from var(--color-accent) calc(l - 0.15) c h) 100%
		);
		box-shadow: 0 3px 4px oklch(from var(--color-ink) l c h / 0.35);
	}

	@media (max-width: 768px) {
		.act__pinboard-row {
			/* A single-column scroll of content, not a shared-height row,
			   at phone width — two photos side by side would be too small
			   to read. The row's own `gap` (unchanged from desktop) now
			   spaces the stacked items vertically instead of horizontally,
			   which is what keeps this rhythm matching the row-to-row
			   margin below rather than needing a separate value. */
			flex-direction: column;
		}

		.act__pinboard-item {
			/* flex:none switches sizing to fit-content in the cross axis
			   (since the row uses align-items:flex-start, not the stretch
			   default) — a plain <img> masks this because its own huge
			   intrinsic pixel size always exceeds the viewport anyway, but
			   GlyphViewer (a component with no intrinsic size of its own)
			   was shrinking to whatever its content's natural width came
			   out to instead of filling the stacked column. Pin it
			   explicitly rather than relying on that coincidence. */
			flex: none;
			width: 100%;
		}

		.act__pinboard-img {
			/* No skew on mobile — the pin stays, the tilt goes. */
			transform: none;
		}

		.act__pinboard-row--full .act__pinboard-img {
			/* No bleed at phone width either — there's no page margin to
			   bleed into in the first place, so this just matches every
			   other pin's plain full-width treatment. */
			width: 100%;
			margin-inline: 0;
		}
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Reduced motion: skip creating the ScrollTrigger entirely. The
	// title is already position: absolute at the section's top, so
	// without JS pinning it just scrolls normally with the page —
	// same static fallback used everywhere else.
	if (!reduceMotionQuery.matches) {
		gsap.registerPlugin(ScrollTrigger);

		function navHeight() {
			const nav = document.querySelector('.site-nav');
			// Deliberately 1px short of the nav's real (fractional) height,
			// not rounded up to it: the nav's z-index (10) is higher than
			// the title's (5), so overlap is completely hidden behind the
			// nav, while any gap — even sub-pixel, which varies by zoom
			// and device pixel ratio — can reveal a sliver of scrolling
			// content underneath.
			return nav ? Math.floor(nav.getBoundingClientRect().height) - 1 : 0;
		}

		const title = document.querySelector<HTMLElement>('.rebrand__pinned-title');

		function titleHeight() {
			return title ? Math.ceil(title.getBoundingClientRect().height) : 0;
		}

		ScrollTrigger.create({
			trigger: '.rebrand__pinned-title',
			start: () => `top top+=${navHeight()}`,
			endTrigger: '.rebrand',
			// 'bottom bottom' would release the pin a full viewport-height
			// before the section's actual end — correct for a pinned
			// element that fills the viewport, but this title bar is only
			// ~150px tall, so that read as unpinning mid-way through the
			// last act. Releasing at the section's bottom minus the
			// title's own height means it stays pinned right up until the
			// title would otherwise start covering the next section.
			end: () => `bottom top+=${titleHeight()}`,
			pin: true,
			pinSpacing: false,
			// The border only appears while the title is actually pinned —
			// on(Enter|Leave)(Back)? covers both scroll directions, so it
			// fades in exactly when pinning starts and fades out exactly
			// when it releases, whichever way the user is scrolling.
			onEnter: () => title?.classList.add('is-stuck'),
			onLeave: () => title?.classList.remove('is-stuck'),
			onEnterBack: () => title?.classList.add('is-stuck'),
			onLeaveBack: () => title?.classList.remove('is-stuck'),
		});

		window.addEventListener('load', () => ScrollTrigger.refresh());
		window.addEventListener('resize', () => ScrollTrigger.refresh());
	}

	// The guidelines-scroll pin: an ambient, always-looping video (no
	// play button — it's a passive showcase, not a featured project
	// clip), lazy-loaded on first approach and paused once it scrolls
	// out of view so it doesn't keep decoding indefinitely. Reduced
	// motion: never loads or plays — the poster frame is the whole
	// story there, same as every other motion piece on this page.
	if (!reduceMotionQuery.matches) {
		const pinVideo = document.querySelector<HTMLVideoElement>('.act__pinboard-video');
		if (pinVideo) {
			function ensureLoaded(video: HTMLVideoElement) {
				if (video.dataset.loaded) return;
				const webm = video.dataset.webm;
				const mp4 = video.dataset.mp4;
				if (webm) {
					const source = document.createElement('source');
					source.src = webm;
					source.type = 'video/webm';
					video.appendChild(source);
				}
				if (mp4) {
					const source = document.createElement('source');
					source.src = mp4;
					source.type = 'video/mp4';
					video.appendChild(source);
				}
				video.load();
				video.dataset.loaded = 'true';
			}

			const videoObserver = new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting) {
						ensureLoaded(pinVideo);
						pinVideo.play().catch(() => {});
					} else {
						pinVideo.pause();
					}
				},
				{ threshold: 0.2 },
			);
			videoObserver.observe(pinVideo);
		}
	}
</script>
</section>
