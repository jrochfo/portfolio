---
// Temporary: auditions a faint texture on one surface — the
// testimonial band and/or the green close band. Paper grain, riso
// grain (coarser, clumpier), or a halftone dot screen, at a chosen
// strength and scale. The texture sits on a layer behind the section's
// content (so text and cards stay clean) and is generated in code, not
// an image file.
//
// Shows in dev, or with ?texture in the URL (remembered; ?texture=off
// forgets it).
const dev = import.meta.env.DEV;
---

<div class="texture-audition" data-dev={dev ? 'true' : undefined} hidden>
	<p class="texture-audition__head">Texture</p>
	<div class="texture-audition__row" role="radiogroup" aria-label="Texture">
		<button type="button" data-kind="none">None</button>
		<button type="button" data-kind="paper">Paper</button>
		<button type="button" data-kind="riso">Riso</button>
		<button type="button" data-kind="halftone">Halftone</button>
	</div>
	<label class="texture-audition__slider">
		Strength <output data-out="strength"></output>
		<input type="range" min="0.02" max="0.5" step="0.01" data-in="strength" />
	</label>
	<label class="texture-audition__slider">
		Scale <output data-out="scale"></output>
		<input type="range" min="0.5" max="2.5" step="0.05" data-in="scale" />
	</label>
	<div class="texture-audition__row">
		<label><input type="checkbox" data-target="testimonials" /> Testimonials band</label>
		<label><input type="checkbox" data-target="close" /> Green band</label>
		<label><input type="checkbox" data-target="whatido" /> What I Do</label>
	</div>
	<button type="button" class="texture-audition__mode" data-mode>Switch to dark</button>
</div>

<style>
	/* Fixed colors, not site tokens, so the panel reads the same in
	   either mode. */
	.texture-audition {
		position: fixed;
		left: 16px;
		bottom: 16px;
		z-index: 9999;
		width: 250px;
		padding: 12px;
		border-radius: 12px;
		background: #fff;
		color: #1a1a1a;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
		font: 500 12px/1.3 system-ui, sans-serif;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.texture-audition[hidden] {
		display: none;
	}

	.texture-audition__head {
		margin: 0;
		font-weight: 600;
	}

	.texture-audition__row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.texture-audition button {
		padding: 4px 8px;
		border: 1px solid #ddd;
		border-radius: 6px;
		background: #fff;
		color: inherit;
		font: inherit;
		cursor: pointer;
	}

	.texture-audition button[aria-pressed='true'] {
		background: #1a1a1a;
		border-color: #1a1a1a;
		color: #fff;
	}

	.texture-audition__slider {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 4px;
	}

	.texture-audition__slider input {
		grid-column: 1 / -1;
	}

	.texture-audition output {
		color: #777;
		font-variant-numeric: tabular-nums;
	}
</style>

<script>
	type Kind = 'none' | 'paper' | 'riso' | 'halftone';
	type State = { kind: Kind; strength: number; scale: number; targets: string[] };

	const panel = document.querySelector<HTMLElement>('.texture-audition');
	const FLAG = 'texture-audition';
	const STORE = 'texture-audition-state';
	const SELECTORS: Record<string, string> = { testimonials: '.testimonials', close: '.close', whatido: '.what-i-do' };
	// What I Do's layer runs past the section into the gaps around it —
	// from the hero's logo row down to the Rebrand section — and fades
	// out at both ends rather than stopping at a hard edge.
	const FADE = 'linear-gradient(to bottom, transparent, black 30%, black 70%, transparent)';

	// Grain: a tile of SVG fractal noise, turned into an alpha stencil
	// (bright speckles opaque, the rest clear) and used as a mask over
	// the section's own text colour — so it's dark grain on the light
	// page and light grain in dark mode. slope/intercept set how sparse
	// and hard-edged the speckles are; riso is coarser and clumpier.
	const noise = (freq: number, octaves: number, slope: number, intercept: number) =>
		`url("data:image/svg+xml,${encodeURIComponent(
			`<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='${freq}' numOctaves='${octaves}' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncR type='linear' slope='${slope}' intercept='${intercept}'/><feFuncG type='linear' slope='${slope}' intercept='${intercept}'/><feFuncB type='linear' slope='${slope}' intercept='${intercept}'/></feComponentTransfer><feColorMatrix type='luminanceToAlpha'/></filter><rect width='100%' height='100%' filter='url(#n)'/></svg>`,
		)}")`;
	const grain = (url: string, size: number) =>
		`background-color: currentColor; -webkit-mask-image: ${url}; mask-image: ${url}; -webkit-mask-size: ${size}px ${size}px; mask-size: ${size}px ${size}px;`;
	// The same, with the edge fade layered in as a second mask (both have
	// to be opaque for the texture to show).
	const grainFaded = (url: string, size: number) =>
		`background-color: currentColor; -webkit-mask-image: ${url}, ${FADE}; mask-image: ${url}, ${FADE}; -webkit-mask-size: ${size}px ${size}px, 100% 100%; mask-size: ${size}px ${size}px, 100% 100%; -webkit-mask-composite: source-in; mask-composite: intersect;`;

	function paintFor(s: State, faded: boolean) {
		const size = Math.round(240 * s.scale);
		if (s.kind === 'paper') return (faded ? grainFaded : grain)(noise(0.9, 3, 2.4, -0.75), size);
		if (s.kind === 'riso') return (faded ? grainFaded : grain)(noise(0.45, 2, 4, -1.6), size);
		// Halftone: a dot screen in the section's own text colour.
		const gap = (5 * s.scale).toFixed(1);
		const dots = `background-image: radial-gradient(circle, currentColor 0.9px, transparent 1.3px); background-size: ${gap}px ${gap}px;`;
		return faded ? `${dots} -webkit-mask-image: ${FADE}; mask-image: ${FADE};` : dots;
	}

	function css(s: State) {
		if (s.kind === 'none' || !s.targets.length) return '';
		return s.targets
			.filter((t) => SELECTORS[t])
			.map((t) => {
				const x = SELECTORS[t];
				const reach = t === 'whatido' ? 'inset: calc(-1 * var(--space-3xl)) 0;' : 'inset: 0;';
				return `${x} { position: relative; isolation: isolate; }
${x}::before { content: ''; position: absolute; ${reach} z-index: -1; pointer-events: none; opacity: ${s.strength}; ${paintFor(s, t === 'whatido')} }`;
			})
			.join('\n');
	}

	if (panel) {
		const params = new URLSearchParams(location.search);
		try {
			if (params.get('texture') === 'off') localStorage.removeItem(FLAG);
			else if (params.has('texture')) localStorage.setItem(FLAG, '1');
		} catch {}
		let flagged = false;
		try {
			flagged = localStorage.getItem(FLAG) === '1';
		} catch {}

		if (panel.dataset.dev || flagged) {
			panel.hidden = false;
			const style = document.createElement('style');
			document.head.appendChild(style);
			let state: State = { kind: 'paper', strength: 0.12, scale: 1, targets: ['testimonials'] };
			try {
				const saved = localStorage.getItem(STORE);
				if (saved) state = { ...state, ...JSON.parse(saved) };
			} catch {}

			const kinds = [...panel.querySelectorAll<HTMLButtonElement>('[data-kind]')];
			const strength = panel.querySelector<HTMLInputElement>('[data-in="strength"]')!;
			const scale = panel.querySelector<HTMLInputElement>('[data-in="scale"]')!;
			const targets = [...panel.querySelectorAll<HTMLInputElement>('[data-target]')];
			const out = (k: string) => panel.querySelector<HTMLOutputElement>(`[data-out="${k}"]`)!;
			const modeButton = panel.querySelector<HTMLButtonElement>('[data-mode]')!;

			function apply() {
				style.textContent = css(state);
				kinds.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === state.kind)));
				strength.value = String(state.strength);
				scale.value = String(state.scale);
				out('strength').textContent = state.strength.toFixed(2);
				out('scale').textContent = `${state.scale.toFixed(2)}×`;
				targets.forEach((c) => (c.checked = state.targets.includes(c.dataset.target!)));
				try {
					localStorage.setItem(STORE, JSON.stringify(state));
				} catch {}
			}

			kinds.forEach((b) =>
				b.addEventListener('click', () => {
					state.kind = b.dataset.kind as Kind;
					apply();
				}),
			);
			strength.addEventListener('input', () => {
				state.strength = Number(strength.value);
				apply();
			});
			scale.addEventListener('input', () => {
				state.scale = Number(scale.value);
				apply();
			});
			targets.forEach((c) =>
				c.addEventListener('change', () => {
					state.targets = targets.filter((x) => x.checked).map((x) => x.dataset.target!);
					apply();
				}),
			);

			const html = document.documentElement;
			const syncMode = () => (modeButton.textContent = html.dataset.theme === 'dark' ? 'Switch to light' : 'Switch to dark');
			modeButton.addEventListener('click', () =>
				window.dispatchEvent(new CustomEvent('theme-set', { detail: { mode: html.dataset.theme === 'dark' ? 'light' : 'dark' } })),
			);
			window.addEventListener('theme-change', syncMode);
			syncMode();
			apply();
		}
	}
</script>
