---
import iconJr from '../assets/icons/nav/jr-full.svg';
import iconDarkMode from '../assets/icons/functions/dark-mode.svg';

interface Props {
	label?: string;
	href?: string;
}

const { label = 'About', href = '/about' } = Astro.props;

// On the home page itself, "/" is a self-link — a real navigation just
// reloads the page. A smooth scroll-to-top feels like the same action
// but without the flash/reset; everywhere else it's a normal link home.
const isHome = Astro.url.pathname === '/';
---

<nav class="site-nav">
	<div class="site-nav__inner container" data-reveal>
		{isHome ? (
			<button type="button" class="site-nav__brand" id="nav-scroll-top" aria-label="Back to top">
				<span class="site-nav__icon" style={`--icon-src: url(${iconJr.src})`} aria-hidden="true" />
				<span class="type-h3">Jake Rochford</span>
			</button>
		) : (
			<a href="/" class="site-nav__brand">
				<span class="site-nav__icon" style={`--icon-src: url(${iconJr.src})`} aria-hidden="true" />
				<span class="type-h3">Jake Rochford</span>
			</a>
		)}
		<div class="site-nav__actions">
			<button
				type="button"
				class="button button--secondary type-caption site-nav__theme"
				id="theme-toggle"
				aria-label="Dark mode"
				aria-pressed="false"
			>
				<span class="site-nav__theme-icon" style={`--icon-src: url(${iconDarkMode.src})`} aria-hidden="true" />
			</button>
			<a href={href} class="button type-caption">{label}</a>
		</div>
	</div>
</nav>

<style is:global>
	/* Switching modes crossfades the whole page as one picture (a view
	   transition, started by the toggle's script) instead of fading each
	   element's colors — those per-element fades fell out of step with
	   each other, since children inheriting a color chase their parent's
	   fade and lag behind it, and the text flickered. Browsers without
	   view transitions, and reduced motion, just switch instantly. */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.3s;
		animation-timing-function: ease;
	}
</style>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 10;
		width: 100%;
		background: var(--color-bg);
		border-bottom: 1px solid transparent;
		transition: border-color 0.25s ease;
	}

	.site-nav--scrolled {
		border-bottom-color: var(--color-line);
	}

	.site-nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: var(--space-xs);
	}

	.site-nav__brand {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		text-align: start;
	}

	/* Overrides the global a:not(.button):hover underline rule — this
	   is a plain <a> (not .button) in the non-home case, so it'd
	   otherwise pick up the site-wide link underline on hover. */
	.site-nav__brand:hover,
	.site-nav__brand:focus-visible {
		text-decoration: none;
	}

	.site-nav__actions {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
	}

	/* A circle exactly as tall as the About button: the same caption
	   line box plus the same vertical padding, used for both sides. */
	.site-nav__theme {
		--size: calc(var(--type-caption-size) * var(--type-caption-line-height) + 2 * var(--button-pad-y));
		width: var(--size);
		height: var(--size);
		padding: 0;
	}

	/* Always the secondary fill; "on" shows only in the icon, which
	   picks up the accent while dark mode is active. */
	.site-nav__theme[aria-pressed='true'] {
		color: var(--color-accent);
	}

	.site-nav__theme-icon {
		display: block;
		width: 18px;
		height: 18px;
		background-color: currentColor;
		-webkit-mask: var(--icon-src) center / contain no-repeat;
		mask: var(--icon-src) center / contain no-repeat;
	}

	/* The JR mark, filled with whatever accent is active — a CSS mask
	   over a solid fill, so it repaints with the token automatically.
	   The full mark is wide (559 × 259), so its width follows from the
	   24px height. (The favicon is its own file in public/.) */
	.site-nav__icon {
		display: block;
		flex-shrink: 0;
		height: 24px;
		aspect-ratio: 559 / 259;
		background-color: var(--color-accent);
		-webkit-mask: var(--icon-src) center / contain no-repeat;
		mask: var(--icon-src) center / contain no-repeat;
	}

	/* The name alone on the narrowest phones, so the bar doesn't crowd. */
	@media (max-width: 429px) {
		.site-nav__icon {
			display: none;
		}
	}
</style>

<script>
	// Nav's hairline border only shows once the page has actually
	// scrolled — at the top it'd just be a stray line sitting under the
	// hero/headline with nothing yet to separate it from. The 10px
	// threshold (rather than > 0) keeps it from flickering on at the
	// slightest scroll.
	const nav = document.querySelector('.site-nav');
	function updateScrolledState() {
		nav?.classList.toggle('site-nav--scrolled', window.scrollY > 10);
	}
	updateScrolledState();
	window.addEventListener('scroll', updateScrolledState, { passive: true });

	// Light/dark mode. The choice is stored per visitor; with none stored,
	// it follows the system setting. Mode lives on <html data-theme> and
	// is announced with a 'theme-change' event so whatever supplies the
	// actual colors can react — for now, the dev palette panel, which
	// also asks for changes through 'theme-set'.
	const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	const THEME_STORE = 'theme';
	const html = document.documentElement;
	function setTheme(mode: 'light' | 'dark', animate: boolean) {
		if (animate && document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			document.startViewTransition(() => applyTheme(mode));
		} else {
			applyTheme(mode);
		}
	}

	function applyTheme(mode: 'light' | 'dark') {
		html.dataset.theme = mode;
		themeToggle?.setAttribute('aria-pressed', String(mode === 'dark'));
		try {
			localStorage.setItem(THEME_STORE, mode);
		} catch {}
		window.dispatchEvent(new CustomEvent('theme-change', { detail: { mode } }));
	}

	let storedTheme: string | null = null;
	try {
		storedTheme = localStorage.getItem(THEME_STORE);
	} catch {}
	setTheme(
		storedTheme === 'dark' || storedTheme === 'light'
			? storedTheme
			: window.matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light',
		false,
	);
	themeToggle?.addEventListener('click', () => setTheme(html.dataset.theme === 'dark' ? 'light' : 'dark', true));
	window.addEventListener('theme-set', (e) => {
		const mode = (e as CustomEvent<{ mode: 'light' | 'dark' }>).detail?.mode;
		if (mode) setTheme(mode, true);
	});

	document.querySelector<HTMLButtonElement>('#nav-scroll-top')?.addEventListener('click', () => {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
	});
</script>
