---
// A fast flip through twenty Google Slides pages from the template and
// the decks built on it. Hovering (or tapping, on touch) pauses on the
// current slide and shows which deck it came from, plus previous/next
// buttons in the corner; arrow keys step through too. Under reduced motion it never autoplays — it
// rests on the first slide and steps only when asked.
import { getImage } from 'astro:assets';
import iconBack from '../assets/icons/functions/arrow-back.svg';
import iconForward from '../assets/icons/functions/arrow-forward.svg';

const slideModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/work/so-rebrand/systems/systems-7/*.svg',
	{ eager: true },
);

// One entry per file, in file order (systems-7-01 … -20).
const DECKS = [
	'Stack Overflow Business Template',
	'Stack Internal Go-To-Market Deck',
	'Stack Overflow Business Template',
	'2025 Developer Survey Insights',
	'Stack Overflow Business Template',
	'Stack Internal Go-To-Market Deck',
	'Stack Overflow Business Template',
	'Stack Internal Go-To-Market Deck',
	'Stack Overflow Business Template',
	'2025 Developer Survey Insights',
	'Stack Ads Pitch 2026',
	'Stack Overflow Business Template',
	'Data Licensing Executive Deck',
	'KPA Final Report',
	'Diagram Playground',
	'Diagram Playground',
	'Stack Overflow Business Template',
	'Stack Overflow Business Template',
	'Data Licensing Executive Deck',
	'KPA Final Report',
];

// Width is ~2x the row's real display width (~1150px) — these carry
// small slide text, which went visibly soft on retina at thinner margins.
const slides = await Promise.all(
	Object.keys(slideModules)
		.sort()
		.map((key) => getImage({ src: slideModules[key].default, format: 'webp', width: 2400, quality: 85 })),
);

const INTERVAL_MS = 400;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
	class="deck-scrub"
	tabindex="0"
	role="group"
	aria-roledescription="slideshow"
	aria-label={`${slides.length} slides from the Stack Overflow deck template and decks built on it. Hover or press space to pause; arrow keys step through.`}
	data-interval={INTERVAL_MS}
>
	{slides.map((slide, i) => (
		<img
			class="deck-scrub__slide"
			src={i === 0 ? slide.src : undefined}
			data-src={slide.src}
			alt={`Slide from the ${DECKS[i]}`}
			width="2400"
			height="1350"
			decoding="async"
			loading={i === 0 ? 'lazy' : undefined}
			data-deck={DECKS[i]}
			hidden={i !== 0}
		/>
	))}
	<p class="deck-scrub__label" aria-live="polite">
		<span data-count>{pad(1)} / {pad(slides.length)}</span>
		<span class="deck-scrub__label-sep" aria-hidden="true">·</span>
		<span data-deck-name>{DECKS[0]}</span>
	</p>
	<div class="deck-scrub__nav">
		<button type="button" class="deck-scrub__step" data-step="-1" aria-label="Previous slide">
			<span class="deck-scrub__icon" style={`--icon-src: url(${iconBack.src})`} aria-hidden="true" />
		</button>
		<button type="button" class="deck-scrub__step" data-step="1" aria-label="Next slide">
			<span class="deck-scrub__icon" style={`--icon-src: url(${iconForward.src})`} aria-hidden="true" />
		</button>
	</div>
</div>

<style>
	.deck-scrub {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-well);
		overflow: hidden;
		background: var(--color-neutral);
		cursor: default;
	}

	.deck-scrub:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.deck-scrub__slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	/* The display:block above would otherwise beat the browser's own
	   [hidden] rule and stack all twenty slides visibly. */
	.deck-scrub__slide[hidden] {
		display: none;
	}

	/* The label and the step buttons share one height — a caption line
	   plus the label's own vertical padding — so the buttons are circles
	   exactly as tall as the label pill beside them. */
	.deck-scrub {
		--control-pad-y: var(--space-2xs);
		--control-size: calc(var(--type-caption-size) * var(--type-caption-line-height) + 2 * var(--control-pad-y));
		--control-gap: var(--space-2xs);
		--control-inset: var(--space-xs);
	}

	.deck-scrub__label {
		position: absolute;
		left: var(--control-inset);
		bottom: var(--control-inset);
		margin: 0;
		display: flex;
		gap: var(--space-2xs);
		/* Leaves room for the two buttons on the right. */
		max-width: calc(100% - 2 * var(--control-inset) - 2 * var(--control-size) - 2 * var(--control-gap));
		padding: var(--control-pad-y) var(--space-xs);
		border-radius: var(--radius-pill);
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: var(--type-caption-size);
		line-height: var(--type-caption-line-height);
		letter-spacing: var(--type-caption-letter-spacing);
		font-weight: var(--type-caption-weight);
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	[data-count] {
		font-variant-numeric: tabular-nums;
	}

	[data-deck-name] {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.deck-scrub__nav {
		position: absolute;
		right: var(--control-inset);
		bottom: var(--control-inset);
		display: flex;
		gap: var(--control-gap);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	/* Same dark fill as the label, so the corner reads as one set. */
	.deck-scrub__step {
		display: grid;
		place-items: center;
		width: var(--control-size);
		height: var(--control-size);
		padding: 0;
		border-radius: 50%;
		background: var(--color-ink);
		color: var(--color-bg);
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.deck-scrub__step:hover,
	.deck-scrub__step:focus-visible {
		background: color-mix(in oklch, var(--color-ink), var(--color-bg) 22%);
	}

	.deck-scrub__step:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.deck-scrub__icon {
		display: block;
		width: 16px;
		height: 16px;
		background-color: currentColor;
		-webkit-mask: var(--icon-src) center / contain no-repeat;
		mask: var(--icon-src) center / contain no-repeat;
	}

	.deck-scrub.is-paused .deck-scrub__label,
	.deck-scrub.is-paused .deck-scrub__nav,
	.deck-scrub:has(.deck-scrub__step:focus-visible) .deck-scrub__nav {
		opacity: 1;
		pointer-events: auto;
	}

	@media (max-width: 768px) {
		.deck-scrub {
			--control-pad-y: 4px;
			--control-size: calc(11px * var(--type-caption-line-height) + 2 * var(--control-pad-y));
			--control-gap: 6px;
			--control-inset: var(--space-2xs);
		}

		.deck-scrub__label {
			padding: var(--control-pad-y) var(--space-2xs);
			font-size: 11px;
			gap: 6px;
		}

		.deck-scrub__icon {
			width: 13px;
			height: 13px;
		}
	}

	/* No autoplay here, so the label and buttons just stay up — the
	   buttons are how you move through it. */
	@media (prefers-reduced-motion: reduce) {
		.deck-scrub__label,
		.deck-scrub__nav {
			opacity: 1;
			pointer-events: auto;
			transition: none;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const pad = (n: number) => String(n).padStart(2, '0');

	for (const root of document.querySelectorAll<HTMLElement>('.deck-scrub')) {
		const slides = [...root.querySelectorAll<HTMLImageElement>('.deck-scrub__slide')];
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const deckName = root.querySelector<HTMLElement>('[data-deck-name]')!;
		const interval = Number(root.dataset.interval) || 400;

		let index = 0;
		let ready = false;
		let inView = false;
		let hovering = false;
		let userPaused = false;
		let timer: number | undefined;

		function show(next: number) {
			slides[index].hidden = true;
			index = (next + slides.length) % slides.length;
			slides[index].hidden = false;
			count.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
			deckName.textContent = slides[index].dataset.deck ?? '';
		}

		function sync() {
			const running = ready && inView && !hovering && !userPaused && !reduceMotion;
			if (running && timer === undefined) {
				timer = window.setInterval(() => show(index + 1), interval);
			} else if (!running && timer !== undefined) {
				window.clearInterval(timer);
				timer = undefined;
			}
			root.classList.toggle('is-paused', ready && (hovering || userPaused));
		}

		// Every slide is fetched and decoded before the first flip, so the
		// scrub never lands on a frame that's still loading.
		const loadObserver = new IntersectionObserver(
			async ([entry]) => {
				if (!entry.isIntersecting) return;
				loadObserver.disconnect();
				for (const img of slides) if (!img.getAttribute('src')) img.src = img.dataset.src!;
				await Promise.all(slides.map((img) => img.decode().catch(() => {})));
				ready = true;
				sync();
			},
			{ rootMargin: '600px 0px' },
		);
		loadObserver.observe(root);

		new IntersectionObserver(
			([entry]) => {
				inView = entry.isIntersecting;
				sync();
			},
			{ threshold: 0.3 },
		).observe(root);

		root.addEventListener('pointerenter', (e) => {
			if (e.pointerType !== 'mouse') return;
			hovering = true;
			sync();
		});
		root.addEventListener('pointerleave', (e) => {
			if (e.pointerType !== 'mouse') return;
			hovering = false;
			sync();
		});

		root.addEventListener('click', (e) => {
			const pointer = (e as PointerEvent).pointerType;
			if (reduceMotion) {
				if (ready) show(index + 1);
				return;
			}
			if (pointer && pointer !== 'mouse') {
				userPaused = !userPaused;
				sync();
			}
		});

		// Previous/next. A mouse is already paused by hovering, so leaving
		// still resumes the flip; a tap pauses it until tapped again.
		root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
			button.addEventListener('click', (e) => {
				e.stopPropagation();
				if (!ready) return;
				show(index + Number(button.dataset.step));
				if ((e as PointerEvent).pointerType !== 'mouse') userPaused = true;
				sync();
			});
		});

		root.addEventListener('keydown', (e) => {
			if (e.target !== root) return;
			if (e.key === ' ' || e.key === 'Enter') {
				e.preventDefault();
				if (reduceMotion) {
					if (ready) show(index + 1);
					return;
				}
				userPaused = !userPaused;
				sync();
			} else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
				if (!ready) return;
				e.preventDefault();
				userPaused = true;
				show(index + (e.key === 'ArrowRight' ? 1 : -1));
				sync();
			}
		});
	}
</script>
